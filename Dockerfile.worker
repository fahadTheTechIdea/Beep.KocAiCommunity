# KocAiCommunity Worker — build from the repository root:  docker build -f Dockerfile.worker -t koc-worker .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Beep.KocAiCommunity.Worker/Beep.KocAiCommunity.Worker.csproj
RUN dotnet publish src/Beep.KocAiCommunity.Worker/Beep.KocAiCommunity.Worker.csproj -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "Beep.KocAiCommunity.Worker.dll"]
