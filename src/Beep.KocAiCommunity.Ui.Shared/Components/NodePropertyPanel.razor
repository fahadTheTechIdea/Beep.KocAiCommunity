@using System.Globalization
@using Beep.KocAiCommunity.Contracts.ML
@using Beep.KocAiCommunity.Contracts.Datasets

@* The one property panel for every node. It binds to the node's parameter descriptor (one NodeParameter
   contract) and renders each parameter by its declared Type, getting/setting the node's Config through the
   same path — so every node, from 'train' to 'normalize', is edited the same way. Each node still supplies
   its own distinct parameter set. *@

@* Every node palette has a reference article. Linking by category costs one line and no per-node
   wiring, and puts the explanation where someone is actually confused — in front of the setting they
   don't recognise, rather than only on the Help page. *@
@if (Descriptor is not null)
{
    <MudLink Href="@($"/help/nodes-{Descriptor.Category.ToLowerInvariant()}")" Target="_blank"
             Typo="Typo.caption" Class="d-block mb-3">
        What does this node do? →
    </MudLink>
}

@if (Descriptor is null || Descriptor.Parameters.Count == 0)
{
    <MudText Typo="Typo.body2">No options — this step acts on the columns flowing into it.</MudText>
}
else
{
    @* Friendly visual builders for the SQL nodes — they generate into the raw text field shown below,
       which stays editable as an advanced fallback. Column-aware, so they need known columns. *@
    @if (AvailableColumns.Count > 0 && Descriptor.Kind == "group-by")
    {
        <AggregateBuilder AvailableColumns="AvailableColumns" OnGenerated="@(sql => Set("aggregations", sql))" />
    }
    else if (AvailableColumns.Count > 0 && Descriptor.Kind == "sort")
    {
        <SortKeyBuilder AvailableColumns="AvailableColumns" OnGenerated="@(sql => Set("orderBy", sql))" />
    }
    else if (AvailableColumns.Count > 0 && Descriptor.Kind == "sql-filter")
    {
        <SqlConditionBuilder AvailableColumns="AvailableColumns" OnGenerated="@(sql => Set("where", sql))" />
    }

    @foreach (var p in Descriptor.Parameters.Where(Visible))
    {
        <div @key="p.Name">
            @switch (p.Type)
            {
                case "Dataset":
                    <MudSelect T="string" Label="@p.DisplayName" Value="@Get(p.Name)" ValueChanged="@(v => Set(p.Name, v))" ReadOnly="@Locked(p)"
                               ToStringFunc="@(id => Datasets.FirstOrDefault(d => d.Id.ToString() == id)?.Name ?? id)"
                               HelperText="@p.Help" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                        @foreach (var d in Datasets)
                        {
                            <MudSelectItem Value="@d.Id.ToString()">@d.Name · @d.Classification</MudSelectItem>
                        }
                    </MudSelect>
                    @if (Datasets.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.7;">No datasets with a file are visible to you — add one under <b>Datasets</b> to join or append it.</MudText>
                    }
                    break;

                case "Select":
                    <MudSelect T="string" Label="@p.DisplayName" Value="@CurrentOf(p.Name)" ValueChanged="@(v => Set(p.Name, v))" ReadOnly="@Locked(p)"
                               ToStringFunc="@(val => (p.Options ?? []).FirstOrDefault(o => o.Value == val)?.Label ?? val)"
                               HelperText="@p.Help" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                        @foreach (var o in OptionsFor(p))
                        {
                            <MudSelectItem T="string" Value="@o.Value">@o.Label</MudSelectItem>
                        }
                    </MudSelect>
                    break;

                case "Boolean":
                    <MudSwitch T="bool" Value="@GetBool(p)" ValueChanged="@(v => Set(p.Name, v ? "true" : "false"))"
                               Disabled="@Locked(p)" Color="Color.Primary" Label="@p.DisplayName" Class="mb-1" />
                    @if (!string.IsNullOrEmpty(p.Help))
                    {
                        <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.7;">@p.Help</MudText>
                    }
                    break;

                case "Date":
                    <MudDatePicker Label="@p.DisplayName" Date="@GetDate(p)" ReadOnly="@Locked(p)"
                                   DateChanged="@(d => Set(p.Name, d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)))"
                                   HelperText="@p.Help" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    break;

                case "Number":
                    <MudNumericField T="double?" Label="@p.DisplayName" Value="@GetNum(p)" ValueChanged="@(v => Set(p.Name, v?.ToString(CultureInfo.InvariantCulture)))" ReadOnly="@Locked(p)"
                                     Min="@p.Min" Max="@p.Max" HelperText="@(p.Help ?? RangeHint(p))"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    break;

                case "Integer":
                    <MudNumericField T="int?" Label="@p.DisplayName" Value="@GetInt(p)" ValueChanged="@(v => Set(p.Name, v?.ToString(CultureInfo.InvariantCulture)))" ReadOnly="@Locked(p)"
                                     Min="@((int?)p.Min)" Max="@((int?)p.Max)" HelperText="@(p.Help ?? RangeHint(p))"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    break;

                case "Column" when AvailableColumns.Count > 0:
                    <MudSelect T="string" Label="@p.DisplayName" Value="@Get(p.Name)" ValueChanged="@(v => Set(p.Name, v))" ReadOnly="@Locked(p)"
                               HelperText="@p.Help" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Clearable="true">
                        @foreach (var c in AvailableColumns)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                    break;

                case "Columns" when AvailableColumns.Count > 0:
                    <MudSelect T="string" Label="@p.DisplayName" MultiSelection="true" ReadOnly="@Locked(p)"
                               SelectedValues="@SelectedColumns(p.Name)" SelectedValuesChanged="@(v => SetColumns(p.Name, v))"
                               MultiSelectionTextFunc="@(sel => string.Join(", ", sel))"
                               HelperText="@(p.Help ?? "Pick one or more columns.")" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                        @foreach (var c in AvailableColumns)
                        {
                            <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                    break;

                default:
                    <MudTextField T="string" Label="@p.DisplayName" Value="@Get(p.Name)" ValueChanged="@(v => Set(p.Name, v))" ReadOnly="@Locked(p)"
                                  HelperText="@p.Help" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                                  Placeholder="@(p.Default ?? (p.Type == "Columns" ? "col1, col2" : (p.Type == "Column" ? "column" : "")))" />
                    break;
            }
        </div>
    }
}

@code {
    /// <summary>The selected node's parameter descriptor (from the node catalog).</summary>
    [Parameter] public NodeDescriptorDto? Descriptor { get; set; }

    /// <summary>The selected node's config dictionary — read from and written to in place.</summary>
    [Parameter] public IDictionary<string, string> Config { get; set; } = new Dictionary<string, string>();

    /// <summary>Datasets available to a Dataset-typed parameter (join / append).</summary>
    [Parameter] public IReadOnlyList<DatasetDto> Datasets { get; set; } = [];

    /// <summary>The columns flowing into the node — turns Column/Columns fields into pickers instead of text.</summary>
    [Parameter] public IReadOnlyList<string> AvailableColumns { get; set; } = [];

    /// <summary>The active ML task fallback — a lookup option tagged with AppliesTo shows only for a matching
    /// task. When the node itself has a `task` field (e.g. Train), that field wins.</summary>
    [Parameter] public string Task { get; set; } = "BinaryClassification";

    /// <summary>Parameter keys to render read-only (e.g. a competition's fixed target/id/task).</summary>
    [Parameter] public IReadOnlyList<string> LockedKeys { get; set; } = [];

    /// <summary>Raised after any field changes, so the host can persist / re-render.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool Locked(NodeParameterDto p) => LockedKeys.Contains(p.Name);

    // The task used to filter algorithm options: the node's own `task` field if it has one, else the fallback.
    private string ActiveTask =>
        Config.TryGetValue("task", out var t) && !string.IsNullOrEmpty(t) ? t : Task;

    // A field with a VisibleWhen shows only when its sibling parameter currently holds a matching value
    // (resolved the same way the sibling's own editor resolves it — see CurrentOf).
    private bool Visible(NodeParameterDto p) =>
        p.VisibleWhen is not { } vw || (CurrentOf(vw.Param) is { } current && vw.Values.Contains(current));

    // The value a parameter's editor actually shows: the stored value, else the declared default. For a
    // lookup whose options are task-tagged, a value the active task retired (e.g. 'sdca' left behind after
    // switching the Train node to Anomaly detection) falls back to the first option that does apply — so the
    // dropdown is never empty, never shows a trainer the engine won't use, and the hyperparameters gated on
    // it (VisibleWhen) follow along. Display-only: the stale config value is overwritten on the next edit.
    private string? CurrentOf(string name)
    {
        var p = Descriptor?.Parameters.FirstOrDefault(x => x.Name == name);
        var raw = Config.TryGetValue(name, out var v) && !string.IsNullOrEmpty(v) ? v : p?.Default;
        if (p is null || p.Type != "Select")
        {
            return raw;
        }

        var options = OptionsFor(p).ToList();
        return options.Count == 0 || options.Any(o => o.Value == raw) ? raw : options[0].Value;
    }

    private string Get(string key) => Config.TryGetValue(key, out var v) ? v : string.Empty;

    private string Effective(NodeParameterDto p) => Get(p.Name) is { Length: > 0 } v ? v : (p.Default ?? "");

    private double? GetNum(NodeParameterDto p) =>
        double.TryParse(Effective(p), NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? d : null;

    private int? GetInt(NodeParameterDto p) =>
        int.TryParse(Effective(p), NumberStyles.Integer, CultureInfo.InvariantCulture, out var i) ? i : null;

    private bool GetBool(NodeParameterDto p) => bool.TryParse(Effective(p), out var b) && b;

    private DateTime? GetDate(NodeParameterDto p) =>
        DateTime.TryParse(Effective(p), CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt) ? dt : null;

    // A lookup's options are carried on the parameter as objects; when an option is tagged with the tasks it
    // applies to, show it only for the active task — one generic rule, no per-field logic.
    private IEnumerable<LookupOptionDto> OptionsFor(NodeParameterDto p) =>
        (p.Options ?? []).Where(o => o.AppliesTo is null || o.AppliesTo.Contains(ActiveTask));

    // Columns are stored as a comma-separated string; the multi-select works with a set.
    private IReadOnlyCollection<string> SelectedColumns(string key) =>
        Get(key).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private Task SetColumns(string key, IReadOnlyCollection<string> values) =>
        Set(key, string.Join(", ", values));

    private async Task Set(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Config.Remove(key);
        }
        else
        {
            Config[key] = value.Trim();
        }

        await OnChanged.InvokeAsync();
    }

    private static string? RangeHint(NodeParameterDto p) => (p.Min, p.Max) switch
    {
        ({ } min, { } max) => $"{min} – {max}",
        ({ } min, null) => $"≥ {min}",
        (null, { } max) => $"≤ {max}",
        _ => null,
    };
}
