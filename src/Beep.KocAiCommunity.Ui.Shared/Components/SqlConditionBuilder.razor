@* Friendly builder for the sql-filter node's `where` predicate. Each row is column + operator + value,
   AND-joined (e.g. "pressure" > 3000 AND "zone" = 'north'). Numeric values pass through raw; text values are
   single-quoted; IS NULL / IS NOT NULL take no value. Reports the predicate via OnGenerated. *@

<MudText Typo="Typo.caption" Class="d-block mb-1" Style="opacity:.75;">Keep rows where (all of)</MudText>
@foreach (var row in _rows)
{
    <div class="d-flex gap-1 mb-1 align-center" @key="row.Id">
        <MudSelect T="string" Value="row.Column" ValueChanged="@(v => { row.Column = v; return Regenerate(); })" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="flex:1;" Label="Column">
            @foreach (var c in AvailableColumns)
            {
                <MudSelectItem Value="@c">@c</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Value="row.Op" ValueChanged="@(v => { row.Op = v; return Regenerate(); })" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:120px;" Label="Operator">
            @foreach (var o in _operators)
            {
                <MudSelectItem Value="@o">@o</MudSelectItem>
            }
        </MudSelect>
        @if (row.Op is not ("IS NULL" or "IS NOT NULL"))
        {
            <MudTextField T="string" Value="row.Value" ValueChanged="@(v => { row.Value = v; return Regenerate(); })" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:130px;" Label="Value" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => Remove(row))" aria-label="Remove condition" />
    </div>
}
<MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Text" OnClick="Add" Class="mb-2">Add condition</MudButton>

@code {
    [Parameter] public IReadOnlyList<string> AvailableColumns { get; set; } = [];
    [Parameter] public EventCallback<string> OnGenerated { get; set; }

    private static readonly string[] _operators = ["=", "!=", ">", ">=", "<", "<=", "LIKE", "IS NULL", "IS NOT NULL"];
    private readonly List<Row> _rows = [];
    private int _seq;

    private sealed class Row
    {
        public int Id { get; init; }
        public string Column { get; set; } = "";
        public string Op { get; set; } = "=";
        public string Value { get; set; } = "";
    }

    protected override void OnInitialized() => _rows.Add(new Row { Id = _seq++ });

    private async Task Add()
    {
        _rows.Add(new Row { Id = _seq++ });
        await Regenerate();
    }

    private async Task Remove(Row row)
    {
        _rows.Remove(row);
        if (_rows.Count == 0)
        {
            _rows.Add(new Row { Id = _seq++ });
        }

        await Regenerate();
    }

    private async Task Regenerate()
    {
        var parts = _rows.Where(Complete).Select(Predicate);
        await OnGenerated.InvokeAsync(string.Join(" AND ", parts));
    }

    private static bool Complete(Row r) =>
        !string.IsNullOrWhiteSpace(r.Column) && (r.Op is "IS NULL" or "IS NOT NULL" || !string.IsNullOrWhiteSpace(r.Value));

    private static string Predicate(Row r)
    {
        var col = $"\"{r.Column}\"";
        if (r.Op is "IS NULL" or "IS NOT NULL")
        {
            return $"{col} {r.Op}";
        }

        // Numbers pass through; everything else is quoted as a string literal (single quotes doubled).
        var value = double.TryParse(r.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _)
            ? r.Value.Trim()
            : $"'{r.Value.Trim().Replace("'", "''")}'";
        return $"{col} {r.Op} {value}";
    }
}
