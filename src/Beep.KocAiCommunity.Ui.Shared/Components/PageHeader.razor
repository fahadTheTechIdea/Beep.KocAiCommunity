@namespace Beep.KocAiCommunity.Ui.Shared.Components

<div class="d-flex justify-space-between align-start mb-6 flex-wrap gap-3">
    <div>
        @if (!string.IsNullOrEmpty(Eyebrow))
        {
            <span class="koc-eyebrow">@Eyebrow</span>
        }
        <MudText Typo="Typo.h4" Class="koc-heading mt-2 mb-1">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body1" Style="max-width:66ch;">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex gap-2 align-center flex-wrap">@Actions</div>
    }
</div>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
