@* The launcher, not an editor. It asks for exactly the two things a competition can never change —
   its name is here only because something has to be born with one, and the task-and-metric pair is
   frozen because changing the metric after submissions exist would reorder a live leaderboard.
   EVERYTHING else — the description in both languages, audience, quota, data, prizes, category,
   reveal — lives in the Host console, the one editor. This dialog and that console used to be two
   divergent forms for the same record: English editable here and never again, Arabic editable there,
   the task collected here and discarded, then re-asked there. One field in two places is one drift
   waiting to happen, so no field the console owns appears here. *@
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@inject IKocApiClient Api
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" Class="koc-heading">@L["Host a competition"]</MudText>
                <MudText Typo="Typo.caption" Style="opacity:.7;">@L["Name it and pick what is predicted — everything else happens on its Host console."]</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_title" Immediate="true" Label="@L["Competition title"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="ESP Failure Prediction Challenge" Counter="80" MaxLength="80"
                      HelperText="@L["A clear, specific name. Include the asset or outcome."]" Class="mb-4" />

        <MudText Typo="Typo.subtitle2" Class="koc-heading mb-1">@L["What do competitors predict?"]</MudText>
        <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.75;">
            @L["This sets the scoring metric and the shape of your data files, and it is the one choice that cannot change later."]
        </MudText>
        <MudGrid Spacing="3">
            @foreach (var option in CompetitionTaskCatalog.All)
            {
                <MudItem xs="12" md="4">
                    <div @onclick="() => _task = option.Key" style="cursor:pointer;height:100%;">
                        <BlueprintCard Class="pa-4" Style="@(_task == option.Key ? "border-color:var(--koc-accent-500);height:100%;" : "height:100%;")">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@option.Icon" Color="@(_task == option.Key ? Color.Primary : Color.Default)" />
                                <MudText Typo="Typo.subtitle2" Class="koc-heading">@L[option.Label]</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Style="opacity:.75;">@L[option.Help]</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="mt-1">@L[option.Metric]</MudChip>
                        </BlueprintCard>
                    </div>
                </MudItem>
            }
        </MudGrid>

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-3">
            @L["It is created as a draft only you can see. The Host console is where you write the brief (English and Arabic together), attach the data and the hidden answer key, set the audience, prizes and domain — and activate when it is ready."]
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.RocketLaunch"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_title))" OnClick="Submit">@L["Create draft"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The widest audience the current user may target (from /me). The draft is born at this
    /// scope; the console can narrow it while it stays a draft.</summary>
    [Parameter] public string? MaxScope { get; set; }

    private string _title = "";
    private string _task = "BinaryClassification";
    private bool _busy;

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        _busy = true;
        try
        {
            var option = CompetitionTaskCatalog.Find(_task);
            var dto = await Api.CreateCompetitionAsync(new CreateCompetitionRequest(
                _title.Trim(),
                Description: string.Empty,
                Scope: MaxScope ?? "Company",
                VisibilityOrgUnitId: null,
                RevealUtc: null,
                QuotaPerDay: 5,
                ScorerCode: option.Scorer,
                TaskType: option.Key));

            Snackbar.Add(L["Draft created — only you can see it until you activate."], Severity.Success);
            Dialog.Close(DialogResult.Ok(dto?.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Create failed: {0}", ex.Message], Severity.Error);
            _busy = false;
        }
    }
}
