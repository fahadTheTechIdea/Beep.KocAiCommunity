@using Beep.KocAiCommunity.Contracts.Datasets
@using Beep.KocAiCommunity.Client
@inject IKocApiClient Api
@inject ISnackbar Snackbar
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@L["Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudTextField @bind-Value="_description" Label="@L["Description"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudSelect @bind-Value="_classification" Label="@L["Security classification"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            @foreach (var c in _classifications)
            {
                <MudSelectItem Value="@c">@c</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Who can see this?"]</MudText>
        <MudRadioGroup T="string" @bind-Value="_scope">
            @foreach (var scope in _scopeOrder)
            {
                var opt = _options.GetValueOrDefault(scope);
                var disabled = opt is { OrgUnitId: null } && scope != "Company";
                <MudRadio T="string" Value="@scope" Disabled="@disabled" Dense="true">
                    <b>@scope</b>
                    @if (opt is not null)
                    {
                        <MudText Typo="Typo.caption" Class="d-inline">&nbsp;· @opt.OrgUnitName · @opt.UserCount @(opt.UserCount == 1 ? "person" : "people")</MudText>
                    }
                </MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(_name) || _busy)">@L["Add dataset"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private readonly string[] _scopeOrder = ["Team", "Group", "Directorate", "Company"];
    private readonly string[] _classifications = ["Public", "Internal", "Confidential", "Restricted"];
    private readonly Dictionary<string, VisibilityOptionDto> _options = [];

    private string _name = "";
    private string _description = "";
    private string _classification = "Internal";
    private string _scope = "Group";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        foreach (var scope in _scopeOrder)
        {
            var option = await Api.GetAudienceAsync(scope.ToLowerInvariant());
            if (option is not null)
            {
                _options[scope] = option;
            }
        }
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        _busy = true;
        try
        {
            await Api.CreateDatasetAsync(new CreateDatasetRequest(_name, _description, _scope, _classification, "upstream", null));
            Snackbar.Add("Dataset added.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't add dataset: {ex.Message}", Severity.Error);
            _busy = false;
        }
    }
}
