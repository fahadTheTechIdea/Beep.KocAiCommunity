@using Beep.KocAiCommunity.Contracts.Community
@using Beep.KocAiCommunity.Contracts.Datasets
@using Beep.KocAiCommunity.Client
@inject IKocApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudTextField @bind-Value="_body" Label="What's on your mind?" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" Class="mb-2" />

        <MudText Typo="Typo.subtitle2" Class="mb-1">Who can see this?</MudText>
        <MudRadioGroup T="string" @bind-Value="_scope">
            @foreach (var scope in _scopeOrder)
            {
                var opt = _options.GetValueOrDefault(scope);
                var disabled = opt is { OrgUnitId: null } && scope != "Company";
                <MudRadio T="string" Value="@scope" Disabled="@disabled" Dense="true">
                    <b>@scope</b>
                    @if (opt is not null)
                    {
                        <MudText Typo="Typo.caption" Class="d-inline">&nbsp;· @opt.OrgUnitName · @opt.UserCount</MudText>
                    }
                </MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(_title) || _busy)">Post discussion</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private readonly string[] _scopeOrder = ["Team", "Group", "Directorate", "Company"];
    private readonly Dictionary<string, VisibilityOptionDto> _options = [];

    private string _title = "";
    private string _body = "";
    private string _scope = "Group";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        foreach (var scope in _scopeOrder)
        {
            var option = await Api.GetAudienceAsync(scope.ToLowerInvariant());
            if (option is not null)
            {
                _options[scope] = option;
            }
        }
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        _busy = true;
        try
        {
            await Api.CreateDiscussionAsync(new CreateDiscussionRequest(_title, _body, _scope));
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't post: {ex.Message}", Severity.Error);
            _busy = false;
        }
    }
}
