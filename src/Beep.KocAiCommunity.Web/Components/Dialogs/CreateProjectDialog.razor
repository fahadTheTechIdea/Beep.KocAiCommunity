@using Beep.KocAiCommunity.Contracts.Studio
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Web.Services
@inject IKocApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Project name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Placeholder="e.g. Pump failure model" />

        <MudText Typo="Typo.subtitle2" Class="mb-1">What is this project for?</MudText>
        <MudRadioGroup T="string" @bind-Value="_kind">
            <MudRadio T="string" Value="@("personal")" Dense="true"><b>Personal</b> — explore on your own data</MudRadio>
            <MudRadio T="string" Value="@("competition")" Dense="true"><b>A competition</b> — build a pipeline to submit to a leaderboard</MudRadio>
        </MudRadioGroup>

        @if (_kind == "competition")
        {
            @if (_competitions.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-2">No open competitions to target right now.</MudAlert>
            }
            else
            {
                <MudSelect T="Guid" @bind-Value="_competitionId" Label="Competition" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                    @foreach (var c in _competitions)
                    {
                        <MudSelectItem Value="c.Id">@c.Title</MudSelectItem>
                    }
                </MudSelect>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanCreate)">Create project</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private string _name = "";
    private string _kind = "personal";
    private Guid _competitionId;
    private IReadOnlyList<CompetitionDto> _competitions = [];
    private bool _busy;

    private bool CanCreate => !_busy && !string.IsNullOrWhiteSpace(_name)
        && (_kind == "personal" || _competitionId != Guid.Empty);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Api.GetCompetitionsAsync();
            _competitions = all.Where(c => c is { HasDatasets: true, HasAnswerKey: true, Status: "active" }).ToList();
            if (_competitions.Count > 0)
            {
                _competitionId = _competitions[0].Id;
            }
        }
        catch { /* competition list is optional */ }
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        _busy = true;
        try
        {
            Guid? competitionId = _kind == "competition" ? _competitionId : null;
            var dto = await Api.CreateProjectAsync(new CreateProjectRequest(_name, competitionId));
            Dialog.Close(DialogResult.Ok(dto?.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't create project: {ex.Message}", Severity.Error);
            _busy = false;
        }
    }
}
