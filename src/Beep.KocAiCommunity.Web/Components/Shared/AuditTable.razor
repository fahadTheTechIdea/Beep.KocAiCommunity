@using Beep.KocAiCommunity.Contracts.Admin
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Strings> L

@if (Rows.Count == 0)
{
    <MudText Typo="Typo.body2" Style="opacity:.7;">@L["No audit events yet."]</MudText>
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead><tr><th>When</th><th>@L["Actor"]</th><th>@L["Action"]</th><th>@L["Resource"]</th></tr></thead>
        <tbody>
            @foreach (var a in Rows)
            {
                <tr>
                    <td>@a.OccurredUtc.ToLocalTime().ToString("g")</td>
                    <td>@a.ActorUserId</td>
                    <td><code>@a.Action</code></td>
                    <td>@a.Resource@(a.ResourceId is null ? "" : $" · {a.ResourceId}")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter] public IReadOnlyList<AuditLogDto> Rows { get; set; } = [];
}
