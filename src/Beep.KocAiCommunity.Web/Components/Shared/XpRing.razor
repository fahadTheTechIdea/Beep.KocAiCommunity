@* Avatar wrapped in a progress ring toward the next O&G career level. *@

<div style="position:relative;width:@(Diameter)px;height:@(Diameter)px;" title="@Tooltip">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Value="@Percent" Min="0" Max="100"
                         Style="@($"width:{Diameter}px;height:{Diameter}px;position:absolute;top:0;left:0;")" StrokeWidth="4" />
    <MudAvatar Style="@AvatarStyle">
        <MudImage Src="@KocBrand.Icon(AvatarIcon)" Alt="avatar" />
    </MudAvatar>
    @if (ShowLevelBadge)
    {
        <div style="position:absolute;bottom:-2px;right:-2px;background:var(--koc-accent-700,#1466A5);color:#fff;border-radius:999px;min-width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid #fff;">
            @Level
        </div>
    }
</div>

@code {
    [Parameter] public string AvatarIcon { get; set; } = "185-worker.png";
    [Parameter] public int Level { get; set; } = 1;
    [Parameter] public string LevelTitle { get; set; } = "";
    [Parameter] public int XpTotal { get; set; }
    [Parameter] public int? NextLevelXp { get; set; }
    [Parameter] public int Diameter { get; set; } = 100;
    [Parameter] public bool ShowLevelBadge { get; set; } = true;

    private double Percent => NextLevelXp is { } next && next > 0
        ? Math.Clamp(100.0 * XpTotal / next, 0, 100)
        : 100;

    private string Tooltip => NextLevelXp is { } next
        ? $"{XpTotal} / {next} bbl · Level {Level} {LevelTitle}"
        : $"{XpTotal} bbl · Level {Level} {LevelTitle} (max)";

    private string AvatarStyle =>
        $"width:{Diameter - 20}px;height:{Diameter - 20}px;position:absolute;top:10px;left:10px;background:#fff;";
}
