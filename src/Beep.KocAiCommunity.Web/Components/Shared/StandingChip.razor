@using System.Text.Json
@using Beep.KocAiCommunity.Contracts.Engagement
@using Beep.KocAiCommunity.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IKocApiClient Api
@inject DevIdentity Identity
@inject RealtimeOptions Realtime
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_profile is not null)
{
    <MudTooltip Text="@($"Level {_profile.Level} · {_profile.LevelTitle}")">
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="mr-1" OnClick="@(() => Nav.NavigateTo("/profile"))">
            <span style="font-weight:700;">🛢️ @_profile.XpTotal</span>
            @if (_profile.CurrentStreakDays > 0)
            {
                <span class="ml-2">🔥 @_profile.CurrentStreakDays</span>
            }
        </MudButton>
    </MudTooltip>
}

@code {
    private ProfileDto? _profile;
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await ConnectAsync();
    }

    private async Task RefreshAsync()
    {
        try { _profile = await Api.GetMyProfileAsync(); }
        catch { /* API may be unreachable; chip stays hidden */ }
    }

    private async Task ConnectAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder().WithUrl(Realtime.HubUrl).WithAutomaticReconnect().Build();
            _hub.On<string>("engagement.celebrate", async json =>
            {
                await OnCelebrationAsync(json);
            });
            await _hub.StartAsync();
            await _hub.SendAsync("JoinUser", Identity.UserId);
        }
        catch
        {
            // Celebrations are best-effort; the chip still refreshes when the page reloads.
        }
    }

    private async Task OnCelebrationAsync(string json)
    {
        try
        {
            var ev = JsonSerializer.Deserialize<Celebration>(json, JsonOpts);
            if (ev is null)
            {
                return;
            }

            await JS.InvokeVoidAsync("kocCelebrate", ev.Kind);
            Snackbar.Add($"{(ev.Kind == "badge" ? "🏅" : "⭐")} {ev.Title}", Severity.Success);
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (JsonException) { /* ignore malformed payloads */ }
        catch (Exception ex) { Console.WriteLine($"celebration handling failed: {ex.Message}"); }
    }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private sealed record Celebration(string UserId, string Kind, string Title, string Message, string IconFile);

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
