@* The prototype notice, shown once per browser session to everyone who opens the platform.
   Deliberately NOT localised: it says the same thing in English and Arabic side by side, in whichever
   language the page happens to be in. A notice of this kind has to be readable by whoever is looking at
   the screen — including someone reading over a colleague's shoulder — so both languages are always
   present rather than one being chosen for the reader. *@
@using Beep.KocAiCommunity.Ui.Shared.Localization
@inject IJSRuntime JS

@if (_show)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="false" ZIndex="10050">
        <MudPaper Elevation="12" Class="pa-6 mx-auto" Style="max-width:640px;width:calc(100vw - 32px);border-radius:16px;">
            <div class="d-flex align-center gap-3 mb-4">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="koc-heading" Style="line-height:1.2;">Prototype — demonstration only</MudText>
                    <MudText Typo="Typo.h6" Class="koc-heading" Style="line-height:1.2;direction:rtl;">نموذج أولي — لأغراض العرض فقط</MudText>
                </div>
            </div>

            <MudText Typo="Typo.body2" Class="mb-3">
                This is a prototype of the @KocBrand.ProductName, built for review by the AI Digital Campus
                task force. Everything you see — competitions, datasets, leaderboards, colleagues and
                discussions — is illustrative sample content, not real @KocBrand.Company data. Nothing here
                represents actual employees, results, decisions, or official company information, and no
                content on this site should be relied upon for any operational or personnel purpose.
            </MudText>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.body2" Style="direction:rtl;text-align:right;">
                هذه نسخة أولية من منصة مجموعة التدريب والتطوير الوظيفي في شركة نفط الكويت، أُعدّت لمراجعة فريق العمل. وكل ما يظهر
                فيها — من مسابقات وبيانات ولوحات صدارة وزملاء ونقاشات — هو محتوى توضيحي وليس بيانات حقيقية
                لشركة نفط الكويت. ولا يمثّل أي منه موظفين فعليين أو نتائج أو قرارات أو معلومات رسمية للشركة،
                ولا يجوز الاعتماد على أي محتوى في هذا الموقع لأي غرض تشغيلي أو متعلق بالموارد البشرية.
            </MudText>

            <div class="d-flex justify-end mt-6">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Check" OnClick="Acknowledge">
                    I understand · أفهم ذلك
                </MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private bool _show;
    private bool _checked;

    /// <summary>
    /// Shown by default now, rather than only when demonstration accounts happen to be seeded. The whole
    /// site is the prototype — the competitions and datasets that ship with it are illustrative whether or
    /// not an administrator has added sample colleagues, so gating the notice on that left the site making
    /// no disclaimer at all on a fresh deployment.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked)
        {
            return;
        }

        _checked = true;
        try
        {
            // Acknowledged already in this browser session? Stay out of the way until the next visit.
            var acked = await JS.InvokeAsync<string?>("sessionStorage.getItem", "koc-demo-disclaimer-ack");
            if (acked == "1")
            {
                return;
            }
        }
        catch
        {
            // No session storage (or no JS yet): show the notice. Erring towards showing it is the
            // only safe direction for a disclaimer.
        }

        _show = true;
        StateHasChanged();
    }

    private async Task Acknowledge()
    {
        _show = false;
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", "koc-demo-disclaimer-ack", "1");
        }
        catch
        {
            // Non-fatal: worst case the notice reappears on the next full page load.
        }

        StateHasChanged();
    }
}
