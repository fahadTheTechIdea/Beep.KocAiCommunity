@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Strings> L
@using Beep.KocAiCommunity.Client
@inject DevIdentity Identity
@implements IDisposable

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@L["Home"]</MudNavLink>
    <MudNavLink Href="/learn" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.School">@L["Learn"]</MudNavLink>
    <MudNavLink Href="/community" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Forum">@L["Community"]</MudNavLink>

    @if (Identity.HasAnyPosition)
    {
        <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">@L["Dashboard"]</MudNavLink>
        <MudNavLink Href="/compete" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EmojiEvents">@L["Compete"]</MudNavLink>
    }

    @if (Identity.IsSupervisor)
    {
        <MudNavLink Href="/supervision" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupervisorAccount">@L["Supervision"]</MudNavLink>
    }

    @* Help, My profile, and the Admin console now live in the top-right menu (see MainLayout). *@

    @if (Identity.IsGuest)
    {
        <MudDivider Class="my-2" />
        <div class="pa-3">
            <MudText Typo="Typo.caption">@L["Sign in to learn, compete, and build models."]</MudText>
        </div>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Identity.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Identity.Changed -= OnChanged;
}
