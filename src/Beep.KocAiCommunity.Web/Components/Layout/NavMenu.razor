@using Beep.KocAiCommunity.Web.Services
@inject DevIdentity Identity
@implements IDisposable

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/learn" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.School">Learn</MudNavLink>
    <MudNavLink Href="/community" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Forum">Community</MudNavLink>
    <MudNavLink Href="/help" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HelpOutline">Help</MudNavLink>

    @if (Identity.HasAnyPosition)
    {
        <MudNavLink Href="/profile" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EmojiEvents">My profile</MudNavLink>
        <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
        <MudNavLink Href="/compete" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EmojiEvents">Compete</MudNavLink>

        <MudNavGroup Title="Studio" Icon="@Icons.Material.Filled.Build" Expanded="true">
            <MudNavLink Href="/datasets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dataset">Datasets</MudNavLink>
            <MudNavLink Href="/workflows" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Schema">Workflows</MudNavLink>
            <MudNavLink Href="/workflow" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Folder">Projects</MudNavLink>
            <MudNavLink Href="/studio" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Hub">AutoML</MudNavLink>
            <MudNavLink Href="/nodes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Widgets">Node catalog</MudNavLink>
            <MudNavLink Href="/runs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PlayCircle">Runs</MudNavLink>
            <MudNavLink Href="/experiments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Science">Experiments</MudNavLink>
            <MudNavLink Href="/models" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">Models</MudNavLink>
        </MudNavGroup>
    }

    @if (Identity.IsSupervisor)
    {
        <MudNavLink Href="/supervision" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupervisorAccount">Supervision</MudNavLink>
    }

    @if (Identity.IsPlatformAdmin)
    {
        <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Console</MudNavLink>
            <MudNavLink Href="/admin/overview" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Map">Overview</MudNavLink>
            <MudNavLink Href="/connectors" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Hub">Connectors</MudNavLink>
        </MudNavGroup>
    }

    @if (Identity.IsGuest)
    {
        <MudDivider Class="my-2" />
        <div class="pa-3">
            <MudText Typo="Typo.caption">Sign in to learn, compete, and build models.</MudText>
        </div>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Identity.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Identity.Changed -= OnChanged;
}
