@inherits LayoutComponentBase
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Microsoft.Extensions.Hosting
@using Microsoft.AspNetCore.Components.Authorization
@using Beep.KocAiCommunity.ServiceDefaults.Security
@using Beep.KocAiCommunity.Web.Security
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Beep.KocAiCommunity.Contracts.Localization
@using Microsoft.Extensions.Localization
@inject DevIdentity Identity
@inject IStringLocalizer<Strings> L
@inject IHostEnvironment Env
@inject NavigationManager Nav
@inject KocSetupStore SetupStore
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<DemoDisclaimer />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudImage Src="@KocBrand.LogoPath" Alt="Kuwait Oil Company" Height="38" Class="mr-3" />
        <a href="/" class="koc-brand d-flex flex-column" style="line-height:1.15;">
            <MudText Typo="Typo.h6" Class="koc-heading d-none d-sm-flex">@KocBrand.ProductName</MudText>
            <MudText Typo="Typo.h6" Class="koc-heading d-flex d-sm-none">@KocBrand.ShortName</MudText>
            <MudText Typo="Typo.caption" Class="d-none d-lg-flex" Style="opacity:.7;">@KocBrand.Company · @KocBrand.SubTitle</MudText>
        </a>

        @* Navigation moved off the drawer and onto the bar. *@
        <TopNav />

        <MudSpacer />

        @if (!Identity.IsGuest)
        {
            <StandingChip @key="Identity.UserId" />
            <NotificationBell />
        }

        @* Beside Help, and visible to everyone including a visitor with no account: the pages that most
           need Arabic are the ones open without signing in. Switching posts to /culture/set, because a
           circuit can neither set a cookie nor change the culture it is already running under. *@
        <LanguageSwitcher Language="@_language" OnSwitch="SwitchLanguage" />

        @* These items moved off the left drawer and sit directly on the top-right, always visible. *@
        <MudTooltip Text="@L["Help & guides"]">
            <MudIconButton Href="/help" Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" aria-label="Help" />
        </MudTooltip>

        @if (Identity.HasAnyPosition)
        {
            <MudButton Href="/profile" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.EmojiEvents" Class="ms-1">@L["My profile"]</MudButton>
        }

        @if (Identity.IsPlatformAdmin)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-1">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AdminPanelSettings" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@context.ToggleAsync">@L["Admin"]</MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.SpaceDashboard">@L["Console"]</MudMenuItem>
                    <MudMenuItem Href="/admin/overview" Icon="@Icons.Material.Filled.Map">@L["Overview"]</MudMenuItem>
                    <MudMenuItem Href="/connectors" Icon="@Icons.Material.Filled.Hub">@L["Connectors"]</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }

        @if (IsDemoMode)
        {
            @* Demo mode only: switch personas to preview the app as different roles. Never with real sign-in. *@
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-2">
                <ActivatorContent>
                    @if (Identity.IsGuest)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" OnClick="@context.ToggleAsync">@L["Sign in with KOC"]</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountCircle" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@context.ToggleAsync">
                            @Identity.Current.Label
                        </MudButton>
                    }
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.caption" Class="px-4 py-2 d-block">@L["View the app as (dev)"]</MudText>
                    <MudDivider />
                    @foreach (var p in DevIdentity.Personas)
                    {
                        <MudMenuItem OnClick="@(() => Switch(p.Key))">
                            @if (p.Key == Identity.Current.Key)
                            {
                                <b>@p.Label ✓</b>
                            }
                            else
                            {
                                @p.Label
                            }
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        else if (Identity.IsGuest)
        {
            @* Real sign-in: local accounts get a login page; intranet/Entra sign the visitor in themselves. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" Class="ml-2"
                       Href="@LoginHref">@SignInPrompt.ButtonText(SetupStore, L)</MudButton>
        }
        else
        {
            @* Signed in for real: show who, and offer sign-out where there's a session to end. *@
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-2">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountCircle"
                               EndIcon="@(HasLoginPage ? Icons.Material.Filled.ArrowDropDown : null)" OnClick="@context.ToggleAsync">
                        @Identity.Current.Label
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.EmojiEvents">@L["My profile"]</MudMenuItem>
                    @if (HasLoginPage)
                    {
                        <MudDivider />
                        <form method="post" action="/account/logout" style="margin:0;">
                            <button type="submit" class="koc-menu-form-button">@L["Sign out"]</button>
                        </form>
                    }
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @if (AllowedHere())
            {
                @Body
            }
            else
            {
                <BlueprintCard Class="pa-8 mt-6" Style="max-width:560px;margin:0 auto;text-align:center;">
                    <MudIcon Icon="@(Identity.IsGuest ? Icons.Material.Filled.Lock : Icons.Material.Filled.Block)" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    @if (Identity.IsGuest)
                    {
                        <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["Sign in to continue"]</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">@L["This area is for signed-in members."] @SignInPrompt.HowToSignIn(SetupStore, L)</MudText>
                        @if (IsDemoMode)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Switch("employee"))">@L["View as Employee"]</MudButton>
                        }
                        else if (HasLoginPage)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@LoginHref">@SignInPrompt.ButtonText(SetupStore, L)</MudButton>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["You don't have access to this area"]</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">@L["Your role ({0}) can't view this page. Supervision needs a team-lead role or above; Admin needs Platform Admin.", Identity.Current.Label]</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/">@L["Back to home"]</MudButton>
                    }
                </BlueprintCard>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = KocTheme.Build();

    /// <summary>True when nobody really signs in and the persona switcher stands in for an identity.</summary>
    private bool IsDemoMode => SetupStore.DemoPersonasEnabled;

    /// <summary>
    /// True when this site holds the credentials, so there is a login page to send people to and a
    /// session of ours to end. Inside KOC the corporate account is the session — signing out here would
    /// only be re-established by the next request.
    /// </summary>
    private string _language = KocLanguages.English;

    /// <summary>
    /// A full round trip on purpose. The cookie has to be written by a real response, and the culture
    /// has to be in force before the next circuit starts — changing CultureInfo on the running circuit
    /// would translate nothing already rendered and leave the page half in each language.
    /// </summary>
    private void SwitchLanguage(string language)
    {
        var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        Nav.NavigateTo($"{KocLocalization.SetCulturePath}?language={language}&returnUrl={returnUrl}", forceLoad: true);
    }

    private bool HasLoginPage => SetupStore.SignInWith == KocSignInSource.SiteAccounts;

    private string LoginHref => HasLoginPage ? "/account/login" : "/";

    protected override void OnInitialized()
    {
        // The circuit inherits the culture the initial request resolved to, so this is the live answer.
        _language = KocLanguages.Normalize(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);

        Identity.Changed += OnIdentityChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// Outside demo mode the identity the UI renders from is the real signed-in user, resolved once per
    /// circuit from the authentication cookie/token. Without this the nav, route guard, and "(you)"
    /// highlighting would still be reading a development persona.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (IsDemoMode)
        {
            return;
        }

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity is { IsAuthenticated: true })
        {
            var userId = user.FindFirst("oid")?.Value
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.Identity.Name!;
            var displayName = user.FindFirst("name")?.Value ?? user.Identity.Name ?? userId;
            var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            Identity.SetRealUser(userId, displayName, roles);
        }
        else
        {
            Identity.SetPersona("guest");
        }
    }


    private void Switch(string key)
    {
        Identity.SetPersona(key);
        if (!AllowedHere())
        {
            Nav.NavigateTo("/");
        }
    }

    private void OnIdentityChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    // Central route guard — mirrors the server policies (RequireEmployee / RequireSupervisor / PlatformAdmin).
    private bool AllowedHere()
    {
        var seg = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant().Split('/')[0];
        return seg switch
        {
            // Public browsing. Compete and the leaderboards are here for the same reason Learn is: seeing
            // what people are competing on, and who is winning, is what makes somebody want an account.
            // The server agrees — browse, detail and leaderboard are AllowAnonymous, and everything that
            // acts (join, download, submit) is still RequireEmployee.
            "" or "learn" or "community" or "compete" or "leaderboards" => true,
            "supervision" => Identity.IsSupervisor,
            "admin" => Identity.IsPlatformAdmin,
            _ => Identity.HasAnyPosition,                // dashboard, compete, profile — the Studio surfaces are the desktop app now
        };
    }

    public void Dispose()
    {
        Identity.Changed -= OnIdentityChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
