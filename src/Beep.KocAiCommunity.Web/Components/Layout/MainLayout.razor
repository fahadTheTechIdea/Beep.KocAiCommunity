@inherits LayoutComponentBase
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Microsoft.Extensions.Hosting
@using Microsoft.AspNetCore.Components.Authorization
@using Beep.KocAiCommunity.ServiceDefaults.Security
@using Beep.KocAiCommunity.Web.Security
@inject DevIdentity Identity
@inject IHostEnvironment Env
@inject NavigationManager Nav
@inject KocSetupStore SetupStore
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<DemoDisclaimer />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation" />
        <MudImage Src="@KocBrand.LogoPath" Alt="Kuwait Oil Company" Height="38" Class="mr-3" />
        <div class="d-flex flex-column" style="line-height:1.15;">
            <MudText Typo="Typo.h6" Class="koc-heading d-none d-sm-flex">@KocBrand.ProductName</MudText>
            <MudText Typo="Typo.h6" Class="koc-heading d-flex d-sm-none">@KocBrand.ShortName</MudText>
            <MudText Typo="Typo.caption" Class="d-none d-md-flex" Style="opacity:.7;">@KocBrand.Company · @KocBrand.SubTitle</MudText>
        </div>
        <MudSpacer />

        @if (!Identity.IsGuest)
        {
            <StandingChip @key="Identity.UserId" />
            <NotificationBell />
        }

        @* These items moved off the left drawer and sit directly on the top-right, always visible. *@
        <MudTooltip Text="Help & guides">
            <MudIconButton Href="/help" Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" aria-label="Help" />
        </MudTooltip>

        @if (Identity.HasAnyPosition)
        {
            <MudButton Href="/profile" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.EmojiEvents" Class="ml-1">My profile</MudButton>
        }

        @if (Identity.IsPlatformAdmin)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-1">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AdminPanelSettings" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@context.ToggleAsync">Admin</MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.SpaceDashboard">Console</MudMenuItem>
                    <MudMenuItem Href="/admin/overview" Icon="@Icons.Material.Filled.Map">Overview</MudMenuItem>
                    <MudMenuItem Href="/connectors" Icon="@Icons.Material.Filled.Hub">Connectors</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }

        @if (IsDemoMode)
        {
            @* Demo mode only: switch personas to preview the app as different roles. Never with real sign-in. *@
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-2">
                <ActivatorContent>
                    @if (Identity.IsGuest)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" OnClick="@context.ToggleAsync">Sign in with KOC</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountCircle" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@context.ToggleAsync">
                            @Identity.Current.Label
                        </MudButton>
                    }
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.caption" Class="px-4 py-2 d-block">View the app as (dev)</MudText>
                    <MudDivider />
                    @foreach (var p in DevIdentity.Personas)
                    {
                        <MudMenuItem OnClick="@(() => Switch(p.Key))">
                            @if (p.Key == Identity.Current.Key)
                            {
                                <b>@p.Label ✓</b>
                            }
                            else
                            {
                                @p.Label
                            }
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        else if (Identity.IsGuest)
        {
            @* Real sign-in: local accounts get a login page; intranet/Entra sign the visitor in themselves. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" Class="ml-2"
                       Href="@LoginHref">@SignInPrompt.ButtonText(SetupStore)</MudButton>
        }
        else
        {
            @* Signed in for real: show who, and offer sign-out where there's a session to end. *@
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-2">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountCircle"
                               EndIcon="@(HasLoginPage ? Icons.Material.Filled.ArrowDropDown : null)" OnClick="@context.ToggleAsync">
                        @Identity.Current.Label
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.EmojiEvents">My profile</MudMenuItem>
                    @if (HasLoginPage)
                    {
                        <MudDivider />
                        <form method="post" action="/account/logout" style="margin:0;">
                            <button type="submit" class="koc-menu-form-button">Sign out</button>
                        </form>
                    }
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @if (AllowedHere())
            {
                @Body
            }
            else
            {
                <BlueprintCard Class="pa-8 mt-6" Style="max-width:560px;margin:0 auto;text-align:center;">
                    <MudIcon Icon="@(Identity.IsGuest ? Icons.Material.Filled.Lock : Icons.Material.Filled.Block)" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    @if (Identity.IsGuest)
                    {
                        <MudText Typo="Typo.h6" Class="koc-heading mb-1">Sign in to continue</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">This area is for signed-in members. @SignInPrompt.HowToSignIn(SetupStore)</MudText>
                        @if (IsDemoMode)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Switch("employee"))">View as Employee</MudButton>
                        }
                        else if (HasLoginPage)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@LoginHref">@SignInPrompt.ButtonText(SetupStore)</MudButton>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" Class="koc-heading mb-1">You don't have access to this area</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">Your role (<b>@Identity.Current.Label</b>) can't view this page. Supervision needs a team-lead role or above; Admin needs Platform Admin.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/">Back to home</MudButton>
                    }
                </BlueprintCard>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = KocTheme.Build();
    private bool _drawerOpen = true;

    /// <summary>True when nobody really signs in and the persona switcher stands in for an identity.</summary>
    private bool IsDemoMode => SetupStore.DemoPersonasEnabled;

    /// <summary>
    /// True when this site holds the credentials, so there is a login page to send people to and a
    /// session of ours to end. Inside KOC the corporate account is the session — signing out here would
    /// only be re-established by the next request.
    /// </summary>
    private bool HasLoginPage => SetupStore.SignInWith == KocSignInSource.SiteAccounts;

    private string LoginHref => HasLoginPage ? "/account/login" : "/";

    protected override void OnInitialized()
    {
        Identity.Changed += OnIdentityChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// Outside demo mode the identity the UI renders from is the real signed-in user, resolved once per
    /// circuit from the authentication cookie/token. Without this the nav, route guard, and "(you)"
    /// highlighting would still be reading a development persona.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (IsDemoMode)
        {
            return;
        }

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity is { IsAuthenticated: true })
        {
            var userId = user.FindFirst("oid")?.Value
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.Identity.Name!;
            var displayName = user.FindFirst("name")?.Value ?? user.Identity.Name ?? userId;
            var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            Identity.SetRealUser(userId, displayName, roles);
        }
        else
        {
            Identity.SetPersona("guest");
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void Switch(string key)
    {
        Identity.SetPersona(key);
        if (!AllowedHere())
        {
            Nav.NavigateTo("/");
        }
    }

    private void OnIdentityChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    // Central route guard — mirrors the server policies (RequireEmployee / RequireSupervisor / PlatformAdmin).
    private bool AllowedHere()
    {
        var seg = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant().Split('/')[0];
        return seg switch
        {
            "" or "learn" or "community" => true,       // public browsing
            "supervision" => Identity.IsSupervisor,
            "admin" => Identity.IsPlatformAdmin,
            _ => Identity.HasAnyPosition,                // dashboard / compete / datasets / studio / workflow / models
        };
    }

    public void Dispose()
    {
        Identity.Changed -= OnIdentityChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
