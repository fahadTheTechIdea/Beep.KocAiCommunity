@using Beep.KocAiCommunity.Client
@inject DevIdentity Identity
@implements IDisposable

@* Navigation items that moved off the left drawer into the top-right account menu:
   the participant's own profile and the platform-admin console. Rendered inside a MudMenu so
   each item is a real navigating link. *@

@if (Identity.HasAnyPosition)
{
    <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.EmojiEvents">My profile</MudMenuItem>
}

@if (Identity.IsPlatformAdmin)
{
    <MudDivider Class="my-1" />
    <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.SpaceDashboard">Admin console</MudMenuItem>
    <MudMenuItem Href="/admin/overview" Icon="@Icons.Material.Filled.Map">Admin overview</MudMenuItem>
    <MudMenuItem Href="/connectors" Icon="@Icons.Material.Filled.Hub">Connectors</MudMenuItem>
}

@code {
    protected override void OnInitialized() => Identity.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Identity.Changed -= OnChanged;
}
