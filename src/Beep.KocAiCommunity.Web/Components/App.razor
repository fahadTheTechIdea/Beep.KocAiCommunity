@using Beep.KocAiCommunity.Contracts.Localization
@using Beep.KocAiCommunity.Web.Security
@inject IHttpContextAccessor Http

@* App.razor renders as static SSR, so it can read the language the request resolved to. Setting dir
   here rather than on an inner element is what makes MudBlazor mirror: its CSS is built on logical
   properties (margin-inline, padding-inline), which follow the document direction on their own. *@
<!DOCTYPE html>
<html lang="@_language" dir="@KocLanguages.Direction(_language)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="_content/Beep.KocAiCommunity.Ui.Shared/brand/KOC_Logo.png" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="_content/Z.Blazor.Diagrams/style.min.css" />
    <link rel="stylesheet" href="_content/Z.Blazor.Diagrams/default.styles.min.css" />
    <link rel="stylesheet" href="_content/Beep.KocAiCommunity.Ui.Shared/css/koc-blueprint.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/Z.Blazor.Diagrams/script.min.js"></script>
    <script src="js/celebrations.js"></script>
</body>

</html>

@code {
    private string _language = KocLanguages.English;

    protected override void OnInitialized() => _language = Http.HttpContext.CurrentLanguage();
}
