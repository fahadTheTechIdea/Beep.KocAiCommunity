@page "/community"
@using Beep.KocAiCommunity.Contracts.Community
@using Beep.KocAiCommunity.Contracts.Engagement
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Dialogs
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IKocApiClient Api
@inject IDialogService DialogService
@inject DevIdentity Identity
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Community · @KocBrand.ProductName</PageTitle>

<PageHeader Eyebrow="Community" Title="The KOC AI community"
            Subtitle="Learn together, cheer each other on, and climb the leaderboards — everything stays inside KOC.">
    <Actions>
        @if (Identity.HasAnyPosition)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">New discussion</MudButton>
        }
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">Couldn't reach the API (@_error).</MudAlert>
}

@* ---- Community pulse: stats + champions podium (real data only) ---- *@
@if (!Identity.IsGuest)
{
    <MudGrid Spacing="4" Class="mb-2">
        <MudItem xs="12" md="5">
            <BlueprintCard Class="pa-4" Style="height:100%;">
                <MudText Typo="Typo.overline" Class="mb-2">Community pulse</MudText>
                <div class="d-flex flex-wrap gap-6">
                    <div>
                        <div class="koc-stat-value" style="font-size:26px;">@(_discussions?.Count ?? 0)</div>
                        <MudText Typo="Typo.caption">discussions</MudText>
                    </div>
                    <div>
                        <div class="koc-stat-value" style="font-size:26px;">@_earnedBadges<span style="font-size:14px;opacity:.5;">/@_totalBadges</span></div>
                        <MudText Typo="Typo.caption">badges earned</MudText>
                    </div>
                    <div>
                        <div class="koc-stat-value" style="font-size:26px;">@(_myRank is { } r ? $"#{r}" : "—")</div>
                        <MudText Typo="Typo.caption">your rank (month)</MudText>
                    </div>
                    @if (_profile is not null)
                    {
                        <div>
                            <div class="koc-stat-value" style="font-size:26px;">🛢️ @_profile.XpTotal</div>
                            <MudText Typo="Typo.caption">your Barrels</MudText>
                        </div>
                    }
                </div>
            </BlueprintCard>
        </MudItem>

        <MudItem xs="12" md="7">
            <BlueprintCard Class="pa-4" Style="height:100%;">
                <div class="d-flex justify-space-between align-center mb-1">
                    <MudText Typo="Typo.overline">🏆 Champions this month</MudText>
                    <MudLink Typo="Typo.caption" @onclick="@(() => _tab = 1)" Style="cursor:pointer;">Full leaderboard →</MudLink>
                </div>
                @if (_champions is null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_champions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="opacity:.7;">No Barrels earned yet this month — the podium is wide open.</MudText>
                }
                else
                {
                    <div class="d-flex align-end justify-center gap-3" style="min-height:120px;">
                        @foreach (var (row, slot) in Podium(_champions))
                        {
                            <div style="text-align:center;cursor:pointer;@(slot == 1 ? "order:2;" : slot == 2 ? "order:1;" : "order:3;")"
                                 @onclick="() => ViewProfile(row.UserId)">
                                <MudAvatar Size="@(slot == 1 ? Size.Large : Size.Medium)" Style="background:#fff;margin:0 auto;">
                                    <MudImage Src="@KocBrand.Icon(row.AvatarIcon)" />
                                </MudAvatar>
                                <div style="font-size:22px;">@Medal(slot)</div>
                                <MudText Typo="Typo.caption" Class="koc-heading" Style="max-width:110px;">@row.DisplayName</MudText>
                                <div class="koc-heading" style="@PodiumBar(slot)">🛢️ @row.XpTotal</div>
                            </div>
                        }
                    </div>
                }
            </BlueprintCard>
        </MudItem>
    </MudGrid>
}

<MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pt-2">
    @* ============ FEED ============ *@
    <MudTabPanel Text="Discussions" Icon="@Icons.Material.Filled.Forum">
        <MudGrid Spacing="6">
            <MudItem xs="12" md="5">
                @if (_discussions is null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (_discussions.Count == 0)
                {
                    <BlueprintCard Class="pa-6" Style="text-align:center;">
                        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="koc-heading mb-1">Start the conversation</MudText>
                        <MudText Typo="Typo.body2">No discussions yet — share a question, a tip, or a win.</MudText>
                    </BlueprintCard>
                }
                else
                {
                    @foreach (var d in _discussions)
                    {
                        <div @onclick="() => Open(d.Id)" style="cursor:pointer;">
                            <BlueprintCard Class="pa-4 mb-3" Style="@(d.Id == _open?.Id ? "border-color:var(--koc-accent-500);" : "")">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@Initials(d.AuthorDisplayName)</MudAvatar>
                                    <div class="flex-grow-1" style="min-width:0;">
                                        <div class="d-flex align-center gap-1">
                                            @if (d.IsPinned)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Color="Color.Primary" />
                                            }
                                            <MudText Typo="Typo.subtitle2" Class="koc-heading" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@d.Title</MudText>
                                            @if (d.IsLocked)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="opacity:.5;" />
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption" Style="opacity:.7;">@d.AuthorDisplayName · @Ago(d.CreatedUtc)</MudText>
                                    </div>
                                    <div style="text-align:center;">
                                        <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" Style="opacity:.5;" />
                                        <MudText Typo="Typo.caption"><b>@d.ReplyCount</b></MudText>
                                    </div>
                                </div>
                                <div class="d-flex align-center gap-2 mt-1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Style="opacity:.7;">@d.Scope</MudChip>
                                    @if (d.Reactions.Count > 0)
                                    {
                                        <span style="opacity:.85;font-size:13px;">@string.Join("  ", d.Reactions.Select(r => $"{r.Emoji} {r.Count}"))</span>
                                    }
                                </div>
                            </BlueprintCard>
                        </div>
                    }
                }
            </MudItem>

            <MudItem xs="12" md="7">
                @if (_open is null)
                {
                    <BlueprintCard Class="pa-8" Style="text-align:center;">
                        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.body2">Select a discussion to read and reply.</MudText>
                    </BlueprintCard>
                }
                else
                {
                    <BlueprintCard Class="pa-5">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <div class="d-flex align-center gap-1">
                                @if (_open.IsPinned)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Color="Color.Primary" />
                                }
                                <MudText Typo="Typo.h6" Class="koc-heading">@_open.Title</MudText>
                                @if (_open.IsLocked)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Filled.Lock">Locked</MudChip>
                                }
                            </div>
                            <div class="d-flex align-center">
                                @if (Identity.HasAnyPosition && _open.AuthorUserId != Identity.UserId)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Celebration" OnClick="() => KudosTo(_open.AuthorUserId, _open.AuthorDisplayName)">Kudos</MudButton>
                                }
                                @if (_open.CanModerate)
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                        <MudMenuItem Icon="@Icons.Material.Filled.PushPin" OnClick="() => Pin(!_open.IsPinned)">@(_open.IsPinned ? "Unpin" : "Pin")</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Lock" OnClick="() => Lock(!_open.IsLocked)">@(_open.IsLocked ? "Unlock" : "Lock")</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteThread">Delete thread</MudMenuItem>
                                    </MudMenu>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@Initials(_open.AuthorDisplayName)</MudAvatar>
                            <MudText Typo="Typo.caption" Style="opacity:.75;">@_open.AuthorDisplayName · @_open.Scope · @Ago(_open.CreatedUtc)</MudText>
                        </div>
                        <MudText Typo="Typo.body1" Class="mb-2" Style="white-space:pre-wrap;">@_open.Body</MudText>
                        <ReactionBar Reactions="_open.Reactions" OnReact="ReactToThread" />

                        @if (_open.Attachments.Count > 0)
                        {
                            <div class="mt-3">
                                <MudText Typo="Typo.caption" Class="koc-heading">Attachments</MudText>
                                @foreach (var a in _open.Attachments)
                                {
                                    <div class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                        <MudLink Href="@($"/api/v1/community/attachments/{a.Id}")" Target="_blank" Typo="Typo.body2">@a.FileName</MudLink>
                                        <MudText Typo="Typo.caption" Style="opacity:.6;">(@FormatSize(a.SizeBytes))</MudText>
                                    </div>
                                }
                            </div>
                        }

                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Class="koc-heading mb-2">@_open.Replies.Count @(_open.Replies.Count == 1 ? "reply" : "replies")</MudText>

                        @foreach (var r in _open.Replies)
                        {
                            <div class="d-flex gap-2 mb-3">
                                <MudAvatar Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@Initials(r.AuthorDisplayName)</MudAvatar>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-center justify-space-between">
                                        <MudText Typo="Typo.caption"><b>@r.AuthorDisplayName</b> · @Ago(r.CreatedUtc)</MudText>
                                        @if (_open.CanModerate || r.AuthorUserId == Identity.UserId)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default" OnClick="() => DeleteReply(r.Id)" />
                                        }
                                    </div>
                                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@r.Body</MudText>
                                    <ReactionBar Reactions="r.Reactions" OnReact="@(emoji => ReactToReply(r.Id, emoji))" />
                                </div>
                            </div>
                        }

                        @if (_open.IsLocked)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-3">This discussion is locked — no new replies.</MudAlert>
                        }
                        else
                        {
                            <div class="mt-4 d-flex gap-2">
                                <MudAutocomplete T="MentionCandidateDto" Label="Mention" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                 Style="max-width:160px;" SearchFunc="SearchMentions" ToStringFunc="@(c => c?.DisplayName ?? "")"
                                                 ValueChanged="AppendMention" ResetValueOnEmptyText="true" CoerceText="false" />
                                <MudTextField @bind-Value="_replyBody" Label="Write a reply" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                <MudTooltip Text="Attach a file">
                                    <label class="d-inline-flex align-center" style="cursor:pointer;height:100%;">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Color="Color.Default" />
                                        <InputFile OnChange="UploadAttachment" style="display:none;" />
                                    </label>
                                </MudTooltip>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reply" Disabled="@string.IsNullOrWhiteSpace(_replyBody)">Send</MudButton>
                            </div>
                        }
                    </BlueprintCard>
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ============ LEADERBOARDS ============ *@
    <MudTabPanel Text="Leaderboards" Icon="@Icons.Material.Filled.Leaderboard" OnClick="EnsureLeaderboards">
        <div class="d-flex gap-2 mb-4">
            @foreach (var p in _periods)
            {
                <MudButton Variant="@(p.Key == _period ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => ChangePeriod(p.Key))">@p.Label</MudButton>
            }
        </div>

        <MudGrid Spacing="6">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="koc-heading mb-3">🏆 Top learners</MudText>
                @if (_xpBoard is null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (_xpBoard.Count == 0)
                {
                    <BlueprintCard Class="pa-5"><MudText Typo="Typo.body2">No Barrels earned in this period yet — be the first!</MudText></BlueprintCard>
                }
                else
                {
                    @foreach (var row in _xpBoard)
                    {
                        <BlueprintCard Class="pa-3 mb-2" Style="@RowStyle(row.Rank, row.IsMe)">
                            <div class="d-flex align-center gap-3">
                                <span style="font-size:20px;width:34px;text-align:center;">@Medal(row.Rank)</span>
                                <MudAvatar Size="Size.Small" Style="background:#fff;cursor:pointer;" @onclick="() => ViewProfile(row.UserId)"><MudImage Src="@KocBrand.Icon(row.AvatarIcon)" /></MudAvatar>
                                <div class="flex-grow-1" style="cursor:pointer;" @onclick="() => ViewProfile(row.UserId)">
                                    <MudText Typo="Typo.body2"><b>@row.DisplayName</b> @(row.IsMe ? "(you)" : "")</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:.7;">Lvl @row.Level · @row.LevelTitle</MudText>
                                </div>
                                @if (Identity.HasAnyPosition && !row.IsMe)
                                {
                                    <MudTooltip Text="Give kudos">
                                        <MudIconButton Icon="@Icons.Material.Filled.Celebration" Size="Size.Small" Color="Color.Primary" OnClick="() => KudosTo(row.UserId, row.DisplayName)" />
                                    </MudTooltip>
                                }
                                <MudText Typo="Typo.body1"><b>🛢️ @row.XpTotal</b></MudText>
                            </div>
                        </BlueprintCard>
                    }
                }
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="koc-heading mb-3">🛢️ Team standings</MudText>
                @if (_teamBoard is null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (_teamBoard.Count == 0)
                {
                    <BlueprintCard Class="pa-5"><MudText Typo="Typo.body2">Team standings appear once colleagues start earning Barrels.</MudText></BlueprintCard>
                }
                else
                {
                    @foreach (var t in _teamBoard)
                    {
                        <BlueprintCard Class="pa-3 mb-2" Style="@RowStyle(t.Rank, t.IsMyTeam)">
                            <div class="d-flex align-center gap-3">
                                <span style="font-size:20px;width:34px;text-align:center;">@Medal(t.Rank)</span>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body2"><b>@t.OrgUnitName</b> @(t.IsMyTeam ? "(your team)" : "")</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:.7;">@t.MemberCount active · @t.TotalXp bbl total</MudText>
                                </div>
                                <MudText Typo="Typo.body1"><b>@t.AverageXp</b> avg</MudText>
                            </div>
                        </BlueprintCard>
                    }
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ============ BADGES ============ *@
    <MudTabPanel Text="Badges" Icon="@Icons.Material.Filled.WorkspacePremium" OnClick="EnsureBadges">
        @if (_badges is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                You've earned <b>@_earnedBadges of @_totalBadges</b> badges. Keep learning, competing, and helping colleagues to collect them all.
            </MudText>
            <MudGrid Spacing="4">
                @foreach (var b in _badges.OrderByDescending(x => x.EarnedUtc.HasValue).ThenBy(x => x.Name))
                {
                    var earned = b.EarnedUtc.HasValue;
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <BlueprintCard Class="pa-4" Style="@(earned ? "height:100%;border-color:var(--koc-accent-500);" : "height:100%;opacity:.6;")">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudAvatar Size="Size.Medium" Style="@(earned ? "background:#fff;" : "background:#eef1f4;filter:grayscale(1);")">
                                    <MudImage Src="@KocBrand.Icon(b.IconFile)" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="koc-heading">@b.Name</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@TierColor(b.Tier)" Class="pa-0">@b.Tier</MudChip>
                                </div>
                            </div>
                            <MudText Typo="Typo.caption" Style="opacity:.8;">@b.Description</MudText>
                            <div class="mt-2">
                                @if (earned)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircle">Earned @b.EarnedUtc!.Value.ToLocalTime().ToString("d MMM yyyy")</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Lock">Locked</MudChip>
                                }
                            </div>
                        </BlueprintCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>

    @* ============ ACTIVITY ============ *@
    <MudTabPanel Text="Activity" Icon="@Icons.Material.Filled.Bolt" OnClick="EnsureActivity">
        @if (_activity is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_activity.Count == 0)
        {
            <BlueprintCard Class="pa-6" Style="text-align:center;">
                <MudText Typo="Typo.body2">Nothing here yet. Earn a badge or cheer a colleague to get things moving.</MudText>
            </BlueprintCard>
        }
        else
        {
            @foreach (var a in _activity)
            {
                <BlueprintCard Class="pa-3 mb-2">
                    <div class="d-flex align-center gap-3">
                        @if (!string.IsNullOrEmpty(a.IconFile))
                        {
                            <MudAvatar Size="Size.Small" Style="background:#fff;"><MudImage Src="@KocBrand.Icon(a.IconFile)" /></MudAvatar>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" />
                        }
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body2"><b>@a.ActorDisplayName</b> @a.Summary</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.7;">@Ago(a.CreatedUtc)</MudText>
                        </div>
                    </div>
                </BlueprintCard>
            }
        }
    </MudTabPanel>
</MudTabs>

@code {
    private int _tab;
    private IReadOnlyList<DiscussionDto>? _discussions;
    private DiscussionDetailDto? _open;
    private string? _error;
    private string _replyBody = "";

    private ProfileDto? _profile;
    private IReadOnlyList<XpLeaderboardRowDto>? _champions;
    private int? _myRank;
    private int _earnedBadges;
    private int _totalBadges;

    private IReadOnlyList<XpLeaderboardRowDto>? _xpBoard;
    private IReadOnlyList<TeamLeaderboardRowDto>? _teamBoard;
    private IReadOnlyList<BadgeDto>? _badges;
    private IReadOnlyList<ActivityDto>? _activity;
    private string _period = "week";

    private readonly (string Key, string Label)[] _periods =
    [
        ("week", "This week"), ("month", "This month"), ("all", "All time"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDiscussionsAsync();
        await LoadPulseAsync();
    }

    // Real, cheap data for the hero — profile, monthly champions, and badge counts.
    private async Task LoadPulseAsync()
    {
        if (Identity.IsGuest)
        {
            return;
        }

        try { _profile = await Api.GetMyProfileAsync(); } catch { _profile = null; }
        try
        {
            var monthly = await Api.GetXpLeaderboardAsync("month");
            _champions = monthly;
            _myRank = monthly.FirstOrDefault(r => r.IsMe)?.Rank;
        }
        catch { _champions = []; }
        try
        {
            var catalog = await Api.GetBadgeCatalogAsync();
            _totalBadges = catalog.Count;
            _earnedBadges = catalog.Count(b => b.EarnedUtc.HasValue);
        }
        catch { /* leave zero */ }
    }

    private async Task LoadDiscussionsAsync()
    {
        try
        {
            _error = null;
            _discussions = await Api.GetDiscussionsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task EnsureLeaderboards()
    {
        if (_xpBoard is null)
        {
            await LoadLeaderboardsAsync();
        }
    }

    private async Task LoadLeaderboardsAsync()
    {
        try
        {
            _xpBoard = await Api.GetXpLeaderboardAsync(_period);
            _teamBoard = await Api.GetTeamLeaderboardAsync(_period);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ChangePeriod(string period)
    {
        _period = period;
        _xpBoard = null;
        _teamBoard = null;
        await LoadLeaderboardsAsync();
    }

    private async Task EnsureBadges()
    {
        if (_badges is null)
        {
            try { _badges = await Api.GetBadgeCatalogAsync(); }
            catch (Exception ex) { _error = ex.Message; }
        }
    }

    private async Task EnsureActivity()
    {
        if (_activity is null)
        {
            try { _activity = await Api.GetActivityAsync(); }
            catch (Exception ex) { _error = ex.Message; }
        }
    }

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<CreateDiscussionDialog>("New discussion");
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadDiscussionsAsync();
        }
    }

    private async Task Open(Guid id) => _open = await Api.GetDiscussionAsync(id);

    private async Task Reply()
    {
        if (_open is null)
        {
            return;
        }

        await Api.AddReplyAsync(_open.Id, _replyBody);
        _replyBody = "";
        _open = await Api.GetDiscussionAsync(_open.Id);
    }

    private async Task ReactToThread(string emoji)
    {
        if (_open is null)
        {
            return;
        }

        await Api.ReactToDiscussionAsync(_open.Id, emoji);
        await ReloadOpenAsync();
    }

    private async Task ReactToReply(Guid replyId, string emoji)
    {
        if (_open is null)
        {
            return;
        }

        await Api.ReactToReplyAsync(_open.Id, replyId, emoji);
        await ReloadOpenAsync();
    }

    private async Task Pin(bool pinned) => await ModerateAsync(() => Api.SetDiscussionPinAsync(_open!.Id, pinned));
    private async Task Lock(bool locked) => await ModerateAsync(() => Api.SetDiscussionLockAsync(_open!.Id, locked));

    private async Task DeleteThread()
    {
        if (_open is null)
        {
            return;
        }

        var error = await Api.DeleteDiscussionAsync(_open.Id);
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        _open = null;
        await LoadDiscussionsAsync();
    }

    private async Task DeleteReply(Guid replyId)
    {
        if (_open is null)
        {
            return;
        }

        var error = await Api.DeleteReplyAsync(_open.Id, replyId);
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        await ReloadOpenAsync();
    }

    private async Task ModerateAsync(Func<Task<string?>> action)
    {
        if (_open is null)
        {
            return;
        }

        var error = await action();
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        await ReloadOpenAsync();
        await LoadDiscussionsAsync();
    }

    private async Task<IEnumerable<MentionCandidateDto>> SearchMentions(string value, CancellationToken token) =>
        await Api.SearchMentionCandidatesAsync(value ?? "");

    private void AppendMention(MentionCandidateDto? candidate)
    {
        if (candidate is null)
        {
            return;
        }

        var handle = new string(candidate.DisplayName.Where(c => !char.IsWhiteSpace(c)).ToArray());
        _replyBody = string.IsNullOrWhiteSpace(_replyBody) ? $"@{handle} " : $"{_replyBody.TrimEnd()} @{handle} ";
    }

    private async Task UploadAttachment(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (_open is null || file is null)
        {
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 25L * 1024 * 1024);
        var (attachment, error) = await Api.AddAttachmentAsync(_open.Id, stream, file.Name);
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        Snackbar.Add($"Attached {attachment!.FileName}.", Severity.Success);
        await ReloadOpenAsync();
    }

    private async Task ReloadOpenAsync()
    {
        if (_open is not null)
        {
            _open = await Api.GetDiscussionAsync(_open.Id);
        }
    }

    private async Task KudosTo(string userId, string displayName)
    {
        var parameters = new DialogParameters
        {
            ["RecipientUserId"] = userId,
            ["RecipientName"] = displayName,
            ["RefType"] = "discussion",
            ["RefId"] = _open?.Id,
        };
        var dialog = await DialogService.ShowAsync<GiveKudosDialog>("Give kudos", parameters);
        await dialog.Result;
    }

    private void ViewProfile(string userId) => Nav.NavigateTo($"/profile/{userId}");

    // Top three arranged for the podium (index 0 = rank 1, etc.), skipping missing places.
    private static IEnumerable<(XpLeaderboardRowDto Row, int Slot)> Podium(IReadOnlyList<XpLeaderboardRowDto> rows) =>
        rows.Take(3).Select((r, i) => (r, i + 1));

    private static string PodiumBar(int slot) => slot switch
    {
        1 => "font-size:15px;margin-top:4px;padding-top:20px;border-top:3px solid var(--koc-accent-700);",
        2 => "font-size:13px;margin-top:4px;padding-top:12px;border-top:3px solid var(--koc-accent-500);",
        _ => "font-size:13px;margin-top:4px;padding-top:6px;border-top:3px solid var(--koc-accent-300);",
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)span.TotalMinutes}m ago",
            { TotalHours: < 24 } => $"{(int)span.TotalHours}h ago",
            { TotalDays: < 7 } => $"{(int)span.TotalDays}d ago",
            _ => utc.ToLocalTime().ToString("d MMM"),
        };
    }

    private static Color TierColor(string tier) => tier.ToLowerInvariant() switch
    {
        "gold" => Color.Warning,
        "silver" => Color.Default,
        "bronze" => Color.Tertiary,
        _ => Color.Primary,
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B",
    };

    private static string Medal(int rank) => rank switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => $"#{rank}",
    };

    private static string RowStyle(int rank, bool highlight)
    {
        var tint = rank switch
        {
            1 => "background:rgba(212,160,23,.10);",
            2 => "background:rgba(154,166,178,.12);",
            3 => "background:rgba(184,115,51,.10);",
            _ => "",
        };
        return highlight ? tint + "border-color:var(--koc-accent-500);" : tint;
    }
}
