@page "/"
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Contracts.Engagement
@using Beep.KocAiCommunity.Contracts.Supervision
@using Beep.KocAiCommunity.ServiceDefaults.Security
@using Beep.KocAiCommunity.Web.Security
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Beep.KocAiCommunity.Contracts.Localization
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject DevIdentity Identity
@inject IStringLocalizer<Strings> L
@inject IKocApiClient Api
@inject NavigationManager Nav
@inject KocSetupStore Setup
@implements IDisposable

@* The page leads with what this is, then proves it with live data — the featured competition and its
   standings, the month's champions, the challenges running now. One primary call to action, in the
   hero; every other button navigates somewhere real rather than asking again. *@

<PageTitle>@KocBrand.ProductName</PageTitle>

@* A filter you cannot see is a bug report waiting to happen: somebody picks an area, forgets, and later
   reports that competitions have vanished. It says what is in force and clears in one click. *@
@if (FilterName is { } areaName)
{
    <div class="koc-filterbar mb-6">
        <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
        <span class="koc-filterbar-text">@L["Showing"] <strong>@areaName</strong></span>
        <MudButton Href="/" Variant="Variant.Text" Size="Size.Small" Class="koc-filterbar-clear">@L["Show all areas"]</MudButton>
    </div>
}

<!-- 1 · Hero -->
@* Research on landing heroes is consistent: a headline alone converts badly, and the hero needs a
   "hero shot" that shows the offer, with the eye led headline → copy → visual. For a colleague who has
   never met machine learning, the fastest way to say what this is is to SHOW one prediction being made
   on something they recognise — a pump, its readings, and a warning — rather than describe it. *@
<section class="koc-hero mb-8">
    <div class="koc-hero-grid">
        <div class="koc-hero-copy">
            <span class="koc-eyebrow mb-3 d-block">@L[KocBrand.Company] · @(Identity.IsGuest ? L["Guest preview"] : Identity.Current.Label)</span>
            <MudText Typo="Typo.h2" HtmlTag="h1" Class="koc-heading koc-hero-title mb-4">@Content.Headline</MudText>
            <MudText Typo="Typo.body1" Class="koc-hero-lede mb-5">@Content.Sub</MudText>

            @* The four worries, as tiles rather than a line of small text. Nearly everyone who lands
               here believes this platform is for someone more technical than they are. *@
            @if (ShowNewcomerGuide)
            {
                <div class="koc-reassure mb-5">
                    <div><MudIcon Icon="@Icons.Material.Filled.Code" /><span>@L["No programming"]</span></div>
                    <div><MudIcon Icon="@Icons.Material.Filled.Functions" /><span>@L["No maths"]</span></div>
                    <div><MudIcon Icon="@Icons.Material.Filled.Schedule" /><span>@L["10 minutes to start"]</span></div>
                    <div><MudIcon Icon="@Icons.Material.Filled.Translate" /><span>@L["English & العربية"]</span></div>
                </div>
            }

            <div class="d-flex gap-3 flex-wrap align-center">
                @if (!ShowNewcomerGuide)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Dashboard" OnClick="PrimaryCta">@L["Continue where you left off"]</MudButton>
                }
                <MudLink Href="/compete" Typo="Typo.body1">@L["See what colleagues are solving"] →</MudLink>
                @if (Identity.IsGuest)
                {
                    <MudLink OnClick="PrimaryCta" Typo="Typo.body1" Style="cursor:pointer;">@SignInPrompt.ButtonText(Setup, L) →</MudLink>
                }
            </div>
        </div>

        @* The hero shot: one prediction, start to finish, on something the reader recognises — which is
           why it follows the chosen area. A colleague from HR has no reason to know what a vibration
           trace looks like, and showing them one is a worse explanation than showing them a payroll run. *@
        <div class="koc-hero-visual" aria-hidden="true">
            @{
                var shot = HeroShots.For(CategoryFilter);
                var (markX, markY) = HeroShots.Endpoint(shot);
            }
            <div class="koc-shot" @key="shot.Subject">
                <div class="koc-shot-head">
                    @if (HeroShots.ImagePath(shot) is { } shotIcon)
                    {
                        <img src="@shotIcon" alt="" width="40" height="40" />
                    }
                    else
                    {
                        <MudIcon Icon="@shot.Glyph" Class="koc-shot-glyph" />
                    }
                    <div>
                        <b>@L[shot.Subject]</b>
                        <span>@L[shot.Caption]</span>
                    </div>
                </div>

                <span class="koc-shot-label">@L["What the model sees"]</span>
                <svg class="koc-spark" viewBox="0 0 320 74" preserveAspectRatio="none" role="img">
                    <defs>
                        <linearGradient id="kocSparkFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#1466A5" stop-opacity=".28" />
                            <stop offset="100%" stop-color="#1466A5" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <path d="@HeroShots.AreaPath(shot)" fill="url(#kocSparkFill)" />
                    <polyline points="@shot.Points"
                              fill="none" stroke="#1466A5" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
                    <circle cx="@markX" cy="@markY" r="5" fill="#1F8A8C" stroke="#fff" stroke-width="2" />
                </svg>
                <div class="koc-shot-meta">
                    @foreach (var reading in shot.Readings)
                    {
                        <span>@L[reading]</span>
                    }
                </div>

                <div class="koc-shot-arrow"><MudIcon Icon="@Icons.Material.Filled.SouthEast" Size="Size.Small" /></div>

                <span class="koc-shot-label">@L["What it tells you"]</span>
                <div class="koc-shot-result">
                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                    <div>
                        <b>@L[shot.Verdict]</b>
                        <span>@L[shot.Advice]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* The platform's pulse in three figures — proof of life before any prose about what it does. *@
    <div class="koc-stat-strip">
        <div class="koc-stat"><b>@LiveCompetitionCount</b><span>@L["competitions running"]</span></div>
        <div class="koc-stat"><b>@TotalCompetitors</b><span>@L["competitors"]</span></div>
        <div class="koc-stat"><b>@TotalSubmissions</b><span>@L["submissions scored"]</span></div>
    </div>
</section>

@if (ShowNewcomerGuide)
{
    <!-- 1b · What machine learning actually is, for someone who has never been told.
         This is the section that decides whether a non-technical colleague stays. It does not define
         the term — it points at something they already do expertly and names that as the same thing. -->
    <section class="mb-8">
        <BlueprintCard Class="koc-explainer pa-6">
            <span class="koc-eyebrow d-block mb-3">@L["In plain words"]</span>
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="koc-heading mb-4" Style="max-width:26ch;">@L["You already do this. Every day."]</MudText>

            <div class="koc-explainer-grid">
                <div>
                    <MudText Typo="Typo.body1" Class="mb-4">
                        @L["An experienced operator walks past a pump and knows it sounds wrong. Nobody taught them a formula — they have simply seen thousands of pumps, and the pattern is in their head."]
                    </MudText>

                    @* The sentence the whole page turns on, set as a pull quote so a scanning reader
                       cannot miss it even if they read nothing else. *@
                    <p class="koc-pullquote">@L["Machine learning is that same trick, at a size no person can hold."]</p>

                    @* The scale, as figures. Prose numbers slide past the eye; these are the argument. *@
                    <div class="koc-scale">
                        <div><b>50,000</b><span>@L["pumps"]</span></div>
                        <div><b>200</b><span>@L["readings each"]</span></div>
                        <div><b>3</b><span>@L["years of history"]</span></div>
                    </div>
                    <MudText Typo="Typo.body1" Class="mb-4">@L["It finds the patterns nobody has time to look for."]</MudText>

                    <p class="koc-punchline">@L["And it only works because people like you already know which patterns matter. Your experience is the ingredient — the computer just counts faster."]</p>
                </div>

                @* Three real questions from three real parts of KOC, so "prediction" stops being abstract. *@
                <div class="koc-example-stack">
                    <div class="koc-example">
                        <img src="@KocBrand.Icon("034-pump-1.png")" alt="" width="34" height="34" />
                        <div>
                            <b>@L["Which pump fails next month?"]</b>
                            <span>@L["Maintenance, planned instead of urgent"]</span>
                        </div>
                    </div>
                    <div class="koc-example">
                        <img src="@KocBrand.Icon("039-oil-well.png")" alt="" width="34" height="34" />
                        <div>
                            <b>@L["Which well needs a visit?"]</b>
                            <span>@L["Send the rig where it earns its day"]</span>
                        </div>
                    </div>
                    <div class="koc-example">
                        <img src="@KocBrand.Icon("021-pressure-gauge.png")" alt="" width="34" height="34" />
                        <div>
                            <b>@L["Which reading is wrong?"]</b>
                            <span>@L["Catch the fault before the shutdown"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </BlueprintCard>
    </section>

    @* Asked here, not in the hero: at the top a newcomer has no idea what they would be starting.
       By this point they have been told, in their own terms, and the ask is a small one. *@
    <section class="mb-8">
        <BlueprintCard Class="koc-startnow pa-6">
            <div class="d-flex align-center justify-space-between flex-wrap gap-4">
                <div style="flex:1 1 340px;">
                    <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["That is the whole idea. Ready to try it?"]</MudText>
                    <MudText Typo="Typo.body2" Style="opacity:.8;">@L["The first lesson is ten minutes, in plain words, and nothing to install."]</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartLearning">@L["Start from zero — 10 minutes"]</MudButton>
            </div>
        </BlueprintCard>
    </section>

    <!-- 1c · The three steps, so the whole platform fits in one glance. -->
    <section class="mb-8">
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="koc-heading mb-4">@L["How it works"]</MudText>
        <MudGrid Spacing="4">
            <MudItem xs="12" md="4">
                <BlueprintCard Class="pa-6 koc-step" Style="height:100%;">
                    <span class="koc-step-num">01</span>
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="koc-heading mb-2">@L["Learn"]</MudText>
                    <MudText Typo="Typo.body2">@L["Short lessons in plain language, with pictures instead of equations. Start with 'AI for Everyone' — it assumes you know nothing, because most people don't."]</MudText>
                </BlueprintCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <BlueprintCard Class="pa-6 koc-step" Style="height:100%;">
                    <span class="koc-step-num">02</span>
                    <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="koc-heading mb-2">@L["Build"]</MudText>
                    <MudText Typo="Typo.body2">@L["Drag boxes and join them with lines — load the data, clean it, train. You describe the steps; the computer does the arithmetic. Nothing to install to look around."]</MudText>
                </BlueprintCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <BlueprintCard Class="pa-6 koc-step" Style="height:100%;">
                    <span class="koc-step-num">03</span>
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="koc-heading mb-2">@L["Compete"]</MudText>
                    <MudText Typo="Typo.body2">@L["Enter a challenge on a real KOC problem, see your score against colleagues, and collect Barrels and badges on the way. Friendly, and genuinely addictive."]</MudText>
                </BlueprintCard>
            </MudItem>
        </MudGrid>

        @* One safe first move. The Titanic is deliberately not an oil problem: nobody can feel out of
           their depth on it, which is the entire reason it is the starter. *@
        <BlueprintCard Class="koc-firststep pa-5 mt-4">
            <div class="d-flex align-center gap-4 flex-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Sailing" Color="Color.Primary" Size="Size.Large" />
                <div style="flex:1 1 320px;">
                    <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["Never done this before? Start with a shipwreck."]</MudText>
                    <MudText Typo="Typo.body2">@L["The Titanic challenge is the world's most famous first machine-learning puzzle. No oil-and-gas knowledge needed — just a passenger list and a question: who survived? Most people submit their first model within the hour."]</MudText>
                </div>
                <MudButton Href="/compete" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowForward">@L["Take the first challenge"]</MudButton>
            </div>
        </BlueprintCard>
    </section>
}

@if (!Identity.IsGuest && _myProfile is not null)
{
    <!-- Your own standing, so a returning member sees themselves before the crowd. -->
    <BlueprintCard Class="pa-5 mb-8" Style="border-color:var(--koc-accent-500);">
        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
            <div class="d-flex align-center gap-3">
                <XpRing AvatarIcon="@_myProfile.AvatarIcon" Level="@_myProfile.Level" LevelTitle="@_myProfile.LevelTitle"
                        XpTotal="@_myProfile.XpTotal" NextLevelXp="@_myProfile.NextLevelXp" Diameter="72" />
                <div>
                    <MudText Typo="Typo.h6" Class="koc-heading">@Greeting, @_myProfile.DisplayName</MudText>
                    @* The warm second line was how this page said hello in Arabic when there was no other way to.
                       Now that the interface has a language of its own, showing it under an Arabic
                       greeting would only say the same thing twice. *@
                    @if (!KocLanguages.IsRightToLeft(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName))
                    {
                        <MudText Typo="Typo.caption" Style="opacity:.7;direction:rtl;">@GreetingArabic</MudText>
                    }
                    <div class="d-flex gap-4 mt-1">
                        <MudText Typo="Typo.body2"><span class="koc-barrels">@_myProfile.XpTotal</span> @L["Barrels"]</MudText>
                        @if (_myProfile.CurrentStreakDays > 0)
                        {
                            <MudText Typo="Typo.body2"><span class="koc-streak">@_myProfile.CurrentStreakDays</span> @L["day streak"]</MudText>
                        }
                        <MudText Typo="Typo.body2"><b>@L["Lvl {0}", _myProfile.Level]</b> @_myProfile.LevelTitle</MudText>
                    </div>
                </div>
            </div>
            <MudButton Href="/profile" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EmojiEvents">@L["My profile"]</MudButton>
        </div>
    </BlueprintCard>
}

@if (Featured is { } featured)
{
    <!-- 2 · The featured competition, with its standings at full size — the most persuasive thing here. -->
    <section class="mb-8">
        <BlueprintCard Class="@($"koc-arena-banner pa-6{(featured.HasHeroImage ? " koc-has-photo" : "")}")" Style="@HeroStyle(featured)">
            <div class="d-flex justify-space-between flex-wrap gap-5">
                <div style="min-width:280px;max-width:60ch;">
                    <span class="koc-eyebrow">⚔ @L["Featured competition"]</span>
                    <MudText Typo="Typo.h4" HtmlTag="h2" Class="koc-heading" Style="color:#fff;text-wrap:balance;">🏆 @featured.Title</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.9;max-width:56ch;">@featured.Description</MudText>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color:#fff;border-color:rgba(255,255,255,.45);">@L[CompetitionDisplay.TaskLabel(featured.TaskType)]</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color:#fff;border-color:rgba(255,255,255,.45);">@CompetitionDisplay.MetricLabel(featured, L)</MudChip>
                        @if (!string.IsNullOrWhiteSpace(featured.FirstPrize))
                        {
                            <MudChip T="string" Size="Size.Small" Style="background:rgba(255,215,0,.2);color:#fff;border:1px solid rgba(255,215,0,.55);">🥇 @featured.FirstPrize</MudChip>
                        }
                    </div>
                    <MudButton Size="Size.Large" Variant="Variant.Filled" Class="koc-arena-cta"
                               Style="background:#fff;color:var(--koc-accent-900);font-weight:700;"
                               StartIcon="@Icons.Material.Filled.EmojiEvents" Href="@($"/compete/{featured.Id}")">@L["Enter the arena"]</MudButton>
                </div>
                <div class="d-flex flex-column gap-3" style="min-width:260px;">
                    <CountdownTimer TargetUtc="featured.RevealUtc" />
                    <div class="d-flex gap-4">
                        <div><span class="koc-stat-value koc-live" style="font-size:24px;">@featured.ParticipantCount</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.85;">@L["competitors"]</MudText></div>
                        <div><span class="koc-stat-value" style="font-size:24px;">@featured.SubmissionCount</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.85;">@L["submissions"]</MudText></div>
                    </div>
                    @if (CompetitionDisplay.RevealProgress(featured, DateTime.UtcNow) is { } progress)
                    {
                        <div class="koc-deadline-bar" title="@L["Progress toward the final reveal"]"><span style="width:@(((int)(progress * 100)))%"></span></div>
                    }
                </div>
            </div>
        </BlueprintCard>

        @* The live board, full width and with rank movement — the same component the competition page
           uses, rather than a three-row summary tucked into a corner. *@
        <BlueprintCard Class="pa-5 mt-4">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                <MudText Typo="Typo.h6" HtmlTag="h3" Class="koc-heading">🏁 @L["Live standings — {0}", featured.Title]</MudText>
                <MudLink Href="@($"/compete/{featured.Id}?tab=leaderboard")" Typo="Typo.body2">@L["Full leaderboard"] →</MudLink>
            </div>
            <div style="overflow-x:auto;">
                <LiveBoard Entries="_featuredBoard" MyUserId="@Identity.UserId" BoardKey="home-featured" />
            </div>
        </BlueprintCard>
    </section>
}

<!-- 3 · Champions — two boards, both at full size. -->
<section class="mb-8">
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="koc-heading">🏆 @L["This month's champions"]</MudText>
        @if (!Identity.IsGuest)
        {
            <MudLink Href="/community" Typo="Typo.body2">@L["All leaderboards"] →</MudLink>
        }
    </div>
    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <BlueprintCard Class="pa-5" Style="height:100%;">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="koc-heading mb-3">@L["Top learners"]</MudText>
                <XpBoard Entries="_xpBoard" Rows="10" Caption="@L["Top learners this month"]"
                         OnSelect="@(row => OpenProfile(row.UserId))" />
            </BlueprintCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <BlueprintCard Class="pa-5" Style="height:100%;">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="koc-heading mb-3">@L["Team standings"]</MudText>
                @if (_teamBoard is null)
                {
                    <div class="koc-board">
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="koc-board-row koc-board-skeleton" aria-hidden="true">
                                <span class="koc-board-rank"></span><span class="koc-board-avatar"></span>
                                <span class="koc-board-main"></span><span class="koc-board-score"></span>
                            </div>
                        }
                    </div>
                }
                else if (_teamBoard.Count == 0)
                {
                    <p class="koc-board-empty">@L["Team standings appear once colleagues start earning Barrels."]</p>
                }
                else
                {
                    <div class="koc-board">
                        @foreach (var t in _teamBoard.Take(10))
                        {
                            <div class="@($"koc-board-row{(t.Rank <= 3 ? " koc-board-podium" : "")}{(t.IsMyTeam ? " koc-board-me" : "")}")">
                                <span class="koc-board-rank"><RankMedal Rank="t.Rank" /></span>
                                <span class="koc-board-avatar"><MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" /></span>
                                <span class="koc-board-main">
                                    <b>@t.OrgUnitName@(t.IsMyTeam ? $" ({L["your team"]})" : "")</b>
                                    <small>@L["{0} people · {1} avg", t.MemberCount, t.AverageXp.ToString("N0")]</small>
                                </span>
                                <span class="koc-board-score">🛢️ @t.TotalXp.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
            </BlueprintCard>
        </MudItem>
    </MudGrid>
</section>

@if (Competitions is { Count: 0 } && FilterName is { } emptyArea)
{
    <!-- 4 · The chosen area has nothing running. Say so, and offer the way out. -->
    <section class="koc-emptyarea mb-8">
        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" />
        @* One string, not three fragments: Arabic puts these words in a different order. *@
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="koc-heading">@L["Nothing running in {0} just yet", emptyArea]</MudText>
        <MudText Typo="Typo.body2" Class="koc-muted">
            @L["Challenges are added as departments bring their own problems forward. In the meantime, everything else is still open."]
        </MudText>
        <div class="d-flex gap-2 mt-4 flex-wrap justify-center">
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">@L["Show all areas"]</MudButton>
            <MudButton Href="/learn" Variant="Variant.Outlined" Color="Color.Primary">@L["Start learning"]</MudButton>
        </div>
    </section>
}
else if (Competitions is { Count: > 0 })
{
    <!-- 4 · Everything currently running. -->
    <section class="mb-8">
        <div class="d-flex align-center justify-space-between mb-3">
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="koc-heading">⚔ @L["Competitions running now"]</MudText>
            <MudLink Href="/compete" Typo="Typo.body2">@L["All competitions"] →</MudLink>
        </div>
        <MudGrid Spacing="4">
            @foreach (var c in Competitions.Take(3))
            {
                <MudItem xs="12" md="4">
                    <CompetitionCard Competition="c" MyUserId="@Identity.UserId" />
                </MudItem>
            }
        </MudGrid>
    </section>
}

@if (_liveTracks is { Count: > 0 })
{
    <!-- 5 · Learning tracks straight from the catalog. -->
    <section class="mb-8">
        <div class="d-flex align-center justify-space-between mb-3">
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="koc-heading">🎓 @L["Learn & grow"]</MudText>
            <MudLink Href="/learn" Typo="Typo.body2">@L["All tracks"] →</MudLink>
        </div>
        <MudGrid Spacing="4">
            @foreach (var (t, i) in _liveTracks.Take(3).Select((x, i) => (x, i)))
            {
                <MudItem xs="12" md="4">
                    <BlueprintCard Class="pa-6" Style="height:100%;">
                        <div class="d-flex justify-space-between align-center">
                            <span class="koc-stat-value" style="font-size:32px;">@($"{i + 1:00}")</span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@t.Level</MudChip>
                        </div>
                        <MudText Typo="Typo.h6" HtmlTag="h3" Class="koc-heading mt-3 mb-2">@t.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@t.Summary</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@L["{0} lessons", t.LessonCount]</MudChip>
                    </BlueprintCard>
                </MudItem>
            }
        </MudGrid>
    </section>
}

@if (_rollup is not null)
{
    <!-- 6 · Management pulse: live org KPIs for the supervisor's scope. -->
    <section class="mb-6">
        <div class="d-flex align-center justify-space-between mb-2">
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="koc-heading">@L["Organization pulse"] · @_rollup.ScopeLabel</MudText>
            <MudLink Href="/dashboard" Typo="Typo.body2">@L["Full dashboard"] →</MudLink>
        </div>
        <MudGrid Spacing="4">
            <MudItem xs="6" md="2">
                <BlueprintCard Class="pa-4">
                    <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" /><MudText Typo="Typo.overline">@L["People"]</MudText></div>
                    <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.MemberCount</MudText>
                </BlueprintCard>
            </MudItem>
            <MudItem xs="6" md="2">
                <BlueprintCard Class="pa-4">
                    <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" /><MudText Typo="Typo.overline">@L["Learning"]</MudText></div>
                    <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.ActiveLearners</MudText>
                </BlueprintCard>
            </MudItem>
            <MudItem xs="6" md="2">
                <BlueprintCard Class="pa-4">
                    <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Primary" /><MudText Typo="Typo.overline">@L["Tracks done"]</MudText></div>
                    <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.TracksCompleted</MudText>
                </BlueprintCard>
            </MudItem>
            <MudItem xs="6" md="2">
                <BlueprintCard Class="pa-4">
                    <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" /><MudText Typo="Typo.overline">@L["Competing"]</MudText></div>
                    <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.CompetitionsEntered</MudText>
                </BlueprintCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <BlueprintCard Class="pa-4" Style="height:100%;">
                    @{
                        var done = _rollup.Members.Count(m => m.TracksCompleted > 0);
                        var doing = _rollup.Members.Count(m => m.TracksCompleted == 0 && m.Enrollments > 0);
                        var idle = Math.Max(0, _rollup.MemberCount - done - doing);
                    }
                    @KocCharts.Donut(
                        [new KocCharts.Seg(L["Completed a track"], done, "var(--koc-accent-700)"),
                         new KocCharts.Seg(L["Learning now"], doing, "var(--koc-accent-300)"),
                         new KocCharts.Seg(L["Not started"], idle, "#dbe4ec")],
                        _rollup.MemberCount.ToString(), L["learning status"])
                </BlueprintCard>
            </MudItem>
        </MudGrid>
    </section>
}

@code {
    private enum RoleView { Employee, TeamLeader, Manager, DCEO, CEO }

    // The hero copy follows whoever you're signed in as (guests see the Employee framing).
    private RoleView _role => Identity.Current.Key switch
    {
        "teamleader" => RoleView.TeamLeader,
        "manager" or "platformadmin" => RoleView.Manager,
        "dceo" => RoleView.DCEO,
        "ceo" => RoleView.CEO,
        _ => RoleView.Employee,
    };

    private IReadOnlyList<CompetitionDto>? _activeCompetitions;

    /// <summary>
    /// The area chosen on the top bar, carried in the address so a filtered page can be sent to somebody.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryFilter { get; set; }

    /// <summary>
    /// What the page actually shows. Filtering here rather than in the query keeps one fetch behind both
    /// views, so switching areas is instant and a stale filter can never empty the page permanently —
    /// clearing it brings everything straight back.
    /// </summary>
    private IReadOnlyList<CompetitionDto>? Competitions =>
        _activeCompetitions is null || CategoryFilter is not { Length: > 0 } code
            ? _activeCompetitions
            : _activeCompetitions
                .Where(c => string.Equals(c.CategoryCode, code, StringComparison.OrdinalIgnoreCase))
                .ToList();

    /// <summary>
    /// The chosen area's own name, for the banner. Read from the category list rather than from a
    /// competition, so an area with nothing running in it is still named properly instead of showing
    /// its code — which is exactly the case where the banner matters most.
    /// </summary>
    private string? FilterName => CategoryFilter is { Length: > 0 } code
        ? _categories?.FirstOrDefault(c => string.Equals(c.Code, code, StringComparison.OrdinalIgnoreCase))?.Name ?? code
        : null;

    private IReadOnlyList<CompetitionCategoryDto>? _categories;
    private PublicShowcaseDto? _showcase;      // signed-out landing preview (competitions + leaderboards)
    private ProfileDto? _myProfile;
    private SupervisionRollupDto? _rollup;
    private IReadOnlyList<TeamLeaderboardRowDto>? _teamBoard;
    private IReadOnlyList<XpLeaderboardRowDto>? _xpBoard;
    private IReadOnlyList<LeaderboardEntryDto>? _featuredBoard;
    private IReadOnlyList<Beep.KocAiCommunity.Contracts.Learning.TrackDto>? _liveTracks;

    protected override void OnInitialized() => Identity.Changed += OnChanged;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// The hero competition: the admin-pinned featured one if set, otherwise the active competition whose
    /// reveal is nearest (undated last, then newest).
    /// </summary>
    private CompetitionDto? Featured =>
        Competitions?.FirstOrDefault(c => c.IsFeatured)
        ?? (Competitions is { Count: > 0 } ? Competitions[0] : null);

    // ---- Headline figures ----

    // Counted off the filtered view, so the figures always describe what is on the screen.
    private int LiveCompetitionCount => Competitions?.Count ?? 0;
    private int TotalCompetitors => Competitions?.Sum(c => c.ParticipantCount) ?? 0;
    private int TotalSubmissions => Competitions?.Sum(c => c.SubmissionCount) ?? 0;

    // When the competition has an uploaded hero image, use it as the banner background under a dark gradient
    // that keeps the white text readable.
    private static string? HeroStyle(CompetitionDto c) => c.HeroImagePath is { } heroPath
        ? $"background-image: linear-gradient(120deg, rgba(11,46,76,.62), rgba(11,46,76,.28)), url('{heroPath}'); background-size: cover; background-position: center;"
        : null;

    private async Task LoadAsync()
    {
        await LoadCompetitionsAsync();
        await LoadProfileAsync();
        await LoadPulseAsync();
        // The catalogue is open to everyone, so a signed-out visitor sees the tracks too.
        try { _liveTracks = await Api.GetTracksAsync(); }
        catch { _liveTracks = []; }

        // Only used to name the area in the filter banner; failing quietly costs a label, nothing more.
        try { _categories = await Api.GetCompetitionCategoriesAsync(); }
        catch { _categories = null; }
    }

    // Leaderboards are for everyone (fun first); the KPI rollup only for supervisors with scope.
    private async Task LoadPulseAsync()
    {
        _rollup = null;
        _teamBoard = null;
        _xpBoard = null;
        // The boards are open to everyone now, so a visitor with no account fetches the same ones a
        // member does. Only the supervisor rollup below still depends on who is asking.

        // Caught separately: these are two independent boards, and one of them failing is no reason to
        // blank the other.
        try { _xpBoard = await Api.GetXpLeaderboardAsync("month"); }
        catch { _xpBoard = []; }

        try { _teamBoard = await Api.GetTeamLeaderboardAsync("month"); }
        catch { _teamBoard = []; }

        if (Identity.IsSupervisor)
        {
            try { _rollup = await Api.GetSupervisionRollupAsync(); }
            catch { _rollup = null; }
        }
    }

    // A guest has no profile pages to browse — and no id to browse them by, since the showcase withholds
    // it. Send them to sign in instead.
    private void OpenProfile(string userId)
    {
        if (Identity.IsGuest || string.IsNullOrEmpty(userId))
        {
            PrimaryCta();
            return;
        }

        Nav.NavigateTo($"/profile/{userId}");
    }

    private async Task LoadCompetitionsAsync()
    {
        if (Identity.IsGuest)
        {
            // Guests can't call the employee-gated endpoints, so use the curated public showcase to
            // populate the same sections. Names arrive already masked by the API.
            try
            {
                _showcase = await Api.GetPublicShowcaseAsync();
                _activeCompetitions = _showcase.Competitions;
                _featuredBoard = _showcase.FeaturedBoard;
            }
            catch
            {
                _showcase = null;
                _activeCompetitions = null;
                _featuredBoard = [];
            }

            return;
        }

        try
        {
            var all = await Api.GetCompetitionsAsync();
            _activeCompetitions = all.Where(c => c.Status == "active")
                .OrderBy(c => c.RevealUtc ?? DateTime.MaxValue)
                .ThenByDescending(c => c.ParticipantCount)          // liveliest race first when reveals tie
                .ThenByDescending(c => c.CreatedUtc ?? DateTime.MinValue)
                .ToList();

            _featuredBoard = null;
            if (Featured is { } featured)
            {
                // A full board, not a podium — this is the centrepiece of the page.
                try { _featuredBoard = (await Api.GetLeaderboardAsync(featured.Id)).Take(10).ToList(); }
                catch { _featuredBoard = []; }
            }
        }
        catch
        {
            _activeCompetitions = null;
            _featuredBoard = [];
        }
    }

    private async Task LoadProfileAsync()
    {
        if (Identity.IsGuest)
        {
            _myProfile = null;
            return;
        }

        try { _myProfile = await Api.GetMyProfileAsync(); }
        catch { _myProfile = null; }
    }

    // Local time-of-day greeting, with a warm Arabic variant for the KOC workplace.
    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => L["Good morning"],
        < 17 => L["Good afternoon"],
        _ => L["Good evening"],
    };

    private string GreetingArabic => DateTime.Now.Hour < 12 ? "صباح الخير" : "مساء الخير";

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Identity.Changed -= OnChanged;

    /// <summary>
    /// The one call to action on the page. Where this site holds the accounts it goes to the login page;
    /// where the persona switcher stands in for sign-in it picks one. It must never pretend: assuming a
    /// persona when real accounts are configured would render a signed-in UI with no cookie and no
    /// token, so every request behind it would fail.
    /// </summary>
    private void PrimaryCta()
    {
        if (SignInPrompt.Href(Setup) is { } loginPage)
        {
            Nav.NavigateTo(loginPage);
            return;
        }

        if (Setup.DemoPersonasEnabled && Identity.IsGuest)
        {
            Identity.SetPersona("employee");
        }

        Nav.NavigateTo("/dashboard");
    }

    /// <summary>
    /// Whether to show the "what is this, and is it for me?" material: the plain-words explainer, the
    /// three steps, and the starter challenge.
    /// <para>
    /// Shown to guests and to anyone who has signed in but not yet earned anything — the two states in
    /// which somebody genuinely does not know what this place is. A member with a single Barrel to their
    /// name has already been told, and being re-taught the basics every visit reads as being talked down
    /// to. Leaders and above get their own framing and never see it.
    /// </para>
    /// </summary>
    private bool ShowNewcomerGuide =>
        _role is RoleView.Employee && (Identity.IsGuest || _myProfile is null || _myProfile.XpTotal <= 0);

    /// <summary>The newcomer's first step is the entry track, not a dashboard with nothing on it yet.</summary>
    private void StartLearning() => Nav.NavigateTo("/learn");

    private sealed record RoleContent(string Headline, string Sub, string SecondaryCta);

    /// <summary>
    /// The hero copy, per role. Built on demand rather than held in a field: every string goes through
    /// the localizer, which is not available while fields are being initialized.
    /// </summary>
    private RoleContent Content => _role switch
    {
        RoleView.TeamLeader => new(
            L["Your team's AI & ML workspace."],
            L["Follow how your team is learning machine learning on KOC data — progress across tracks, competitions entered, and the projects they build."],
            L["View team activity"]),
        RoleView.Manager => new(
            L["Your department's AI & ML workspace."],
            L["See how machine-learning skills are building across your department on KOC data — who is learning, what teams are working on, and models coming into use."],
            L["View governance"]),
        RoleView.DCEO => new(
            L["Your directorate's AI & ML workspace."],
            L["See how machine-learning capability is building across your directorate — participation by group, use cases coming into production, and the governance behind them."],
            L["View governance"]),
        RoleView.CEO => new(
            L["KOC's AI & ML workspace."],
            L["A company-wide view of KOC's own machine-learning environment — participation across directorates, skills building on company data, and governance keeping it sovereign."],
            L["View governance"]),
        _ when ShowNewcomerGuide => new(
            L["You know the job. Teach a computer to help."],
            L["No experience needed, and nothing to install to begin. Learn what machine learning actually is in plain words, then try it on a real KOC problem — pumps, wells, production, safety, even the hospital lab."],
            L["Browse learning tracks"]),
        _ => new(
            L["Your AI & ML workspace."],
            L["Learn machine learning on real KOC subsurface, production, and facilities data — take a track, enter an internal competition, and share your work with colleagues."],
            L["Browse learning tracks"]),
    };
}
