@page "/"
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Contracts.Engagement
@using Beep.KocAiCommunity.Contracts.Supervision
@inject DevIdentity Identity
@inject IKocApiClient Api
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@KocBrand.ProductName</PageTitle>

@if (!Identity.IsGuest && Featured is { } featured)
{
    <!-- The arena leads: the featured competition with a live countdown and podium. -->
    <BlueprintCard Class="@($"koc-arena-banner pa-6 mb-6{(featured.HasHeroImage ? " koc-has-photo" : "")}")" Style="@HeroStyle(featured)">
        <div class="d-flex justify-space-between flex-wrap gap-5">
            <div style="min-width:280px;max-width:60ch;">
                <span class="koc-eyebrow">⚔ Featured competition</span>
                <MudText Typo="Typo.h4" Class="koc-heading" Style="color:#fff;">🏆 @featured.Title</MudText>
                <MudText Typo="Typo.body2" Class="mb-2" Style="opacity:.85;max-width:56ch;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                    @featured.Description
                </MudText>
                <div class="d-flex gap-4 align-center mb-3 flex-wrap">
                    <div><span class="koc-stat-value" style="font-size:24px;">@featured.ParticipantCount</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.85;">competitors</MudText></div>
                    <div><span class="koc-stat-value" style="font-size:24px;">@featured.SubmissionCount</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.85;">submissions</MudText></div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color:#fff;border-color:rgba(255,255,255,.4);">@CompetitionDisplay.MetricLabel(featured)</MudChip>
                </div>
                @if (!string.IsNullOrWhiteSpace(featured.FirstPrize) || !string.IsNullOrWhiteSpace(featured.SecondPrize) || !string.IsNullOrWhiteSpace(featured.ThirdPrize))
                {
                    <div class="d-flex gap-2 flex-wrap mb-2">
                        @if (!string.IsNullOrWhiteSpace(featured.FirstPrize))
                        {
                            <MudChip T="string" Size="Size.Small" Style="background:rgba(255,215,0,.2);color:#fff;border:1px solid rgba(255,215,0,.55);">🥇 @featured.FirstPrize</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(featured.SecondPrize))
                        {
                            <MudChip T="string" Size="Size.Small" Style="background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.4);">🥈 @featured.SecondPrize</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(featured.ThirdPrize))
                        {
                            <MudChip T="string" Size="Size.Small" Style="background:rgba(205,127,50,.24);color:#fff;border:1px solid rgba(205,127,50,.55);">🥉 @featured.ThirdPrize</MudChip>
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Class="d-block mb-3" Style="opacity:.85;">
                    🥇 Winner takes the <b>Gusher</b> badge · top 3 earn <b>@CompetitionRewards.PodiumBarrels bbl</b> + <b>On the Podium</b> · every scored entry @CompetitionRewards.ScoredSubmissionBarrels bbl
                </MudText>
                <MudButton Size="Size.Large" Variant="Variant.Filled" Class="koc-arena-cta" Style="background:#fff;color:var(--koc-accent-900);font-weight:700;"
                           StartIcon="@Icons.Material.Filled.EmojiEvents" Href="@($"/compete/{featured.Id}")">Enter the arena</MudButton>
            </div>
            <div class="d-flex flex-column gap-3" style="min-width:280px;">
                <CountdownTimer TargetUtc="featured.RevealUtc" />
                <PodiumBlock Entries="_featuredBoard" MyUserId="@Identity.UserId" Dense="true" />
            </div>
        </div>
    </BlueprintCard>
}

@if (!Identity.IsGuest && _myProfile is not null)
{
    <BlueprintCard Class="pa-5 mb-6" Style="border-color:var(--koc-accent-500);">
        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
            <div class="d-flex align-center gap-3">
                <XpRing AvatarIcon="@_myProfile.AvatarIcon" Level="@_myProfile.Level" LevelTitle="@_myProfile.LevelTitle"
                        XpTotal="@_myProfile.XpTotal" NextLevelXp="@_myProfile.NextLevelXp" Diameter="72" />
                <div>
                    <MudText Typo="Typo.h6" Class="koc-heading">@Greeting, @_myProfile.DisplayName</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.7;direction:rtl;">@GreetingArabic</MudText>
                    <div class="d-flex gap-4 mt-1">
                        <MudText Typo="Typo.body2"><b>🛢️ @_myProfile.XpTotal</b> Barrels</MudText>
                        <MudText Typo="Typo.body2"><b>🔥 @_myProfile.CurrentStreakDays</b> day streak</MudText>
                        <MudText Typo="Typo.body2"><b>Lvl @_myProfile.Level</b> @_myProfile.LevelTitle</MudText>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <MudButton Href="/profile" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EmojiEvents">My profile</MudButton>
                <MudButton Href="/learn" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.School">Keep learning</MudButton>
            </div>
        </div>
    </BlueprintCard>
}

@if (!Identity.IsGuest)
{
    <!-- Fun first: champions and live challenges — for everyone, before anything else. -->
    <div class="d-flex align-center justify-space-between mb-2">
        <span class="koc-eyebrow">🏆 This month's champions</span>
        <MudButton Href="/community" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">All leaderboards</MudButton>
    </div>
    <MudGrid Spacing="4" Class="mb-8">
        <MudItem xs="12" md="4">
            <BlueprintCard Class="pa-5" Style="height:100%;">
                <MudText Typo="Typo.subtitle2" Class="koc-heading mb-3">🏆 Top learners</MudText>
                @if (_xpBoard is null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_xpBoard.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="opacity:.7;">Earn the first Barrels of the month and this podium is yours.</MudText>
                }
                else
                {
                    @foreach (var p in _xpBoard.Take(5))
                    {
                        <div class="d-flex align-center gap-2 py-1" style="border-bottom:1px solid var(--koc-divider);cursor:pointer;@(p.IsMe ? "background:rgba(42,124,190,.08);" : "")"
                             @onclick="@(() => Nav.NavigateTo($"/profile/{p.UserId}"))">
                            <span style="width:28px;text-align:center;">@HomeMedal(p.Rank)</span>
                            <MudAvatar Size="Size.Small" Style="background:#fff;"><MudImage Src="@KocBrand.Icon(p.AvatarIcon)" /></MudAvatar>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2"><b>@p.DisplayName</b> @(p.IsMe ? "(you)" : "")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.65;">Lvl @p.Level · @p.LevelTitle</MudText>
                            </div>
                            <MudText Typo="Typo.body2"><b>🛢️ @p.XpTotal</b></MudText>
                        </div>
                    }
                }
            </BlueprintCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <BlueprintCard Class="pa-5" Style="height:100%;">
                <MudText Typo="Typo.subtitle2" Class="koc-heading mb-3">🛢️ Team standings</MudText>
                @if (_teamBoard is null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_teamBoard.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="opacity:.7;">Team standings appear once colleagues start earning Barrels.</MudText>
                }
                else
                {
                    @foreach (var t in _teamBoard.Take(5))
                    {
                        <div class="d-flex align-center gap-2 py-1" style="border-bottom:1px solid var(--koc-divider);@(t.IsMyTeam ? "background:rgba(42,124,190,.08);" : "")">
                            <span style="width:28px;text-align:center;">@HomeMedal(t.Rank)</span>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2"><b>@t.OrgUnitName</b> @(t.IsMyTeam ? "(your team)" : "")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.65;">@t.MemberCount people</MudText>
                            </div>
                            <MudText Typo="Typo.body2"><b>@t.AverageXp</b> avg</MudText>
                        </div>
                    }
                }
            </BlueprintCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <BlueprintCard Class="pa-5" Style="height:100%;border-color:var(--koc-accent-500);">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle2" Class="koc-heading">⚔️ Live challenges</MudText>
                    <MudLink Href="/compete" Typo="Typo.caption">Compete →</MudLink>
                </div>
                @if (_activeCompetitions is null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_activeCompetitions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="opacity:.7;">No live challenges right now — check back soon.</MudText>
                }
                else
                {
                    @foreach (var c in _activeCompetitions.Take(2))
                    {
                        <div class="mb-3">
                            <MudText Typo="Typo.body2" Class="koc-heading"><b>@c.Title</b></MudText>
                            <div class="d-flex gap-3 align-center" style="font-size:13px;">
                                <span><b>@c.ParticipantCount</b> competitors</span>
                                <span><b>@c.SubmissionCount</b> entries</span>
                                @if (c.RevealUtc is not null)
                                {
                                    <CountdownTimer TargetUtc="c.RevealUtc" Compact="true" RefreshSeconds="60" />
                                }
                            </div>
                            <MudButton Href="@($"/compete/{c.Id}")" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       StartIcon="@Icons.Material.Filled.EmojiEvents">Enter</MudButton>
                        </div>
                    }
                }
            </BlueprintCard>
        </MudItem>
    </MudGrid>
}

@if (Identity.IsSupervisor && _rollup is not null)
{
    <!-- Management pulse: live org KPIs + learning status for the supervisor's scope. -->
    <div class="d-flex align-center justify-space-between mb-2">
        <span class="koc-eyebrow">Organization pulse · @_rollup.ScopeLabel</span>
        <MudButton Href="/dashboard" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">Full dashboard</MudButton>
    </div>
    <MudGrid Spacing="4" Class="mb-6">
        <MudItem xs="6" md="2">
            <BlueprintCard Class="pa-4">
                <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" /><MudText Typo="Typo.overline">People</MudText></div>
                <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.MemberCount</MudText>
            </BlueprintCard>
        </MudItem>
        <MudItem xs="6" md="2">
            <BlueprintCard Class="pa-4">
                <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" /><MudText Typo="Typo.overline">Learning</MudText></div>
                <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.ActiveLearners</MudText>
            </BlueprintCard>
        </MudItem>
        <MudItem xs="6" md="2">
            <BlueprintCard Class="pa-4">
                <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Primary" /><MudText Typo="Typo.overline">Tracks done</MudText></div>
                <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.TracksCompleted</MudText>
            </BlueprintCard>
        </MudItem>
        <MudItem xs="6" md="2">
            <BlueprintCard Class="pa-4">
                <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" /><MudText Typo="Typo.overline">Competing</MudText></div>
                <MudText Typo="Typo.h4" Class="koc-stat-value">@_rollup.CompetitionsEntered</MudText>
            </BlueprintCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <BlueprintCard Class="pa-4" Style="height:100%;">
                @{
                    var done = _rollup.Members.Count(m => m.TracksCompleted > 0);
                    var doing = _rollup.Members.Count(m => m.TracksCompleted == 0 && m.Enrollments > 0);
                    var idle = Math.Max(0, _rollup.MemberCount - done - doing);
                }
                @KocCharts.Donut(
                    [new KocCharts.Seg("Completed a track", done, "var(--koc-accent-700)"),
                     new KocCharts.Seg("Learning now", doing, "var(--koc-accent-300)"),
                     new KocCharts.Seg("Not started", idle, "#dbe4ec")],
                    _rollup.MemberCount.ToString(), "learning status")
            </BlueprintCard>
        </MudItem>
    </MudGrid>
}

<!-- Hero -->
<MudGrid Class="mb-8" Spacing="6">
    <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
        <span class="koc-eyebrow mb-3">KOC internal · @(Identity.IsGuest ? "Guest preview" : Identity.Current.Label)</span>
        <MudText Typo="Typo.h3" Class="koc-heading mb-4">@Content.Headline</MudText>
        <MudText Typo="Typo.body1" Class="mb-6" Style="max-width:54ch;">@Content.Sub</MudText>
        <div class="d-flex gap-3 flex-wrap">
            @if (Identity.IsGuest)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login" OnClick="PrimaryCta">Sign in with KOC</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Dashboard" OnClick="PrimaryCta">Go to your workspace</MudButton>
            }
            <MudButton Href="/learn" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large">@Content.SecondaryCta</MudButton>
        </div>
        <MudText Typo="Typo.caption" Class="mt-6" Style="color:var(--koc-text);opacity:.7;">
            Single KOC tenant • Entra sign-in • Hosted in Kuwait • Audit retained 7 years
        </MudText>
    </MudItem>
    <MudItem xs="12" md="6">
        <BlueprintCard Class="koc-gridpaper pa-6" Style="min-height:260px;">
            <MudText Typo="Typo.overline" Class="mb-4">From well data to a working prediction</MudText>
            <div class="d-flex align-center gap-2 flex-wrap">
                @foreach (var (kind, label, i) in _flow.Select((f, i) => (f.kind, f.label, i)))
                {
                    <BlueprintCard Class="pa-2" Style="min-width:104px;background:var(--koc-bg);">
                        <div class="koc-eyebrow" style="font-size:10px;">@kind</div>
                        <div class="koc-heading" style="font-size:14px;">@label</div>
                    </BlueprintCard>
                    @if (i < _flow.Count - 1)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" />
                    }
                }
            </div>
            @if (!Identity.IsGuest)
            {
                <div class="d-flex gap-8 mt-6 flex-wrap">
                    <div><div class="koc-stat-value" style="font-size:30px;">@(_activeCompetitions?.Count ?? 0)</div><MudText Typo="Typo.caption">live challenge(s)</MudText></div>
                    <div><div class="koc-stat-value" style="font-size:30px;">@(_xpBoard?.Count ?? 0)</div><MudText Typo="Typo.caption">on the board this month</MudText></div>
                    @if (_xpBoard is { Count: > 0 })
                    {
                        <div><div class="koc-stat-value" style="font-size:30px;">🥇</div><MudText Typo="Typo.caption">@_xpBoard[0].DisplayName leads</MudText></div>
                    }
                </div>
            }
        </BlueprintCard>
    </MudItem>
</MudGrid>

<!-- What you can do -->
<span class="koc-eyebrow">01 · @Content.PillarKicker</span>
<MudDivider Class="mt-2 mb-6" />
<MudGrid Spacing="6" Class="mb-10">
    @foreach (var p in Content.Pillars)
    {
        <MudItem xs="12" md="4">
            <BlueprintCard Class="pa-6" Style="height:100%;">
                <MudIcon Icon="@p.Icon" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="koc-heading mt-4 mb-2">@p.Title</MudText>
                <MudText Typo="Typo.body2">@p.Body</MudText>
            </BlueprintCard>
        </MudItem>
    }
</MudGrid>

@if (!Identity.IsGuest && _activeCompetitions is { Count: > 0 })
{
    <div class="d-flex align-center justify-space-between mt-10">
        <span class="koc-eyebrow">02 · Live competitions</span>
        <MudLink Href="/compete">See all →</MudLink>
    </div>
    <MudDivider Class="mt-2 mb-6" />
    <MudGrid Spacing="6" Class="mb-10">
        @foreach (var c in _activeCompetitions.Take(3))
        {
            <MudItem xs="12" md="4">
                <CompetitionCard Competition="c" MyUserId="@Identity.UserId" />
            </MudItem>
        }
    </MudGrid>
}

@if (_liveTracks is { Count: > 0 })
{
    <!-- Live learning tracks straight from the catalog. -->
    <div class="d-flex align-center justify-space-between">
        <span class="koc-eyebrow">Learn &amp; grow</span>
        <MudLink Href="/learn" Typo="Typo.caption">All tracks →</MudLink>
    </div>
    <MudDivider Class="mt-2 mb-6" />
    <MudGrid Spacing="6">
        @foreach (var (t, i) in _liveTracks.Take(3).Select((x, i) => (x, i)))
        {
            <MudItem xs="12" md="4">
                <BlueprintCard Class="pa-6" Style="height:100%;">
                    <div class="d-flex justify-space-between align-center">
                        <span class="koc-stat-value" style="font-size:32px;">@($"{i + 1:00}")</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@t.Level</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="koc-heading mt-3 mb-2">@t.Title</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@t.Summary</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@t.LessonCount lessons</MudChip>
                </BlueprintCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private enum RoleView { Employee, TeamLeader, Manager, DCEO, CEO }

    // The landing content follows whoever you're signed in as (guests see the Employee preview).
    private RoleView _role => Identity.Current.Key switch
    {
        "teamleader" => RoleView.TeamLeader,
        "manager" or "platformadmin" => RoleView.Manager,
        "dceo" => RoleView.DCEO,
        "ceo" => RoleView.CEO,
        _ => RoleView.Employee,
    };

    private IReadOnlyList<CompetitionDto>? _activeCompetitions;
    private ProfileDto? _myProfile;

    protected override void OnInitialized() => Identity.Changed += OnChanged;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private SupervisionRollupDto? _rollup;
    private IReadOnlyList<TeamLeaderboardRowDto>? _teamBoard;
    private IReadOnlyList<XpLeaderboardRowDto>? _xpBoard;
    private IReadOnlyList<LeaderboardEntryDto>? _featuredBoard;

    /// <summary>
    /// The hero competition: the admin-pinned featured one if set, otherwise the active competition whose
    /// reveal is nearest (undated last, then newest).
    /// </summary>
    private CompetitionDto? Featured =>
        _activeCompetitions?.FirstOrDefault(c => c.IsFeatured)
        ?? (_activeCompetitions is { Count: > 0 } ? _activeCompetitions[0] : null);

    // When the competition has an uploaded hero image, use it as the banner background under a dark gradient
    // that keeps the white text readable.
    private static string? HeroStyle(CompetitionDto c) => c.HeroImagePath is { } heroPath
        ? $"background-image: linear-gradient(120deg, rgba(11,46,76,.62), rgba(11,46,76,.28)), url('{heroPath}'); background-size: cover; background-position: center;"
        : null;

    private async Task LoadAsync()
    {
        await LoadCompetitionsAsync();
        await LoadProfileAsync();
        await LoadPulseAsync();
        try { _liveTracks = Identity.IsGuest ? [] : await Api.GetTracksAsync(); }
        catch { _liveTracks = []; }
    }

    // Leaderboards are for everyone (fun first); the KPI rollup only for supervisors with scope.
    private async Task LoadPulseAsync()
    {
        _rollup = null;
        _teamBoard = null;
        _xpBoard = null;
        if (Identity.IsGuest)
        {
            return;
        }

        try
        {
            _xpBoard = await Api.GetXpLeaderboardAsync("month");
            _teamBoard = await Api.GetTeamLeaderboardAsync("month");
        }
        catch
        {
            _xpBoard = [];
            _teamBoard = [];
        }

        if (Identity.IsSupervisor)
        {
            try { _rollup = await Api.GetSupervisionRollupAsync(); }
            catch { _rollup = null; }
        }
    }

    private static string HomeMedal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}" };

    private async Task LoadCompetitionsAsync()
    {
        if (Identity.IsGuest)
        {
            _activeCompetitions = null;
            return;
        }

        try
        {
            var all = await Api.GetCompetitionsAsync();
            _activeCompetitions = all.Where(c => c.Status == "active")
                .OrderBy(c => c.RevealUtc ?? DateTime.MaxValue)
                .ThenByDescending(c => c.ParticipantCount)          // liveliest race first when reveals tie
                .ThenByDescending(c => c.CreatedUtc ?? DateTime.MinValue)
                .ToList();

            // Live top-3 podium for the featured hero only (cards run on the enriched DTO).
            _featuredBoard = null;
            if (Featured is { } featured)
            {
                try { _featuredBoard = (await Api.GetLeaderboardAsync(featured.Id)).Take(3).ToList(); }
                catch { _featuredBoard = []; }
            }
        }
        catch
        {
            _activeCompetitions = null;
        }
    }

    private async Task LoadProfileAsync()
    {
        if (Identity.IsGuest)
        {
            _myProfile = null;
            return;
        }

        try { _myProfile = await Api.GetMyProfileAsync(); }
        catch { _myProfile = null; }
    }

    // Local time-of-day greeting, with a warm Arabic variant for the KOC workplace.
    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening",
    };

    private string GreetingArabic => DateTime.Now.Hour < 12 ? "صباح الخير" : "مساء الخير";

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Identity.Changed -= OnChanged;

    private void PrimaryCta()
    {
        if (Identity.IsGuest)
        {
            Identity.SetPersona("employee");
        }

        Nav.NavigateTo("/dashboard");
    }

    private readonly List<(string kind, string label)> _flow =
    [
        ("Well data", "PI tags"),
        ("Tidy up", "Fill gaps"),
        ("Teach", "Learn patterns"),
        ("Predict", "Failure risk"),
    ];

    private IReadOnlyList<Beep.KocAiCommunity.Contracts.Learning.TrackDto>? _liveTracks;

    private sealed record Pillar(string Icon, string Title, string Body);
