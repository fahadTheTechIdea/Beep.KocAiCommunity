@page "/learn"
@page "/learn/{TrackId:guid}"
@using Beep.KocAiCommunity.Domain.Learning
@using Beep.KocAiCommunity.Contracts.Learning
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Markdig
@using Beep.KocAiCommunity.Contracts.Localization
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IKocApiClient Api
@inject DevIdentity Identity
@inject IStringLocalizer<Strings> L
@inject NavigationManager Nav

<PageTitle>@L["Learn"] · @KocBrand.ProductName</PageTitle>

<PageHeader Eyebrow="@L["Learn & compete"]" Title="@L["Learning tracks"]"
            Subtitle="@L["Guided tracks from your first look at data to a model your team can rely on. Enroll, work through the lessons, and watch your progress."]" />

@* The catalogue follows the interface language chosen in the app bar. There is no toggle of its own
   any more: two language controls on one page, one of which changed only that page, was a worse
   answer than one control that changes everything. *@
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
        @L["The learning catalogue couldn't be loaded ({0}).", _error]
    </MudAlert>
}
else if (_tracks is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_selected is null)
{
    @* Where you are in the catalogue, before the catalogue. A curriculum with no sense of how far
       through it you are is a list of files. *@
    <div class="koc-pulse mb-5">
        <div class="koc-pulse-stats">
            <div class="koc-pulse-stat">
                <span class="koc-pulse-value koc-stat-value">@_tracks.Count</span>
                <span class="koc-pulse-label">@L["tracks"]</span>
            </div>
            <div class="koc-pulse-stat">
                <span class="koc-pulse-value koc-stat-value">@_tracks.Sum(t => t.LessonCount)</span>
                <span class="koc-pulse-label">@L["lessons"]</span>
            </div>
            @if (!Identity.IsGuest)
            {
                <div class="koc-pulse-stat">
                    <span class="koc-pulse-value koc-stat-value">@_mine.Count</span>
                    @* "Enrolled" already exists and .resx names are case-insensitive, so this reuses it
                       rather than adding a lowercase twin that would collide. *@
                    <span class="koc-pulse-label">@L["Enrolled"]</span>
                </div>
                <div class="koc-pulse-stat">
                    <span class="koc-pulse-value koc-stat-value">@LessonsDone<span class="koc-pulse-of">/@LessonsEnrolled</span></span>
                    <span class="koc-pulse-label">@L["lessons complete"]</span>
                </div>
            }
        </div>
    </div>

    <div class="koc-learn-toolbar mb-2">
        <MudTextField T="string" Value="_search" ValueChanged="@(v => _search = v ?? "")" Immediate="true"
                      Placeholder="@L["Search tracks"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Class="koc-learn-search" />

        <div class="koc-period-row">
            @foreach (var level in LevelFilters)
            {
                <button type="button" class="@LevelClass(level)" @onclick="@(() => _levelFilter = level)">@LevelLabel(level)</button>
            }
        </div>
    </div>

    var shown = Filtered();
    <div class="koc-arena-count mb-4">
        @if (shown.Count == _tracks.Count)
        {
            @L["{0} tracks", _tracks.Count]
        }
        else
        {
            @L["{0} of {1} tracks", shown.Count, _tracks.Count]
        }
    </div>

    @if (shown.Count == 0)
    {
        <BlueprintCard Class="pa-8" Style="text-align:center;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["Nothing here yet"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@L["No track matches these filters. Widen them and something will turn up."]</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAltOff"
                       OnClick="@(() => { _search = ""; _levelFilter = "all"; })">@L["Clear filters"]</MudButton>
        </BlueprintCard>
    }

    @* Grouped by level, in order. A curriculum is a ladder and should be laid out as one — a single
       flat grid makes a beginner and an advanced track look like equivalent choices. *@
    @foreach (var group in shown.GroupBy(t => t.Level).OrderBy(g => LevelOrder(g.Key)))
    {
        <div class="koc-learn-rung">
            <span class="@($"koc-learn-rung-dot koc-learn-rung-dot--{LevelOrder(group.Key)}")"></span>
            <h2 class="koc-learn-rung-title">@group.Key</h2>
            <span class="koc-learn-rung-count">@L["{0} tracks", group.Count()]</span>
        </div>

        <MudGrid Spacing="6" Class="mb-8">
        @foreach (var track in group)
        {
            var progress = _mine.GetValueOrDefault(track.Id);
            var rtl = KocLanguages.IsRightToLeft(track.Language);
            <MudItem xs="12" md="4">
                <BlueprintCard Class="pa-6" Style="height:100%;display:flex;flex-direction:column;">
                    <div class="d-flex justify-space-between align-center">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@track.Level</MudChip>
                        <MudText Typo="Typo.caption">@L["{0} lessons", track.LessonCount]</MudText>
                    </div>
                    @* A catalogue that is only partly translated says so on the card rather than
                       quietly serving English under an Arabic heading. *@
                    @if (track.Language != _language)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                            @L["Only in {0}", KocLanguages.NativeName(track.Language)]
                        </MudText>
                    }
                    <MudText Typo="Typo.h6" Class="koc-heading mt-3 mb-2" dir="@(rtl ? "rtl" : "ltr")">@track.Title</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" dir="@(rtl ? "rtl" : "ltr")">@track.Summary</MudText>

                    @if (progress is not null)
                    {
                        <MudProgressLinear Color="Color.Primary" Value="@Percent(progress)" Class="my-2" />
                        <MudText Typo="Typo.caption" Class="mb-2">
                            @L["{0} / {1} complete", progress.CompletedLessons, progress.TotalLessons]
                            @if (progress.Status == "completed")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["Completed"]</MudChip>
                            }
                        </MudText>
                    }

                    @if (track.RecommendedCompetitionTitle is { Length: > 0 } competitionTitle)
                    {
                        @* Where the track leads. Set by an admin in the catalogue console. *@
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-2">
                            @L["Put it to work in"]
                            <MudLink Href="@($"/compete/{track.RecommendedCompetitionId}")"><b>@competitionTitle</b></MudLink>
                        </MudAlert>
                    }

                    <div class="mt-auto d-flex gap-2 align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenTrack(track.Id)">@L["Open"]</MudButton>
                        @* Enrolling records progress against a person, so it appears once there is one —
                           silently, with no prompt. Reading the material is never gated or nagged. *@
                        @if (!Identity.IsGuest && progress is null)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => Enroll(track.Id)">@L["Enroll"]</MudButton>
                        }
                    </div>
                </BlueprintCard>
            </MudItem>
        }
        </MudGrid>
    }
}
else
{
    @* The track replaces the catalogue rather than appearing under it. It used to render below every
       card on the page, so "Open" moved nothing on screen and left you to scroll for what you had just
       asked for. It has its own URL now, which is what makes the browser's back button work and a
       lesson shareable with a colleague. *@
    var selectedRtl = KocLanguages.IsRightToLeft(_selected.Language);
    var progress = _mine.GetValueOrDefault(_selected.Id);

    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/learn" Class="mb-3"
               StartIcon="@Icons.Material.Filled.ArrowBack">@L["All tracks"]</MudButton>

    <div class="koc-track-head mb-5">
        <div class="koc-track-head-ink" dir="@(selectedRtl ? "rtl" : "ltr")">
            <span class="koc-eyebrow">@_selected.Level · @L["{0} lessons", _selected.Lessons.Count]</span>
            <h1 class="koc-hero-title">@_selected.Title</h1>
            <MudText Typo="Typo.body2" Class="koc-track-summary">@_selected.Summary</MudText>
        </div>

        @if (progress is not null)
        {
            <div class="koc-track-progress">
                <MudProgressLinear Color="Color.Primary" Value="@Percent(progress)" Class="mb-1" />
                <span class="koc-pulse-label">@L["{0} / {1} complete", progress.CompletedLessons, progress.TotalLessons]</span>

                @* Offered only once the track is actually finished. The endpoint refuses otherwise, so
                   showing the link earlier would be a button that leads to a shrug. *@
                @if (progress.Status == TrackEnrollmentStatus.Completed)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-1"
                               Href="@($"/learn/{_selected.Id}/certificate")"
                               StartIcon="@Icons.Material.Filled.WorkspacePremium">@L["Certificate"]</MudButton>
                }
                else if (progress.Status == TrackEnrollmentStatus.AwaitingQuiz)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["One step left — pass the quiz to finish."]</MudText>
                }
            </div>
        }
        else if (!Identity.IsGuest)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Enroll(_selected.Id))">@L["Enroll"]</MudButton>
        }
    </div>

        @if (OtherTranslations(_selected) is { Count: > 0 } others)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4">
                @L["Also available in"]
                @foreach (var other in others)
                {
                    <MudLink Class="mx-1" @onclick="() => OpenTrack(other.Value)" Style="cursor:pointer;">
                        <b>@KocLanguages.NativeName(other.Key)</b>
                    </MudLink>
                }
            </MudAlert>
        }

        <div dir="@(selectedRtl ? "rtl" : "ltr")">
        <MudExpansionPanels MultiExpansion="true">
            @foreach (var lesson in _selected.Lessons)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <div class="d-flex align-center justify-space-between" style="width:100%;">
                            <span><b>@lesson.OrderNo.</b> @lesson.Title <MudText Typo="Typo.caption" Class="d-inline">(~@lesson.EstimatedMinutes min)</MudText></span>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(lesson.Content))
                        {
                            <div class="koc-lesson">@Md(lesson.Content)</div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@L["Content coming soon."]</MudText>
                        }
                        @if (!Identity.IsGuest)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                                       OnClick="() => Complete(_selected.Id, lesson.Id)">@L["Mark complete"]</MudButton>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        </div>

        @* The quiz sits after the lessons, because that is where it belongs in the reading. It says
           plainly whether it is required, and shows the best result so far rather than only offering to
           start — somebody returning to a track wants to know where they got to. *@
        @if (_quiz is not null)
        {
            <BlueprintCard Class="pa-6 mt-6 koc-quiz-card">
                <div class="koc-quiz-card-ink">
                    <span class="koc-eyebrow">@(_quiz.IsMandatory ? L["Required to finish this track"] : L["Optional self-check"])</span>
                    <MudText Typo="Typo.h6" Class="koc-heading">@L["End-of-track quiz"]</MudText>

                    @if (!string.IsNullOrWhiteSpace(_quiz.Intro))
                    {
                        <MudText Typo="Typo.body2" Class="mb-1">@_quiz.Intro</MudText>
                    }

                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @L["{0} questions · {1}% to pass", _quiz.Questions.Count, _quiz.PassMark]
                        @if (_quiz.AttemptCount > 0)
                        {
                            <text> · </text>@L["best {0}% over {1} attempts", _quiz.BestScorePercent ?? 0, _quiz.AttemptCount]
                        }
                    </MudText>
                </div>

                <div class="koc-quiz-card-action">
                    @if (_quiz.HasPassed)
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">@L["Passed"]</MudChip>
                    }

                    @if (Identity.IsGuest)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Sign in to take the quiz."]</MudText>
                    }
                    else
                    {
                        <MudButton Variant="@(_quiz.HasPassed ? Variant.Outlined : Variant.Filled)" Color="Color.Primary"
                                   Href="@($"/learn/{_selected.Id}/quiz")" EndIcon="@Icons.Material.Filled.ArrowForward">
                            @(_quiz.AttemptCount == 0 ? L["Take the quiz"] : _quiz.HasPassed ? L["Review or retake"] : L["Try again"])
                        </MudButton>
                    }
                </div>
            </BlueprintCard>
        }
    }
}

@code {
    private IReadOnlyList<TrackDto>? _tracks;
    private Dictionary<Guid, MyLearningDto> _mine = [];
    private TrackDetailDto? _selected;
    private QuizDto? _quiz;
    private string? _error;
    /// <summary>
    /// The interface language, which is also the catalogue language asked of the API. A track with no
    /// translation still comes back in the language it was written in, marked as such on the card.
    /// </summary>
    private string _language = KocLanguages.English;

    private static readonly MarkdownPipeline _md = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private static MarkupString Md(string markdown) => (MarkupString)Markdown.ToHtml(markdown, _md);

    private string _search = "";
    private string _levelFilter = "all";

    /// <summary>The levels actually present in the catalogue, so a filter never offers an empty result.</summary>
    private IReadOnlyList<string> LevelFilters =>
        ["all", .. (_tracks ?? []).Select(t => t.Level).Distinct().OrderBy(LevelOrder)];

    private int LessonsDone => _mine.Values.Sum(p => p.CompletedLessons);
    private int LessonsEnrolled => _mine.Values.Sum(p => p.TotalLessons);

    /// <summary>
    /// Beginner before advanced, whatever order the API returned them in. Anything unrecognised sorts
    /// last rather than being dropped — a new level should appear at the bottom, not vanish.
    /// </summary>
    private static int LevelOrder(string level) => level.ToLowerInvariant() switch
    {
        "beginner" or "foundation" or "intro" => 1,
        "intermediate" => 2,
        "advanced" or "expert" => 3,
        _ => 4,
    };

    private string LevelLabel(string level) => level == "all" ? L["All levels"] : level;

    private string LevelClass(string level) =>
        _levelFilter == level ? "koc-period koc-period--on" : "koc-period";

    private List<TrackDto> Filtered() =>
        [.. (_tracks ?? [])
            .Where(t => _levelFilter == "all" || t.Level == _levelFilter)
            .Where(t => string.IsNullOrWhiteSpace(_search)
                     || t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || t.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase))];

    [Parameter] public Guid? TrackId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _language = KocLanguages.Normalize(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
        await LoadAsync();
    }

    /// <summary>
    /// The URL decides which track is open, not a click. That is what makes the back button work, and
    /// what lets somebody paste a track to a colleague. Runs on every navigation, including back and
    /// forward, so the fetch is skipped when the right track is already loaded.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (TrackId is null)
        {
            _selected = null;
            return;
        }

        if (_selected?.Id != TrackId)
        {
            _selected = await Api.GetTrackAsync(TrackId.Value);

            // Most tracks have no quiz, and the client returns null for those rather than throwing —
            // a track without one is not an error.
            _quiz = await Api.GetTrackQuizAsync(TrackId.Value);
        }
    }

    private async Task LoadAsync()
    {
        // The catalogue is public; a guest simply has no progress of their own to overlay on it. Asking
        // for it anyway is what produced a 401 reported as "the API is down".
        try
        {
            _error = null;
            _tracks = await Api.GetTracksAsync(_language);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            return;
        }

        if (Identity.IsGuest)
        {
            _mine = [];
            return;
        }

        try
        {
            var mine = await Api.GetMyLearningAsync();
            _mine = mine.ToDictionary(m => m.TrackId);
        }
        catch
        {
            // Progress is an overlay on the catalogue, not a precondition for showing it.
            _mine = [];
        }
    }

    // Navigate rather than assign: OnParametersSetAsync does the loading, so opening a track from a
    // card, from a translation link, or from a pasted URL all take exactly the same path.
    private void OpenTrack(Guid trackId) => Nav.NavigateTo($"/learn/{trackId}");

    /// <summary>The same material in every language except the one being read.</summary>
    private static IReadOnlyList<KeyValuePair<string, Guid>> OtherTranslations(TrackDetailDto track) =>
        [.. (track.Translations ?? new Dictionary<string, Guid>())
            .Where(t => !string.Equals(t.Key, track.Language, StringComparison.OrdinalIgnoreCase))];

    private async Task Enroll(Guid trackId)
    {
        await Api.EnrollAsync(trackId);
        await LoadAsync();
    }

    private async Task Complete(Guid trackId, Guid lessonId)
    {
        await Api.CompleteLessonAsync(trackId, lessonId);
        await LoadAsync();
        _selected = await Api.GetTrackAsync(trackId);
    }

    private static int Percent(MyLearningDto p) =>
        p.TotalLessons == 0 ? 0 : (int)Math.Round(100.0 * p.CompletedLessons / p.TotalLessons);
}
