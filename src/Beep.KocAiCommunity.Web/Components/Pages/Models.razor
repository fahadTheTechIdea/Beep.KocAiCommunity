@page "/models"
@using Beep.KocAiCommunity.Contracts.Studio
@using Beep.KocAiCommunity.Web.Services
@using Beep.KocAiCommunity.Web.Components.Dialogs
@using Beep.KocAiCommunity.Ui.Shared.Components
@inject IKocApiClient Api
@inject IDialogService DialogService
@inject DevIdentity Identity
@inject ISnackbar Snackbar

<PageTitle>Models · @KocBrand.ProductName</PageTitle>

<PageHeader Eyebrow="Studio · registry" Title="Model registry"
            Subtitle="Register a trained model, get it reviewed, and promote it with two approvals — then deploy it, or roll back in one click. Every version keeps its metric and source run.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRegister">Register model</MudButton>
    </Actions>
</PageHeader>

<MudTextField @bind-Value="Identity.UserId" Label="Acting as (dev user)" Variant="Variant.Outlined" Margin="Margin.Dense"
              HelperText="Approvals must come from two different people — switch to approve as someone else." Class="mb-4" Style="max-width:340px;" />

<MudGrid Spacing="6">
    <MudItem xs="12">
        @if (_models is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_models.Count == 0)
        {
            <BlueprintCard Class="pa-8" Style="text-align:center;">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="koc-heading mb-1">No models registered yet</MudText>
                <MudText Typo="Typo.body2">Train a model in <b>AutoML</b>, then register it with the button above.</MudText>
            </BlueprintCard>
        }
        else
        {
            @foreach (var m in _models)
            {
                <BlueprintCard Class="pa-4 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="koc-heading mb-2">@m.Name</MudText>
                    @foreach (var v in m.Versions)
                    {
                        <div class="d-flex align-center justify-space-between py-1" style="border-top:1px solid var(--koc-divider);">
                            <div>
                                <b>@v.SemVer</b>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor(v.Status)">@v.Status</MudChip>
                                <MudText Typo="Typo.caption" Class="d-inline">@v.MetricValue.ToString("0.###") @v.MetricName · @v.Approvals/2 approvals</MudText>
                            </div>
                            <div class="d-flex gap-1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Approve(v.Id)">Approve</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@(v.Approvals < 2 || v.Status == "production")" OnClick="() => Promote(v.Id)">Promote</MudButton>
                                @if (v.Status == "production")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="() => Deploy(v.Id)">Deploy</MudButton>
                                }
                                @if (v.Status == "archived")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Rollback(v.Id)">Roll back</MudButton>
                                }
                            </div>
                        </div>
                    }
                </BlueprintCard>
            }
        }

        <BlueprintCard Class="pa-4 mt-2">
            <MudText Typo="Typo.subtitle1" Class="koc-heading mb-2">Deployments</MudText>
            @if (_deployments.Count == 0)
            {
                <MudText Typo="Typo.body2">No deployments yet. Promote a version to production, then deploy it.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead><tr><th>Model</th><th>Version</th><th>Env</th><th>Status</th><th>Deployed</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in _deployments)
                        {
                            <tr>
                                <td>@d.ModelName</td>
                                <td>@d.SemVer</td>
                                <td>@d.Environment</td>
                                <td><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(d.Status == "active" ? Color.Success : Color.Default)">@d.Status</MudChip></td>
                                <td>@d.DeployedUtc.ToLocalTime().ToString("g")</td>
                                <td style="text-align:right;">
                                    @if (d.Status == "active")
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Retire(d.Id)">Retire</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </BlueprintCard>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<RegisteredModelDto>? _models;
    private IReadOnlyList<DeploymentDto> _deployments = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _models = await Api.GetModelsAsync();
            _deployments = await Api.GetDeploymentsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenRegister()
    {
        var dialog = await DialogService.ShowAsync<RegisterModelDialog>("Register a model");
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task Approve(Guid v) => await Act(() => Api.ApproveVersionAsync(v), "Approved.");
    private async Task Promote(Guid v) => await Act(() => Api.PromoteVersionAsync(v), "Promoted to production.");
    private async Task Rollback(Guid v) => await Act(() => Api.RollbackVersionAsync(v), "Rolled back.");
    private async Task Deploy(Guid v) => await Act(() => Api.DeployVersionAsync(v), "Deployed to production.");
    private async Task Retire(Guid d) => await Act(() => Api.RetireDeploymentAsync(d), "Deployment retired.");

    private async Task Act(Func<Task<string?>> action, string ok)
    {
        var error = await action();
        if (error is null)
        {
            Snackbar.Add(ok, Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Warning);
        }

        await LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "production" => Color.Success,
        "archived" => Color.Default,
        _ => Color.Info,
    };
}
