@page "/compete/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Contracts.Workflow
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Strings> L
@using Beep.KocAiCommunity.Ui.Shared.Components
@implements IAsyncDisposable
@inject IKocApiClient Api
@inject Beep.KocAiCommunity.Web.Services.HeroImageStorage HeroImages
@inject DevIdentity Identity
@inject RealtimeOptions Realtime
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_competition?.Title ?? L["Competition"].Value) · @KocBrand.ProductName</PageTitle>

@if (_notFound)
{
    <BlueprintCard Class="pa-8" Style="text-align:center;">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
        <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["Competition not found"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@L["It may have been removed, or the link is out of date."]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/compete">@L["Back to the arena"]</MudButton>
    </BlueprintCard>
}
else if (_competition is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <!-- Arena banner -->
    <BlueprintCard Class="@($"koc-arena-banner pa-6 mb-4{(_competition.HasHeroImage ? " koc-has-photo" : "")}")" Style="@BannerStyle()">
        <MudLink Href="/compete" Style="color:#cfe4f5;font-size:13px;">← @L["All competitions"]</MudLink>
        <div class="d-flex justify-space-between align-end flex-wrap gap-4 mt-2">
            <div style="min-width:280px;max-width:62ch;">
                <span class="koc-eyebrow">⚔ @L["Competition"]</span>
                <MudText Typo="Typo.h4" Class="koc-heading" Style="color:#fff;">🏆 @_competition.Title</MudText>
                <MudText Typo="Typo.caption" Style="opacity:.85;">@L["Hosted by {0}", _competition.HostName]</MudText>
                <div class="d-flex gap-1 flex-wrap mt-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@CompetitionDisplay.StatusColor(_competition.Status)">@L[CompetitionDisplay.StatusLabel(_competition.Status)]</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color:#fff;border-color:rgba(255,255,255,.4);">@L[CompetitionDisplay.TaskLabel(_competition.TaskType)]</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color:#fff;border-color:rgba(255,255,255,.4);">@CompetitionDisplay.MetricLabel(_competition, L)</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color:#fff;border-color:rgba(255,255,255,.4);" Icon="@Icons.Material.Filled.Visibility">@L[CompetitionDisplay.ScopeLabel(_competition.Scope)]</MudChip>
                </div>
                <div class="d-flex gap-5 mt-3">
                    <div><span class="koc-stat-value" style="font-size:26px;">@_competition.ParticipantCount</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.8;">@L["competitors"]</MudText></div>
                    <div><span class="koc-stat-value" style="font-size:26px;">@_competition.SubmissionCount</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.8;">@L["submissions"]</MudText></div>
                    <div><span class="koc-stat-value" style="font-size:26px;">@_competition.QuotaPerDay</span> <MudText Typo="Typo.caption" Class="d-inline" Style="opacity:.8;">@L["entries/day"]</MudText></div>
                </div>
            </div>
            <div class="d-flex flex-column gap-2" style="min-width:270px;">
                <CountdownTimer TargetUtc="_competition.RevealUtc" />
                @if (CompetitionDisplay.RevealProgress(_competition, DateTime.UtcNow) is { } progress)
                {
                    <div class="koc-deadline-bar" title="@L["Progress toward the final reveal"]"><span style="width:@(((int)(progress * 100)))%"></span></div>
                }

                @* The two things a competitor does from a browser. The button that used to sit here
                   opened the node editor, which is a desktop app now — so these are the site's job:
                   take the data away, bring a score back. *@
                @if (_competition.Status != "concluded")
                {
                    @if (_competition.HasDatasets)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => ShowTab(TabData))">
                            @L["Get the data"]
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Size="Size.Large" FullWidth="true" Style="color:#e8f1f8;border-color:#e8f1f8;"
                               StartIcon="@Icons.Material.Filled.UploadFile" OnClick="@(() => ShowTab(TabSubmissions))">
                        @L["Submit your predictions"]
                    </MudButton>
                    <MudText Typo="Typo.caption" Style="opacity:.8;color:#e8f1f8;">
                        @L["Build your model however you like — KOC Studio on the desktop, or your own tools. Only your predictions come back here."]
                    </MudText>
                }
            </div>
        </div>
    </BlueprintCard>

    <BlueprintCard Class="pa-0">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" ActivePanelIndex="_initialTab">
            <!-- 1 · Overview -->
            <MudTabPanel Text="@L["Overview"]" Icon="@Icons.Material.Filled.Description" Class="pa-5">
                <MudText Typo="Typo.body1" Class="mb-4" Style="white-space:pre-wrap;max-width:80ch;">@_competition.Description</MudText>

                @if (_competition.RecommendedTrackId is not null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4">
                        @L["New to this?"] <MudLink Href="/learn">@L["Start with the recommended learning track"] →</MudLink>
                    </MudAlert>
                }

                <MudText Typo="Typo.subtitle1" Class="koc-heading mb-2">@L["How it works"]</MudText>
                <MudGrid Spacing="3" Class="mb-4">
                    <MudItem xs="12" md="4">
                        <BlueprintCard Class="pa-4" Style="height:100%;">
                            <span class="koc-stat-value" style="font-size:26px;">1</span>
                            <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Get the data"]</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.75;">@L["Download the labelled training set and the evaluation set from the Data tab."]</MudText>
                        </BlueprintCard>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BlueprintCard Class="pa-4" Style="height:100%;">
                            <span class="koc-stat-value" style="font-size:26px;">2</span>
                            <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Build your model"]</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.75;">@L["Use KOC Studio on the desktop, or any tool you prefer — the leaderboard only sees your predictions."]</MudText>
                        </BlueprintCard>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BlueprintCard Class="pa-4" Style="height:100%;">
                            <span class="koc-stat-value" style="font-size:26px;">3</span>
                            <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Submit & climb"]</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.75;">@L["Scored on a hidden answer key shared by everyone — only modelling moves your rank."]</MudText>
                        </BlueprintCard>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle1" Class="koc-heading mb-2">@L["What you can win"]</MudText>
                <MudGrid Spacing="3" Class="mb-4">
                    <MudItem xs="12" md="4">
                        <BlueprintCard Class="pa-4" Style="height:100%;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <img src="@KocBrand.Icon("039-oil-well.png")" alt="" width="34" height="34" />
                                <MudText Typo="Typo.subtitle2" Class="koc-heading">🥇 @L["Winner"]</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Style="opacity:.8;">@L["The {0} gold badge + {1} bbl.", CompetitionRewards.WinnerBadge, CompetitionRewards.PodiumBarrels]</MudText>
                        </BlueprintCard>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BlueprintCard Class="pa-4" Style="height:100%;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <img src="@KocBrand.Icon("100-goal.png")" alt="" width="34" height="34" />
                                <MudText Typo="Typo.subtitle2" Class="koc-heading">🏅 @L["Top 3"]</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Style="opacity:.8;">@L["The {0} badge + {1} bbl on conclusion.", CompetitionRewards.PodiumBadge, CompetitionRewards.PodiumBarrels]</MudText>
                        </BlueprintCard>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BlueprintCard Class="pa-4" Style="height:100%;">
                            <div class="d-flex align-center gap-2 mb-1">
                                <img src="@KocBrand.Icon("179-exploration.png")" alt="" width="34" height="34" />
                                <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Every entry"]</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Style="opacity:.8;">@L["{0} bbl per scored submission; your first ever earns the {1} badge (+{2} bbl).", CompetitionRewards.ScoredSubmissionBarrels, CompetitionRewards.FirstSubmissionBadge, CompetitionRewards.FirstSubmissionBonusBarrels]</MudText>
                        </BlueprintCard>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">@L["Evaluation"]</MudText>
                <MudText Typo="Typo.body2" Style="max-width:75ch;" Class="mb-1">
                    @L["Scored with {0} against a hidden answer key — only modelling moves your rank.", CompetitionDisplay.MetricLabel(_competition, L)]
                    @(_competition.RevealUtc is null
                        ? L["The live leaderboard reflects your best score."]
                        : L["The live leaderboard shows public scores; final private standings unlock on reveal day so no one can game the last hours."])
                </MudText>
                <MudText Typo="Typo.caption" Style="opacity:.75;">@L[CompetitionTaskCatalog.Find(_competition.TaskType).MetricPlain]</MudText>
            </MudTabPanel>

            <!-- 2 · Data -->
            <MudTabPanel Text="@L["Data"]" Icon="@Icons.Material.Filled.Dataset" Class="pa-5">
                @if (_competition.HasDatasets)
                {
                    <MudGrid Spacing="3" Class="mb-3">
                        @if (_trainingCsv is not null)
                        {
                            <MudItem xs="12" md="6">
                                <BlueprintCard Class="pa-4">
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" />
                                        <MudText Typo="Typo.subtitle2" Class="koc-heading">training.csv</MudText>
                                    </div>
                                    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.7;">@L["{0} rows", RowCount(_trainingCsv)] · <code>@_competition.IdColumn, features…, @_competition.LabelColumn</code></MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                               Href="@DataUri(_trainingCsv)" download="training.csv">@L["Download"]</MudButton>
                                </BlueprintCard>
                            </MudItem>
                        }
                        @if (_evalCsv is not null)
                        {
                            <MudItem xs="12" md="6">
                                <BlueprintCard Class="pa-4">
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Quiz" Color="Color.Primary" />
                                        <MudText Typo="Typo.subtitle2" Class="koc-heading">evaluation.csv</MudText>
                                    </div>
                                    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.7;">@L["{0} rows", RowCount(_evalCsv)] · <code>@_competition.IdColumn, features…</code> — @L["you predict"] <code>@_competition.LabelColumn</code></MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                               Href="@DataUri(_evalCsv)" download="evaluation.csv">@L["Download"]</MudButton>
                                </BlueprintCard>
                            </MudItem>
                        }
                    </MudGrid>
                    @if (_evalCsv is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload"
                                   Href="@DataUri(BuildSampleSubmission())" download="sample_submission.csv">@L["Download a sample submission file"]</MudButton>
                    }
                    <MudText Typo="Typo.caption" Class="d-block mt-1" Style="opacity:.7;">
                        @L["KOC Studio reads these files directly — download them only if you want to explore them yourself."]
                    </MudText>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                        @L["No data files attached yet — this challenge currently accepts uploaded prediction files only."]
                        @(_competition.CanManage ? L["Attach the files in the Host tab."] : "")
                    </MudAlert>
                }
            </MudTabPanel>

            <!-- 3 · Leaderboard -->
            <MudTabPanel Text="@L["Leaderboard"]" Icon="@Icons.Material.Filled.Leaderboard" Class="pa-0">
                <div class="pa-5 pb-3">
                    <PodiumBlock Entries="_leaderboard" MyUserId="@Identity.UserId" />
                </div>

                @{
                    var concluded = _competition.Status == "concluded";
                    var revealPending = _competition.RevealUtc is { } rv && rv > DateTime.UtcNow;
                }
                <div class="pa-4 pb-2 d-flex align-center flex-wrap gap-2">
                    <MudIcon Icon="@(concluded ? Icons.Material.Filled.MilitaryTech : Icons.Material.Filled.Leaderboard)" />
                    <MudText Typo="Typo.subtitle1" Class="koc-heading">@(concluded ? L["Final standings"] : L["Live leaderboard"])</MudText>
                    @if (revealPending)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.Lock">
                            @L["Final standings revealed {0}", _competition.RevealUtc!.Value.ToLocalTime().ToString("g")]
                        </MudChip>
                    }
                </div>

                @* Where you stand — the board can be long, so say it plainly instead of making the user hunt. *@
                @if (_leaderboard is { Count: > 0 })
                {
                    var mine = _leaderboard.FirstOrDefault(e => e.UserId == Identity.UserId);
                    <div class="px-4 pb-3">
                        @if (mine is not null)
                        {
                            var leader = _leaderboard[0];
                            var gap = Math.Abs(leader.Score - mine.Score);
                            <MudAlert Severity="@(mine.Rank == 1 ? Severity.Success : Severity.Info)" Variant="Variant.Text" Dense="true">
                                <b>@L["You're #{0} of {1}", mine.Rank, _leaderboard.Count]</b> · @L["best {0}", mine.Score.ToString("0.###")]
                                @(mine.Rank == 1
                                    ? L[" — you're leading the board."]
                                    : L[" · {0} {1} the leader ({2}).", gap.ToString("0.###"), _competition.HigherIsBetter ? L["behind"] : L["off"], leader.Score.ToString("0.###")])
                            </MudAlert>
                        }
                        else if (_competition.Status != "concluded")
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true">
                                @L["You're not on the board yet — {0} competitor(s) ahead of you.", _leaderboard.Count]
                                @L["Build your model in KOC Studio on the desktop, then submit your predictions below."]
                            </MudAlert>
                        }
                    </div>
                }

                <LiveBoard Entries="_leaderboard" MyUserId="@Identity.UserId" BoardKey="live" />
            </MudTabPanel>

            <!-- 4 · My submissions -->
            <MudTabPanel Text="@L["My submissions"]" Icon="@Icons.Material.Filled.UploadFile" Class="pa-5">
                @if (_competition.Status == "concluded")
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-3">@L["Submissions are closed — this challenge has concluded."]</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Class="koc-heading mb-1">@L["Submit a prediction"]</MudText>
                    @* The one line of format guidance a competitor gets, so it speaks THIS task's
                       language — "predict the number" for regression, "a score, higher = more
                       anomalous" for AUC — instead of saying id,label to everyone. *@
                    <MudText Typo="Typo.caption" Class="mb-1 d-block" Style="opacity:.75;">
                        <code>@_competition.IdColumn, @_competition.LabelColumn</code> — @L[CompetitionTaskCatalog.Find(_competition.TaskType).SubmissionHint]
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mb-2 d-block" Style="opacity:.75;">@L["Scored instantly against the hidden answer key."]</MudText>
                    @if (_evalCsv is not null)
                    {
                        <div class="mb-2">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload"
                                       Href="@DataUri(BuildSampleSubmission())" download="sample_submission.csv">@L["Download a sample submission file"]</MudButton>
                        </div>
                    }
                    <InputFile OnChange="OnPredictionSelected" accept=".csv" />
                    @if (_competition.MyQuotaRemainingToday is { } quotaLeft)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1" Style="opacity:.7;">
                            @L["{0} of {1} submissions left today — the quota resets at midnight UTC.", quotaLeft, _competition.QuotaPerDay]
                        </MudText>
                    }
                    @if (_lastScore is not null)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="mt-2">
                            @L["Scored: {0} (+{1} bbl) — your best result counts on the leaderboard.", _lastScore.Value.ToString("0.###"), CompetitionRewards.ScoredSubmissionBarrels]
                        </MudAlert>
                    }
                }

                @if (_mySubmissions is { Count: > 0 })
                {
                    <MudText Typo="Typo.subtitle2" Class="koc-heading mt-4 mb-1">@L["History"]</MudText>
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>@L["When"]</th><th>@L["Status"]</th><th style="text-align:end;">@L["Score"]</th></tr></thead>
                        <tbody>
                            @foreach (var sub in _mySubmissions)
                            {
                                <tr>
                                    <td>@sub.SubmittedUtc.ToLocalTime().ToString("g")</td>
                                    <td>@sub.Status</td>
                                    <td style="text-align:right;">@(sub.Score?.ToString("0.###") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else if (_competition.Status != "concluded")
                {
                    <MudText Typo="Typo.body2" Class="mt-4" Style="opacity:.7;">@L["No submissions yet — your first upload puts you on the board."]</MudText>
                }
            </MudTabPanel>

            @if (_competition.CanManage)
            {
                <!-- 5 · Host — the one editor. The launcher only names a competition; it is finished
                     here, and ONLY here: every field this console owns appears on no other surface. -->
                <MudTabPanel Text="@L["Host"]" Icon="@Icons.Material.Filled.Tune" Class="pa-5">
                    @* The readiness checklist, wired to the same rule the Activate button enforces. *@
                    <div class="d-flex align-center gap-2 mb-4 flex-wrap">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(HasBrief ? Color.Success : Color.Default)"
                                 Icon="@(HasBrief ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)">@L["Brief"]</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_competition.HasDatasets ? Color.Success : Color.Default)"
                                 Icon="@(_competition.HasDatasets ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)">@L["Data"]</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_competition.HasAnswerKey ? Color.Success : Color.Default)"
                                 Icon="@(_competition.HasAnswerKey ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)">@L["Answer key"]</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@CompetitionDisplay.StatusColor(_competition.Status)">@L[CompetitionDisplay.StatusLabel(_competition.Status)]</MudChip>
                    </div>

                    @* ---- The words, every language side by side, one save. English is the record
                         itself — the fallback everyone sees; each other language is an optional
                         overlay. For a long time the Arabic was editable here and the English was
                         frozen at creation, which is how typos became permanent. *@
                    <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">@L["About this challenge"]</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-3" Style="opacity:.75;">
                        @L["What competitors read. Leave the Arabic blank and Arabic readers simply see the English — nothing breaks."]
                    </MudText>
                    <MudGrid Spacing="3" Class="mb-1">
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_titleEn" Label="@L["Competition title"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                            <MudTextField @bind-Value="_descriptionEn" Label="@L["Overview — what competitors predict and why it matters"]"
                                          Variant="Variant.Outlined" Lines="6" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_titleAr" Label="@L["Competition title (العربية)"]" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Class="mb-2" Style="direction:rtl;" />
                            <MudTextField @bind-Value="_descriptionAr" Label="@L["Overview (العربية)"]" Variant="Variant.Outlined"
                                          Lines="6" Style="direction:rtl;" />
                        </MudItem>
                    </MudGrid>

                    @* ---- Audience & rules save with the words: one request, one button. *@
                    <div class="d-flex gap-3 flex-wrap align-center mb-3">
                        <MudSelect T="string" @bind-Value="_scope" Label="@L["Who can compete"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="max-width:220px;" Disabled="@(_competition.Status != "draft")">
                            @foreach (var scope in AllowedScopes)
                            {
                                <MudSelectItem Value="@scope">@L[ScopeChoiceLabel(scope)]</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="int" @bind-Value="_quota" Label="@L["Submissions per day"]" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="1" Max="25" Style="max-width:170px;" />
                        @if (_competition.Status != "draft")
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.7;max-width:34ch;">
                                @L["The audience is frozen once a competition activates — changing it live would change who can see submissions already made."]
                            </MudText>
                        }
                    </div>
                    <div class="d-flex align-center gap-3 mb-6">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_savingAbout"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAboutAsync">@L["Save — all languages"]</MudButton>
                        @if (_aboutSaved)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success">@L["Saved"]</MudText>
                        }
                    </div>

                    <MudDivider Class="my-4" />

                    @* ---- Where it belongs and what it pays. *@
                    <MudGrid Spacing="4" Class="mb-2">
                        <MudItem xs="12" md="5">
                            <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">@L["Domain"]</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.75;">
                                @L["Which part of KOC this challenge belongs to — the area filters across the site run on it."]
                            </MudText>
                            <MudSelect T="string" Value="_categoryCode" ValueChanged="OnCategoryChanged" Label="@L["Domain"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:280px;">
                                @foreach (var category in _categories)
                                {
                                    <MudSelectItem T="string" Value="@category.Code">@category.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="7">
                            <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">🏆 @L["Prizes"]</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.75;">
                                @L["Free text, shown on the banner and cards. Blank clears — the standard Barrels and badges are awarded either way."]
                            </MudText>
                            <div class="d-flex gap-2 flex-wrap align-center">
                                <MudTextField @bind-Value="_firstPrize" Label="🥇" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px;" />
                                <MudTextField @bind-Value="_secondPrize" Label="🥈" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px;" />
                                <MudTextField @bind-Value="_thirdPrize" Label="🥉" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px;" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SavePrizesAsync">@L["Save prizes"]</MudButton>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    @* ---- Task & data. The metric was chosen at creation and is read-only here: changing
                         it under a live leaderboard would reorder everyone. The task may still move, but
                         only within the metric's family — the select simply has no other options. *@
                    <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">@L["Task & scoring"]</MudText>
                    <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">@CompetitionDisplay.MetricLabel(_competition, L)</MudChip>
                        <MudText Typo="Typo.caption" Style="opacity:.75;">@L[CompetitionTaskCatalog.Find(_dsTask).MetricPlain]</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Class="d-block mb-3" Style="opacity:.75;">
                        @L["Competitors download the training data, build a model, and are scored on the evaluation set against your hidden answer key."]
                    </MudText>
                    <div class="d-flex gap-3 flex-wrap mb-3">
                        <MudTextField @bind-Value="_dsLabel" Label="@L["Label column"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px;" />
                        <MudTextField @bind-Value="_dsId" Label="@L["Id column"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px;" />
                        <MudSelect @bind-Value="_dsTask" Label="@L["Task"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px;">
                            @foreach (var option in TaskChoices)
                            {
                                <MudSelectItem Value="@option.Key">@L[option.Label]</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    @* The three files, sketched for the CURRENT task — moved here from the old create
                       dialog, next to the uploads they describe. *@
                    <MudExpansionPanels Elevation="0" Class="mb-3">
                        <MudExpansionPanel Dense="true">
                            <TitleContent>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                    <MudText Typo="Typo.body2"><b>@L["The three files you'll prepare"]</b></MudText>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                @{ var sample = CompetitionTaskCatalog.Find(_dsTask); }
                                @FilePreview("training.csv", L["labelled — competitors download this"], sample.TrainingSample)
                                @FilePreview("evaluation.csv", L["no label — competitors predict for these rows"], sample.EvalSample)
                                @FilePreview("answer-key.csv", L["hidden — only the platform sees it, used to score"], sample.KeySample)
                            </ChildContent>
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Training data"]</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-1" Style="opacity:.7;"><code>id, features…, label</code> — @L["public to competitors."]</MudText>
                            <InputFile OnChange="OnTrainingSelected" accept=".csv" />
                            @if (_dsTraining is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="mt-1">@L["ready"]</MudChip>
                            }
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Evaluation set"]</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-1" Style="opacity:.7;"><code>id, features…</code> — @L["no label; what they predict."]</MudText>
                            <InputFile OnChange="OnEvalSelected" accept=".csv" />
                            @if (_dsEval is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="mt-1">@L["ready"]</MudChip>
                            }
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.subtitle2" Class="koc-heading">@L["Hidden answer key"]</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-1" Style="opacity:.7;"><code>id, label</code> — @L["kept Restricted; never exposed."]</MudText>
                            <InputFile OnChange="OnKeySelected" accept=".csv" />
                        </MudItem>
                    </MudGrid>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="UploadDatasets" Disabled="_dsTraining is null || _dsEval is null">@L["Publish training + evaluation data"]</MudButton>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">@L["Hero image"]</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.75;">@L["A banner for this competition — and the landing-page hero if it's featured. PNG or JPG (max 5 MB)."]</MudText>
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <InputFile OnChange="OnHeroImageSelected" accept="image/*" />
                        @if (_competition.HeroImagePath is { } heroPath)
                        {
                            <img src="@($"{heroPath}?v={_heroVersion}")" alt="hero image" style="height:56px;border-radius:6px;border:1px solid var(--koc-border);" />
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["image set"]</MudChip>
                        }
                    </div>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">@L["Timeline"]</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.75;">@L["Until the reveal, the final private standings stay concealed so no one games the last day. Times are your local time."]</MudText>
                    <div class="d-flex gap-2 align-center flex-wrap">
                        <MudDatePicker @bind-Date="_revealDate" Label="@L["Reveal date"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px;" />
                        <MudTimePicker @bind-Time="_revealTime" Label="@L["Time"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px;" />
                        <MudSwitch T="bool" @bind-Value="_concludeAtReveal" Color="Color.Primary" Label="@L["Conclude automatically at reveal"]" />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SetReveal" Disabled="_revealDate is null">@L["Set reveal"]</MudButton>
                        @if (_competition.RevealUtc is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Event">@_competition.RevealUtc.Value.ToLocalTime().ToString("g")</MudChip>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearReveal">@L["Clear"]</MudButton>
                        }
                    </div>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.subtitle1" Class="koc-heading mb-2">@L["Lifecycle"]</MudText>
                    <div class="d-flex align-center gap-1 mb-3">
                        @foreach (var (stage, index) in new[] { "draft", "active", "concluded" }.Select((x, i) => (x, i)))
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Variant="@(_competition.Status == stage ? Variant.Filled : Variant.Text)"
                                     Color="@(_competition.Status == stage ? CompetitionDisplay.StatusColor(stage) : Color.Default)">@L[CompetitionDisplay.StatusLabel(stage)]</MudChip>
                            @if (index < 2)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="opacity:.4;" />
                            }
                        }
                    </div>
                    <div class="d-flex gap-2 flex-wrap align-center">
                        @if (_competition.Status != "active")
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.RocketLaunch"
                                       Disabled="@(!_competition.HasAnswerKey)"
                                       OnClick='() => SetStatus("active")'>@L["Activate — open submissions"]</MudButton>
                            @if (!_competition.HasAnswerKey)
                            {
                                <MudText Typo="Typo.caption" Style="opacity:.75;">
                                    @L["Upload the hidden answer key first — without it no submission can be scored."]
                                </MudText>
                            }
                        }
                        @if (_competition.Status != "concluded")
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.SportsScore"
                                       OnClick='() => SetStatus("concluded")'>@L["Conclude — close submissions"]</MudButton>
                        }
                        @if (_competition.Status != "draft")
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick='() => SetStatus("draft")'>@L["Back to draft"]</MudButton>
                        }
                    </div>
                </MudTabPanel>
            }
        </MudTabs>
    </BlueprintCard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private CompetitionDto? _competition;
    private bool _notFound;
    private Guid _loadedId;
    // The tab order, named once. Two places move the tabs — the ?tab= query and the hero buttons — and
    // bare 1/3 in both is how they end up disagreeing after somebody inserts a panel.
    private const int TabOverview = 0;
    private const int TabData = 1;
    private const int TabLeaderboard = 2;
    private const int TabSubmissions = 3;
    private const int TabHost = 4;

    private int _initialTab;

    /// <summary>
    /// Moves the tabs from the hero. Set directly rather than by navigating to <c>?tab=</c>: the query
    /// is only read in <c>OnInitializedAsync</c>, so changing it on a page already open would update
    /// the address bar and nothing else.
    /// </summary>
    private void ShowTab(int index) => _initialTab = index;

    private IReadOnlyList<LeaderboardEntryDto>? _leaderboard;
    private IReadOnlyList<SubmissionResultDto>? _mySubmissions;
    private double? _lastScore;

    private string? _trainingCsv;
    private string? _evalCsv;

    private string _dsLabel = "label";
    private string _dsId = "id";
    private string _dsTask = "BinaryClassification";
    private MemoryStream? _dsTraining;
    private MemoryStream? _dsEval;
    private int _heroVersion = 1;
    private DateTime? _revealDate;
    private TimeSpan? _revealTime;
    private bool _concludeAtReveal;

    // The console's editable copy of the record — initialised from the competition on load, written
    // back by SaveAboutAsync. _titleEn/_descriptionEn come from the translations read (the "en" row),
    // never from the competition DTO, which arrives already translated for whoever is reading.
    private string _titleEn = "";
    private string _descriptionEn = "";
    private int _quota = 5;
    private string _scope = "Company";
    private string? _categoryCode;
    private string _firstPrize = "";
    private string _secondPrize = "";
    private string _thirdPrize = "";
    private bool _savingAbout;
    private bool _aboutSaved;
    private IReadOnlyList<CompetitionCategoryDto> _categories = [];

    /// <summary>The launcher's cap on audience width, for the scope select's options.</summary>
    private string? _maxScope;

    private static readonly string[] ScopeRank = ["Team", "Group", "Directorate", "Company"];

    private IEnumerable<string> AllowedScopes =>
        ScopeRank.Where(scope => _maxScope is null || Array.IndexOf(ScopeRank, scope) <= Array.IndexOf(ScopeRank, _maxScope));

    private static string ScopeChoiceLabel(string scope) => scope switch
    {
        "Company" => "All of KOC",
        "Directorate" => "My directorate",
        "Group" => "My group",
        _ => "My team",
    };

    /// <summary>Declared for the localization coverage test — computed keys the markup scan cannot see.</summary>
    public static readonly string[] TranslatableScopeChoices = ["All of KOC", "My directorate", "My group", "My team"];

    /// <summary>A brief exists once the description says anything at all.</summary>
    private bool HasBrief => !string.IsNullOrWhiteSpace(_descriptionEn);

    /// <summary>The tasks the Task select may offer: the scorer's own family, nothing else.</summary>
    private IReadOnlyList<CompetitionTaskOption> TaskChoices =>
        CompetitionTaskCatalog.ForScorer(_competition?.ScorerCode);

    /// <summary>Who is asking, when anyone at all may be asking. Null outside an auth-aware render.</summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string _titleAr = "";
    private string _descriptionAr = "";

    private HubConnection? _hub;
    private Guid? _joinedCompetition;

    // My workflow targeting this competition (null until I join), and the in-flight join.

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _maxScope = (await Api.GetMeAsync())?.MaxCompetitionScope;
        }
        catch
        {
            _maxScope = null;
        }

        _initialTab = Tab?.ToLowerInvariant() switch
        {
            "data" => TabData,
            "leaderboard" => TabLeaderboard,
            "submissions" => TabSubmissions,
            "host" => TabHost,
            _ => TabOverview,
        };

        await ConnectAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId)
        {
            return;
        }

        _loadedId = Id;
        await LoadAllAsync();
        await JoinCompetitionGroupAsync(Id);
    }

    private async Task LoadAllAsync()
    {
        _notFound = false;
        _competition = null;
        _lastScore = null;
        _trainingCsv = _evalCsv = null;
        _dsTraining = _dsEval = null;

        _competition = await Api.GetCompetitionAsync(Id);
        if (_competition is null)
        {
            _notFound = true;
            return;
        }

        var revealLocal = _competition.RevealUtc?.ToLocalTime();
        _revealDate = revealLocal?.Date;
        _revealTime = revealLocal?.TimeOfDay;
        _concludeAtReveal = _competition.ConcludeAtReveal;

        // The console edits what is actually stored, so its fields start from the record — the old tab
        // reset the task to BinaryClassification on every load, and a host re-uploading data silently
        // rewrote the competition's task with it.
        _dsLabel = _competition.LabelColumn;
        _dsId = _competition.IdColumn;
        _dsTask = _competition.TaskType;
        _quota = _competition.QuotaPerDay > 0 ? _competition.QuotaPerDay : 5;
        _scope = _competition.Scope;
        _categoryCode = _competition.CategoryCode;
        _firstPrize = _competition.FirstPrize ?? "";
        _secondPrize = _competition.SecondPrize ?? "";
        _thirdPrize = _competition.ThirdPrize ?? "";

        if (_competition.CanManage && _categories.Count == 0)
        {
            try { _categories = await Api.GetCompetitionCategoriesAsync(); }
            catch { _categories = []; }
        }

        await LoadLeaderboard();
        await LoadMySubmissions();
        await LoadData();
        await LoadTranslations();
    }

    private async Task LoadLeaderboard()
    {
        _leaderboard = await Api.GetLeaderboardAsync(Id);
    }

    /// <summary>
    /// "My submissions" needs a "me". Anyone may read a competition — the arena is how people decide
    /// whether to join — so an anonymous visitor reaches here routinely, and asking the API for their
    /// submissions returns 401 and takes the whole page down with it. Nobody signed in simply has none.
    /// </summary>
    private async Task LoadMySubmissions()
    {
        if (AuthState is null || !(await AuthState).User.Identity!.IsAuthenticated)
        {
            _mySubmissions = null;
            return;
        }

        _mySubmissions = await Api.GetMySubmissionsAsync(Id);
    }

    /// <summary>
    /// Reads the Arabic as written, for the editor. The competition on screen has already been
    /// translated for whoever is reading it, so echoing that back into these boxes would show an Arabic
    /// reader their own translation as if it were the English, and an English reader nothing at all.
    /// </summary>
    private async Task LoadTranslations()
    {
        if (_competition is null)
        {
            return;
        }

        try
        {
            var translations = await Api.GetCompetitionTranslationsAsync(Id);
            var english = translations.FirstOrDefault(t => t.Language == "en");
            var arabic = translations.FirstOrDefault(t => t.Language == "ar");
            _titleEn = english?.Title ?? _competition.Title;
            _descriptionEn = english?.Description ?? _competition.Description;
            _titleAr = arabic?.Title ?? "";
            _descriptionAr = arabic?.Description ?? "";
        }
        catch
        {
            // A competitor opening the page cannot read these; that is not an error worth showing.
            _titleEn = _competition.Title;
            _descriptionEn = _competition.Description;
            _titleAr = _descriptionAr = "";
        }
    }

    /// <summary>
    /// One save for everything written: the English (the record itself), each other language's overlay,
    /// the quota, and — while it is a draft — the audience. Two stores, one button; a host should not
    /// have to know which words live in which table.
    /// </summary>
    private async Task SaveAboutAsync()
    {
        _savingAbout = true;
        _aboutSaved = false;
        try
        {
            await Api.UpdateCompetitionAsync(Id, new UpdateCompetitionRequest(
                _titleEn, _descriptionEn, _quota,
                _competition?.Status == "draft" ? _scope : null));

            var error = await Api.SetCompetitionTranslationAsync(Id, new SetCompetitionTranslationRequest("ar", _titleAr, _descriptionAr));
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _aboutSaved = true;
            Snackbar.Add(L["Saved — all languages."], Severity.Success);

            // Re-read the competition: the banner around the console should now say what was just written.
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingAbout = false;
        }
    }

    private async Task OnCategoryChanged(string? code)
    {
        _categoryCode = string.IsNullOrWhiteSpace(code) ? null : code;
        try
        {
            await Api.SetOwnCompetitionCategoryAsync(Id, _categoryCode);
            Snackbar.Add(L["Domain saved."], Severity.Success);
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SavePrizesAsync()
    {
        try
        {
            await Api.SetCompetitionPrizesAsync(Id, new SetPrizesRequest(_firstPrize, _secondPrize, _thirdPrize));
            Snackbar.Add(L["Prizes saved."], Severity.Success);
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadData()
    {
        if (_competition is not { HasDatasets: true })
        {
            return;
        }

        try
        {
            _trainingCsv = await Api.GetCompetitionDataAsync(Id, "training");
            _evalCsv = await Api.GetCompetitionDataAsync(Id, "evaluation");
        }
        catch
        {
            // The Data tab degrades to its empty state; a rejected download must not take the whole
            // page down with it.
            _trainingCsv = _evalCsv = null;
        }
    }

    /// <summary>Re-fetch the competition (enriched stats included) after a host action or live update.</summary>
    private async Task ReloadCompetitionAsync()
    {
        _competition = await Api.GetCompetitionAsync(Id) ?? _competition;
        _revealDate = _competition?.RevealUtc?.ToLocalTime();
        await LoadLeaderboard();
    }

    // ---- Realtime: join this competition's leaderboard group; re-join after reconnects ----

    private async Task ConnectAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder().WithUrl(Realtime.HubUrl).WithAutomaticReconnect().Build();
            _hub.On<string>("leaderboard.updated", async _ =>
            {
                await ReloadCompetitionAsync();
                await InvokeAsync(StateHasChanged);
            });
            _hub.Reconnected += async _ =>
            {
                if (_joinedCompetition is { } id)
                {
                    try
                    {
                        await _hub.SendAsync("JoinCompetition", id.ToString());
                    }
                    catch { /* best effort */ }
                }
            };
            await _hub.StartAsync();
            if (_joinedCompetition is null && Id != Guid.Empty)
            {
                await JoinCompetitionGroupAsync(Id);
            }
        }
        catch
        {
            // Live board is best-effort; the page still works with manual refreshes.
        }
    }

    private async Task JoinCompetitionGroupAsync(Guid competitionId)
    {
        if (_hub is null || _hub.State != HubConnectionState.Connected || _joinedCompetition == competitionId)
        {
            return;
        }

        try
        {
            if (_joinedCompetition is { } prev)
            {
                await _hub.SendAsync("LeaveCompetition", prev.ToString());
            }

            await _hub.SendAsync("JoinCompetition", competitionId.ToString());
            _joinedCompetition = competitionId;
        }
        catch { /* best effort */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }

    // ---- Submissions ----

    private async Task OnPredictionSelected(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = await ReadAsync(e.File);
            var result = await Api.SubmitAsync(Id, ms, e.File.Name);
            _lastScore = result?.Score;
            await ReloadCompetitionAsync();
            await LoadMySubmissions();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Submission failed: {0}", ex.Message], Severity.Error);
        }
    }

    // ---- Host actions ----

    private async Task SetStatus(string status)
    {
        try
        {
            await Api.SetCompetitionStatusAsync(Id, status);
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Status change failed: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task SetReveal()
    {
        if (_revealDate is null)
        {
            return;
        }

        try
        {
            // One conversion, spelled out: the picked wall-clock (defaulting to noon, never a silent
            // midnight) is local time, converted to UTC here and nowhere else.
            var local = _revealDate.Value.Date + (_revealTime ?? TimeSpan.FromHours(12));
            await Api.SetCompetitionRevealAsync(Id, DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime(), _concludeAtReveal);
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Reveal update failed: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task ClearReveal()
    {
        try
        {
            await Api.SetCompetitionRevealAsync(Id, null);
            _revealDate = null;
            _revealTime = null;
            _concludeAtReveal = false;
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Reveal update failed: {0}", ex.Message], Severity.Error);
        }
    }

    private void OnTrainingSelected(InputFileChangeEventArgs e) => _ = CaptureAsync(e, s => _dsTraining = s);

    private void OnEvalSelected(InputFileChangeEventArgs e) => _ = CaptureAsync(e, s => _dsEval = s);

    private async Task CaptureAsync(InputFileChangeEventArgs e, Action<MemoryStream> assign)
    {
        assign(await ReadAsync(e.File));
        StateHasChanged();
    }

    private async Task UploadDatasets()
    {
        if (_dsTraining is null || _dsEval is null)
        {
            return;
        }

        try
        {
            _dsTraining.Position = 0;
            _dsEval.Position = 0;
            await Api.SetCompetitionDatasetsAsync(Id, _dsTraining, _dsEval, _dsLabel, _dsId, _dsTask);
            Snackbar.Add(L["Competition data uploaded."], Severity.Success);
            await ReloadCompetitionAsync();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Upload failed: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task OnKeySelected(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = await ReadAsync(e.File);
            await Api.SetAnswerKeyAsync(Id, ms, e.File.Name);
            Snackbar.Add(L["Answer key set."], Severity.Success);
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Upload failed: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task OnHeroImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var path = await HeroImages.SaveAsync(Id, e.File);
            await Api.SetCompetitionHeroImagePathAsync(Id, path);
            _heroVersion++; // bust the browser cache so the new image shows immediately
            Snackbar.Add(L["Hero image uploaded."], Severity.Success);
            await ReloadCompetitionAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Upload failed: {0}", ex.Message], Severity.Error);
        }
    }

    // ---- Helpers ----

    // When the competition has an uploaded hero image, paint it behind the arena banner under a dark
    // gradient that keeps the white heading/stats readable. _heroVersion busts the cache after a re-upload.
    private string? BannerStyle() => _competition?.HeroImagePath is { } heroPath
        ? $"background-image: linear-gradient(120deg, rgba(11,46,76,.64), rgba(11,46,76,.30)), url('{heroPath}?v={_heroVersion}'); background-size: cover; background-position: center;"
        : null;

    /// <summary>
    /// A ready-to-edit submission file: every evaluation id, the label header, and a placeholder value
    /// per row — the fastest possible answer to "what exactly do I upload?".
    /// </summary>
    private string BuildSampleSubmission()
    {
        var option = CompetitionTaskCatalog.Find(_competition?.TaskType);
        var sb = new System.Text.StringBuilder($"{_competition?.IdColumn ?? "id"},{_competition?.LabelColumn ?? "label"}\n");
        foreach (var line in (_evalCsv ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Skip(1))
        {
            var id = line.Split(',')[0].Trim();
            if (id.Length > 0)
            {
                sb.Append($"{id},{option.SampleValue}\n");
            }
        }

        return sb.ToString();
    }

    private RenderFragment FilePreview(string title, string sub, string csv) => __builder =>
    {
        <div class="mb-2">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption"><b>@title</b> — <span style="opacity:.7;">@sub</span></MudText>
            </div>
            <pre style="background:var(--koc-bg);border:1px solid var(--koc-divider);border-radius:6px;padding:8px 10px;margin:4px 0 0;overflow-x:auto;font-size:12px;line-height:1.5;">@csv</pre>
        </div>
    };

    private static string DataUri(string csv) =>
        $"data:text/csv;charset=utf-8;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv))}";

    private static int RowCount(string csv) =>
        Math.Max(0, csv.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length - 1);

    private static async Task<MemoryStream> ReadAsync(IBrowserFile file)
    {
        var ms = new MemoryStream();
        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        await stream.CopyToAsync(ms);
        ms.Position = 0;
        return ms;
    }
}
