@page "/admin"
@using Beep.KocAiCommunity.Contracts.Admin
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Ui.Shared.Components
@inject IKocApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Admin · @KocBrand.ProductName</PageTitle>

<PageHeader Eyebrow="Platform" Title="Admin console"
            Subtitle="Live platform health, typed settings (secrets encrypted), feature flags, and the audit trail. Requires the PlatformAdmin role." />

@if (_forbidden)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">You need the <b>PlatformAdmin</b> role to view this console.</MudAlert>
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pt-2">
        <MudTabPanel Text="Dashboard" Icon="@Icons.Material.Filled.Dashboard">
            @if (_dashboard is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <MudGrid Spacing="4" Class="mb-4">
                    @foreach (var kpi in Kpis(_dashboard))
                    {
                        <MudItem xs="6" md="2">
                            <BlueprintCard Class="pa-4" Style="text-align:center;">
                                <MudText Typo="Typo.h4" Class="koc-heading">@kpi.Value</MudText>
                                <MudText Typo="Typo.caption">@kpi.Label</MudText>
                            </BlueprintCard>
                        </MudItem>
                    }
                </MudGrid>

                <MudGrid Spacing="6">
                    <MudItem xs="12" md="5">
                        <MudText Typo="Typo.h6" Class="koc-heading mb-2">Health</MudText>
                        @foreach (var h in _dashboard.Health)
                        {
                            <BlueprintCard Class="pa-3 mb-2">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <div><b>@h.Component</b> <MudText Typo="Typo.caption" Class="d-block" Style="opacity:.7;">@h.Detail</MudText></div>
                                </div>
                            </BlueprintCard>
                        }
                    </MudItem>
                    <MudItem xs="12" md="7">
                        <MudText Typo="Typo.h6" Class="koc-heading mb-2">Recent activity</MudText>
                        <AuditTable Rows="_dashboard.RecentAudit" />
                    </MudItem>
                </MudGrid>
            }
        </MudTabPanel>

        <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings" OnClick="EnsureSettings">
            @if (_settings is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                @foreach (var cat in _settings.GroupBy(s => s.Category))
                {
                    <MudText Typo="Typo.h6" Class="koc-heading mt-3 mb-2">@cat.Key</MudText>
                    @foreach (var s in cat)
                    {
                        <BlueprintCard Class="pa-3 mb-2">
                            <div class="d-flex align-center gap-3">
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body2"><b>@s.DisplayName</b> @(s.IsSecret ? "🔒" : "")</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:.7;">@s.Description · v@s.Version</MudText>
                                </div>
                                <MudTextField T="string" Value="@Draft(s)" ValueChanged="@(v => _drafts[s.Key] = v)"
                                              InputType="@(s.IsSecret ? InputType.Password : InputType.Text)"
                                              Placeholder="@(s.IsSecret && s.IsSet ? "•••••• (set)" : "")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:280px;" />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveSetting(s)">Save</MudButton>
                            </div>
                        </BlueprintCard>
                    }
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Feature flags" Icon="@Icons.Material.Filled.Flag" OnClick="EnsureFlags">
            <div class="d-flex gap-2 mb-3">
                <MudTextField @bind-Value="_newFlagKey" Label="New flag key" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@string.IsNullOrWhiteSpace(_newFlagKey)" OnClick="AddFlag">Add flag</MudButton>
            </div>
            @if (_flags is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                @foreach (var f in _flags)
                {
                    <BlueprintCard Class="pa-3 mb-2">
                        <div class="d-flex align-center gap-3">
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2"><b>@f.Name</b> <code>@f.Key</code></MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.7;">@f.Description</MudText>
                            </div>
                            <MudSwitch T="bool" Value="f.IsEnabled" Color="Color.Primary" ValueChanged="@(v => ToggleFlag(f, v))" Label="@(f.IsEnabled ? "On" : "Off")" />
                            <MudText Typo="Typo.caption">rollout @f.RolloutPercentage%</MudText>
                        </div>
                    </BlueprintCard>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Demo data" Icon="@Icons.Material.Filled.AutoAwesome" OnClick="EnsureDemo">
            <MudText Typo="Typo.body2" Class="mb-3" Style="max-width:70ch;">
                Populate the platform with a self-contained demo — colleagues with Barrels and badges, a
                competition with a leaderboard, a discussion, and a dataset — so a fresh install can be
                explored immediately. Everything is namespaced to <code>demo-*</code>, so <b>Unseed</b>
                removes exactly the demo and never touches real KOC records.
            </MudText>

            @if (_demo is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <BlueprintCard Class="pa-4 mb-3">
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <MudChip T="string" Color="@(_demo.Seeded ? Color.Success : Color.Default)" Variant="Variant.Text">
                            @(_demo.Seeded ? "Demo data present" : "No demo data")
                        </MudChip>
                        <MudText Typo="Typo.caption">
                            @_demo.Users people · @_demo.Competitions competition(s) · @_demo.Discussions discussion(s) · @_demo.Datasets dataset(s)
                        </MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   Disabled="@(_demoBusy || _demo.Seeded)" OnClick="SeedDemo">Seed demo data</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   Disabled="@(_demoBusy || !_demo.Seeded)" OnClick="UnseedDemo">Unseed</MudButton>
                    </div>
                    @if (_demoBusy)
                    {
                        <MudProgressLinear Indeterminate="true" Class="mt-3" />
                    }
                </BlueprintCard>
            }
        </MudTabPanel>

        <MudTabPanel Text="Featured" Icon="@Icons.Material.Filled.Star" OnClick="EnsureFeatured">
            <MudText Typo="Typo.body2" Class="mb-3" Style="max-width:70ch;">
                Pin one competition as the <b>landing-page hero</b> — the big "Featured competition" card
                every user sees on Home, with its countdown, live podium, and <i>Enter the arena</i> button.
                Exactly one is featured at a time.
            </MudText>

            @if (_competitions is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_competitions.Count == 0)
            {
                <MudText Typo="Typo.body2">No competitions yet.</MudText>
            }
            else
            {
                <BlueprintCard Class="pa-4">
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <MudSelect T="Guid?" Label="Featured competition" Value="_featuredId" ValueChanged="@(v => _featuredId = v)" Style="min-width:340px;">
                            @foreach (var c in _competitions)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@(c.IsFeatured ? "★ " : "")@c.Title</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Star"
                                   Disabled="@(_featuredBusy || _featuredId is null)" OnClick="SetFeatured">Make featured</MudButton>
                    </div>
                    @if (_featuredBusy)
                    {
                        <MudProgressLinear Indeterminate="true" Class="mt-3" />
                    }
                </BlueprintCard>

                <BlueprintCard Class="pa-4 mt-4">
                    <MudText Typo="Typo.subtitle2" Class="koc-heading mb-1">🏆 Podium prizes</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3" Style="max-width:70ch;opacity:.8;">
                        Set the 1st / 2nd / 3rd prizes shown on a competition (free text, e.g.
                        <i>"1,000 Barrels + Gusher trophy"</i>). Leave a field blank to fall back to the standard barrel rewards.
                    </MudText>
                    <MudSelect T="Guid?" Label="Competition" Value="_prizeCompId" ValueChanged="OnPrizeCompChanged" Class="mb-3" Style="min-width:340px;">
                        @foreach (var c in _competitions)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@c.Title</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_prizeCompId is not null)
                    {
                        <div class="d-flex gap-3 flex-wrap mb-3">
                            <MudTextField @bind-Value="_prize1" Label="🥇 1st place" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;" />
                            <MudTextField @bind-Value="_prize2" Label="🥈 2nd place" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;" />
                            <MudTextField @bind-Value="_prize3" Label="🥉 3rd place" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;" />
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EmojiEvents"
                                   Disabled="_prizesBusy" OnClick="SavePrizes">Save prizes</MudButton>
                        @if (_prizesBusy)
                        {
                            <MudProgressLinear Indeterminate="true" Class="mt-3" />
                        }
                    }
                </BlueprintCard>
            }
        </MudTabPanel>

        <MudTabPanel Text="RBAC / Users" Icon="@Icons.Material.Filled.ManageAccounts" OnClick="EnsureRbac">
            <MudText Typo="Typo.body2" Class="mb-3" Style="max-width:80ch;">
                Manage who can <b>create competitions</b> and at what level, and each user's org identity
                (email, company, department). Department is picked from the org tree, which keeps the
                <code>Company&nbsp;ID</code> / <code>Dept&nbsp;ID</code> codes in sync with the unit.
            </MudText>

            @if (_users is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <BlueprintCard Class="pa-0 mb-4">
                    <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Company</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th style="min-width:190px;">Can create competitions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in _users)
                            {
                                <tr>
                                    <td>
                                        <b>@(u.DisplayName ?? u.UserId)</b>
                                        <MudText Typo="Typo.caption" Class="d-block" Style="opacity:.6;">@u.UserId</MudText>
                                    </td>
                                    <td>
                                        <MudTextField T="string" Value="@EmailDraft(u)" ValueChanged="@(v => _emailDrafts[u.UserId] = v)"
                                                      Variant="Variant.Text" Margin="Margin.Dense" Placeholder="name@koc.com.kw"
                                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Save"
                                                      OnAdornmentClick="() => SaveProfile(u)" />
                                    </td>
                                    <td>@(u.CompanyId ?? "—")</td>
                                    <td>
                                        <MudSelect T="string" Value="@(u.DepartmentId ?? "")" ValueChanged="@(v => OnDeptChanged(u, v))"
                                                   Variant="Variant.Text" Margin="Margin.Dense" Dense="true">
                                            <MudSelectItem T="string" Value="@("")">—</MudSelectItem>
                                            @foreach (var unit in _orgUnits?.Where(o => o.Code is not null) ?? [])
                                            {
                                                <MudSelectItem T="string" Value="@unit.Code">@unit.Code · @unit.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>
                                    <td><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@u.PositionLevel</MudChip></td>
                                    <td>
                                        <MudSelect T="string" Value="@(u.MaxCompetitionScope ?? "None")" ValueChanged="@(v => OnGrantChanged(u, v))"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                            @foreach (var s in GrantOptions)
                                            {
                                                <MudSelectItem Value="@s">@s</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </BlueprintCard>

                <MudText Typo="Typo.h6" Class="koc-heading mb-2">Org units &amp; codes</MudText>
                <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.7;">
                    Assign each company / directorate / group / team a short business code (e.g. <b>AX01</b>). Codes are unique.
                </MudText>
                <BlueprintCard Class="pa-0">
                    <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
                        <thead>
                            <tr><th>Unit</th><th>Type</th><th>Path</th><th style="min-width:200px;">Code</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var unit in _orgUnits ?? [])
                            {
                                <tr>
                                    <td><b>@unit.Name</b></td>
                                    <td><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@unit.Type</MudChip></td>
                                    <td><MudText Typo="Typo.caption" Style="opacity:.6;">@unit.Path</MudText></td>
                                    <td>
                                        <MudTextField T="string" Value="@CodeDraft(unit)" ValueChanged="@(v => _codeDrafts[unit.Id] = v)"
                                                      Variant="Variant.Text" Margin="Margin.Dense" Placeholder="AX01"
                                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Save"
                                                      OnAdornmentClick="() => SaveOrgCode(unit)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </BlueprintCard>
            }
        </MudTabPanel>

        <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.Verified" OnClick="EnsureAudit">
            @if (_audit is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                <AuditTable Rows="_audit" />
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private bool _forbidden;
    private AdminDashboardDto? _dashboard;
    private IReadOnlyList<SettingDto>? _settings;
    private IReadOnlyList<FeatureFlagDto>? _flags;
    private IReadOnlyList<AuditLogDto>? _audit;
    private readonly Dictionary<string, string> _drafts = new();
    private string _newFlagKey = "";
    private DemoDataStatusDto? _demo;
    private bool _demoBusy;

    private IReadOnlyList<CompetitionDto>? _competitions;
    private Guid? _featuredId;
    private bool _featuredBusy;

    private Guid? _prizeCompId;
    private string? _prize1;
    private string? _prize2;
    private string? _prize3;
    private bool _prizesBusy;

    private IReadOnlyList<AdminUserDto>? _users;
    private IReadOnlyList<OrgUnitCodeDto>? _orgUnits;
    private readonly Dictionary<string, string?> _emailDrafts = new();
    private readonly Dictionary<Guid, string?> _codeDrafts = new();
    private static readonly string[] GrantOptions = ["None", "Team", "Group", "Directorate", "Company"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await Api.GetAdminDashboardAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
    }

    private async Task EnsureFeatured()
    {
        if (_competitions is not null)
        {
            return;
        }

        try
        {
            _competitions = await Api.GetCompetitionsAsync();
            _featuredId = _competitions.FirstOrDefault(c => c.IsFeatured)?.Id;
        }
        catch
        {
            _competitions = [];
        }
    }

    private async Task SetFeatured()
    {
        if (_featuredId is not { } id)
        {
            return;
        }

        _featuredBusy = true;
        try
        {
            await Api.SetCompetitionFeaturedAsync(id);
            _competitions = await Api.GetCompetitionsAsync(); // refresh the ★ marker
            Snackbar.Add("Featured competition updated — it's now the Home hero.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't set featured: {ex.Message}", Severity.Error);
        }
        finally
        {
            _featuredBusy = false;
        }
    }

    private void OnPrizeCompChanged(Guid? id)
    {
        _prizeCompId = id;
        var c = _competitions?.FirstOrDefault(x => x.Id == id);
        _prize1 = c?.FirstPrize;
        _prize2 = c?.SecondPrize;
        _prize3 = c?.ThirdPrize;
    }

    private async Task SavePrizes()
    {
        if (_prizeCompId is not { } id)
        {
            return;
        }

        _prizesBusy = true;
        try
        {
            await Api.SetCompetitionPrizesAsync(id, new SetPrizesRequest(_prize1, _prize2, _prize3));
            _competitions = await Api.GetCompetitionsAsync(); // refresh cached prizes
            Snackbar.Add("Podium prizes saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't save prizes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _prizesBusy = false;
        }
    }

    private static IEnumerable<(string Label, int Value)> Kpis(AdminDashboardDto d) =>
    [
        ("Users", d.Users), ("Workflows", d.Workflows), ("Competitions", d.Competitions),
        ("Models", d.Models), ("Discussions", d.Discussions),
    ];

    private string Draft(SettingDto s) => _drafts.TryGetValue(s.Key, out var v) ? v : (s.IsSecret ? "" : s.Value);

    private async Task EnsureDemo() => _demo ??= await Api.GetDemoStatusAsync();

    private async Task SeedDemo()
    {
        _demoBusy = true;
        try
        {
            var (status, error) = await Api.SeedDemoAsync();
            Snackbar.Add(error ?? $"Demo data seeded — {status?.Users} colleagues, competitions, discussions, datasets and more.",
                error is null ? Severity.Success : Severity.Warning);
            _demo = status ?? _demo;
            _dashboard = await Api.GetAdminDashboardAsync();   // counts changed
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Seeding failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _demoBusy = false;
        }
    }

    private async Task UnseedDemo()
    {
        _demoBusy = true;
        try
        {
            var (status, error) = await Api.UnseedDemoAsync();
            Snackbar.Add(error ?? "Demo data removed.", error is null ? Severity.Success : Severity.Warning);
            _demo = status ?? _demo;
            _dashboard = await Api.GetAdminDashboardAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unseed failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _demoBusy = false;
        }
    }

    private async Task EnsureSettings() => _settings ??= await Api.GetSettingsAsync();
    private async Task EnsureFlags() => _flags ??= await Api.GetFeatureFlagsAsync();
    private async Task EnsureAudit() => _audit ??= await Api.GetAuditAsync();

    // ---- RBAC / Users ----

    private async Task EnsureRbac()
    {
        _orgUnits ??= await Api.GetAdminOrgUnitsAsync();
        _users ??= await Api.GetAdminUsersAsync();
    }

    private string EmailDraft(AdminUserDto u) => _emailDrafts.TryGetValue(u.UserId, out var v) ? (v ?? "") : (u.Email ?? "");
    private string CodeDraft(OrgUnitCodeDto unit) => _codeDrafts.TryGetValue(unit.Id, out var v) ? (v ?? "") : (unit.Code ?? "");

    private async Task OnGrantChanged(AdminUserDto u, string value)
    {
        var error = value == "None"
            ? await Api.RevokeCompetitionGrantAsync(u.UserId)
            : await Api.SetCompetitionGrantAsync(u.UserId, value);
        Snackbar.Add(error ?? $"{u.DisplayName ?? u.UserId} can now create up to {value}.".Replace("up to None", "no longer create competitions"),
            error is null ? Severity.Success : Severity.Warning);
        _users = await Api.GetAdminUsersAsync();
    }

    private async Task OnDeptChanged(AdminUserDto u, string departmentCode) => await SaveProfile(u, departmentCode);

    private Task SaveProfile(AdminUserDto u) => SaveProfile(u, u.DepartmentId);

    private async Task SaveProfile(AdminUserDto u, string? departmentCode)
    {
        var email = _emailDrafts.TryGetValue(u.UserId, out var e) ? e : u.Email;
        var (_, error) = await Api.UpsertUserProfileAsync(u.UserId, new UpsertUserProfileRequest(email, u.DisplayName, departmentCode));
        Snackbar.Add(error ?? $"Saved {u.DisplayName ?? u.UserId}.", error is null ? Severity.Success : Severity.Warning);
        if (error is null)
        {
            _emailDrafts.Remove(u.UserId);
        }

        _users = await Api.GetAdminUsersAsync();
    }

    private async Task SaveOrgCode(OrgUnitCodeDto unit)
    {
        var code = _codeDrafts.TryGetValue(unit.Id, out var c) ? c : unit.Code;
        var error = await Api.SetOrgUnitCodeAsync(unit.Id, code);
        Snackbar.Add(error ?? $"Code saved for {unit.Name}.", error is null ? Severity.Success : Severity.Warning);
        if (error is null)
        {
            _codeDrafts.Remove(unit.Id);
            _orgUnits = await Api.GetAdminOrgUnitsAsync();
        }
    }

    private async Task SaveSetting(SettingDto s)
    {
        var value = _drafts.TryGetValue(s.Key, out var v) ? v : s.Value;
        var (_, error) = await Api.UpdateSettingAsync(s.Key, value);
        Snackbar.Add(error ?? $"Saved {s.DisplayName}.", error is null ? Severity.Success : Severity.Warning);
        _drafts.Remove(s.Key);
        _settings = await Api.GetSettingsAsync();
    }

    private async Task ToggleFlag(FeatureFlagDto f, bool enabled)
    {
        var (_, error) = await Api.UpsertFeatureFlagAsync(f.Key, new UpsertFeatureFlagRequest(f.Name, f.Description, enabled, f.RolloutPercentage));
        Snackbar.Add(error ?? $"{f.Name} {(enabled ? "enabled" : "disabled")}.", error is null ? Severity.Success : Severity.Warning);
        _flags = await Api.GetFeatureFlagsAsync();
    }

    private async Task AddFlag()
    {
        var (_, error) = await Api.UpsertFeatureFlagAsync(_newFlagKey.Trim(), new UpsertFeatureFlagRequest(_newFlagKey.Trim(), "", false, 100));
        Snackbar.Add(error ?? "Flag added.", error is null ? Severity.Success : Severity.Warning);
        _newFlagKey = "";
        _flags = await Api.GetFeatureFlagsAsync();
    }
}
