@page "/runs"
@using Beep.KocAiCommunity.Contracts.Jobs
@using Beep.KocAiCommunity.Web.Services
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IKocApiClient Api
@inject RealtimeOptions Realtime
@inject ISnackbar Snackbar

<PageTitle>Runs · @KocBrand.ProductName</PageTitle>

<PageHeader Eyebrow="Studio" Title="Runs"
            Subtitle="Background training and workflow runs execute durably in the Worker — they survive restarts, retry on failure, and stream progress here live.">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">Couldn't reach the API (@_error).</MudAlert>
}

<MudGrid Spacing="6">
    <MudItem xs="12" md="5">
        @if (_runs is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_runs.Count == 0)
        {
            <BlueprintCard Class="pa-6" Style="text-align:center;">
                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.body2">No runs yet. Training a model from the Studio queues a run here.</MudText>
            </BlueprintCard>
        }
        else
        {
            @foreach (var r in _runs)
            {
                <div @onclick="() => Open(r.Id)" style="cursor:pointer;">
                    <BlueprintCard Class="pa-4 mb-3" Style="@(r.Id == _open?.Id ? "border-color:var(--koc-accent-500);" : "")">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.subtitle1" Class="koc-heading">@r.Title</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(r.Status)" Variant="Variant.Text">@r.Status</MudChip>
                        </div>
                        <MudText Typo="Typo.caption">@r.Type · attempt @r.AttemptCount/@r.MaxAttempts · @r.CreatedUtc.ToLocalTime().ToString("g")</MudText>
                    </BlueprintCard>
                </div>
            }
        }
    </MudItem>

    <MudItem xs="12" md="7">
        @if (_open is null)
        {
            <MudText Typo="Typo.body2" Class="mt-4">Select a run to watch its progress.</MudText>
        }
        else
        {
            <BlueprintCard Class="pa-5">
                <div class="d-flex justify-space-between align-center mb-2">
                    <div>
                        <MudText Typo="Typo.h6" Class="koc-heading">@_open.Title</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(_open.Status)" Variant="Variant.Filled">@_open.Status</MudChip>
                    </div>
                    @if (!IsTerminal(_open.Status))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel">Cancel</MudButton>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_open.LastError))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_open.LastError</MudAlert>
                }

                <MudText Typo="Typo.subtitle2" Class="koc-heading mb-1">Live log</MudText>
                <div style="background:#0B2E4C;color:#D6E6F2;font-family:monospace;font-size:12px;border-radius:4px;padding:12px;max-height:340px;overflow:auto;">
                    @if (_logs.Count == 0)
                    {
                        <div style="opacity:.6;">Waiting for output…</div>
                    }
                    else
                    {
                        @foreach (var l in _logs)
                        {
                            <div style="@(l.Severity == "error" ? "color:#FF9B9B;" : l.Severity == "warning" ? "color:#FFD37A;" : "")">
                                <span style="opacity:.5;">@l.LoggedUtc.ToLocalTime().ToString("HH:mm:ss")</span> @l.Message
                            </div>
                        }
                    }
                </div>
            </BlueprintCard>
        }
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<RunDto>? _runs;
    private RunDto? _open;
    private List<RunLogDto> _logs = [];
    private string? _error;
    private HubConnection? _hub;
    private string? _joinedRunId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await ConnectAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _runs = await Api.GetRunsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ConnectAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder().WithUrl(Realtime.HubUrl).WithAutomaticReconnect().Build();
            _hub.On<string>("run.progress", async _ => await OnRunProgressAsync());
            await _hub.StartAsync();
        }
        catch
        {
            // Live updates are best-effort; the page still works via manual refresh.
        }
    }

    private async Task OnRunProgressAsync()
    {
        if (_open is not null)
        {
            await RefreshOpenAsync();
        }

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Open(Guid id)
    {
        if (_hub is not null && _hub.State == HubConnectionState.Connected)
        {
            if (_joinedRunId is not null)
            {
                await _hub.SendAsync("LeaveRun", _joinedRunId);
            }

            await _hub.SendAsync("JoinRun", id.ToString());
            _joinedRunId = id.ToString();
        }

        _open = await Api.GetRunAsync(id);
        await RefreshOpenAsync();
    }

    private async Task RefreshOpenAsync()
    {
        if (_open is null)
        {
            return;
        }

        _open = await Api.GetRunAsync(_open.Id) ?? _open;
        _logs = [.. await Api.GetRunLogsAsync(_open.Id)];
    }

    private async Task Cancel()
    {
        if (_open is null)
        {
            return;
        }

        try
        {
            await Api.CancelRunAsync(_open.Id);
            Snackbar.Add("Cancellation requested.", Severity.Info);
            await RefreshOpenAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't cancel: {ex.Message}", Severity.Error);
        }
    }

    private static bool IsTerminal(string status) =>
        status is "succeeded" or "failed" or "cancelled" or "deadletter";

    private static Color StatusColor(string status) => status switch
    {
        "succeeded" => Color.Success,
        "running" => Color.Info,
        "pending" => Color.Default,
        "cancelled" => Color.Warning,
        _ => Color.Error,
    };

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
