@page "/studio"
@using Microsoft.AspNetCore.Components.Forms
@using Beep.KocAiCommunity.Contracts.Studio
@using Beep.KocAiCommunity.Web.Services
@using Beep.KocAiCommunity.Ui.Shared.Components
@inject IKocApiClient Api
@inject ISnackbar Snackbar

<PageTitle>AutoML · @KocBrand.ProductName</PageTitle>

<PageHeader Eyebrow="Build a model" Title="AutoML training"
            Subtitle="Turn a CSV into a working prediction with ML.NET AutoML — no code. Upload a dataset, tell it which column to predict, pick the task, and it finds and evaluates the best model. For a step-by-step pipeline, use the Studio node editor." />

<MudGrid Spacing="6">
    <MudItem xs="12" md="5">
        <BlueprintCard Class="pa-5">
            <MudText Typo="Typo.subtitle1" Class="koc-heading mb-3">Train a model</MudText>
            <MudTextField @bind-Value="_datasetName" Label="Dataset name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudTextField @bind-Value="_labelColumn" Label="Label column" Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="The column ML.NET should learn to predict." Class="mb-2" />
            <MudSelect @bind-Value="_task" Label="Task" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem Value="@("BinaryClassification")">Binary classification (true/false)</MudSelectItem>
                <MudSelectItem Value="@("MulticlassClassification")">Multiclass classification (categories)</MudSelectItem>
                <MudSelectItem Value="@("Regression")">Regression (numeric)</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Class="d-block mb-1">CSV file (id,features…,label)</MudText>
            <InputFile OnChange="OnFileSelected" accept=".csv" />

            @if (_training)
            {
                <div class="d-flex align-center gap-3 mt-4">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    <MudText Typo="Typo.body2">Training… (AutoML searches for the best algorithm)</MudText>
                </div>
            }

            @if (_lastRun is not null)
            {
                <BlueprintCard Class="pa-4 mt-4" Style="background:var(--koc-surface);">
                    <MudText Typo="Typo.overline">Best model · @_lastRun.Task</MudText>
                    <div class="koc-stat-value" style="font-size:30px;">@_lastRun.PrimaryValue.ToString("0.###")</div>
                    <MudText Typo="Typo.caption">@_lastRun.PrimaryMetric · @_lastRun.Algorithm · @_lastRun.SecondaryMetric @_lastRun.SecondaryValue.ToString("0.###") · @_lastRun.RowCount rows</MudText>
                </BlueprintCard>
            }
        </BlueprintCard>
    </MudItem>

    <MudItem xs="12" md="7">
        <BlueprintCard Class="pa-0">
            <div class="pa-4"><MudText Typo="Typo.subtitle1" Class="koc-heading">Your training runs</MudText></div>
            @if (_runs is null)
            {
                <MudProgressCircular Indeterminate="true" Class="ma-4" />
            }
            else if (_runs.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pa-4">No runs yet. Upload a CSV to train your first model.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead><tr><th>Dataset</th><th>Task</th><th>Algorithm</th><th style="text-align:right;">Metric</th><th style="text-align:right;">Rows</th></tr></thead>
                    <tbody>
                        @foreach (var r in _runs)
                        {
                            <tr>
                                <td>@r.DatasetName</td>
                                <td>@r.Task</td>
                                <td>@r.Algorithm</td>
                                <td style="text-align:right;">@r.PrimaryValue.ToString("0.###") <MudText Typo="Typo.caption" Class="d-inline">@r.PrimaryMetric</MudText></td>
                                <td style="text-align:right;">@r.RowCount</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </BlueprintCard>
    </MudItem>
</MudGrid>

@code {
    private string _datasetName = "My dataset";
    private string _labelColumn = "label";
    private string _task = "BinaryClassification";
    private bool _training;
    private ModelRunDto? _lastRun;
    private IReadOnlyList<ModelRunDto>? _runs;

    protected override async Task OnInitializedAsync() => await LoadRuns();

    private async Task LoadRuns()
    {
        try { _runs = await Api.GetModelRunsAsync(); }
        catch { _runs = []; }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _training = true;
        _lastRun = null;
        StateHasChanged();
        try
        {
            using var ms = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            {
                await stream.CopyToAsync(ms);
            }
            ms.Position = 0;

            _lastRun = await Api.TrainAsync(ms, e.File.Name, _labelColumn, _datasetName, _task);
            await LoadRuns();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Training failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _training = false;
        }
    }
}
