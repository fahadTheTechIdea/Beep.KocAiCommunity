@page "/compete"
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Web.Components.Dialogs
@using Beep.KocAiCommunity.Web.Components.Shared
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Ui.Shared.Localization
@using Microsoft.Extensions.Localization
@inject IKocApiClient Api
@inject IStringLocalizer<Strings> L
@inject DevIdentity Identity
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>@L["Compete"] · @KocBrand.ProductName</PageTitle>

@* The arena opens with the state of the arena, not a paragraph about it. Every figure below is summed
   from the competitions already loaded, so this costs no extra request. *@
<div class="koc-arena-hero koc-arena-banner mb-6">
    <div class="koc-arena-hero-ink">
        <span class="koc-eyebrow">@L["The arena"]</span>
        <h1 class="koc-hero-title">@L["Competitions"]</h1>
        <MudText Typo="Typo.body2" Class="koc-arena-lede">
            @L["Internal, Kaggle-style challenges on real KOC problems — get the data, build your model in KOC Studio on the desktop, and climb the live leaderboard. Final standings stay hidden until reveal day."]
        </MudText>

        @if (_competitions is { Count: > 0 })
        {
            <div class="koc-hero-stats">
                <div class="koc-hero-stat">
                    <span class="koc-hero-stat-value koc-stat-value @(LiveCount > 0 ? "koc-live" : "")">@LiveCount</span>
                    <span class="koc-hero-stat-label">@L["running now"]</span>
                </div>
                <div class="koc-hero-stat">
                    <span class="koc-hero-stat-value koc-stat-value">@EntryCount</span>
                    <span class="koc-hero-stat-label">@L["entries"]</span>
                </div>
                <div class="koc-hero-stat">
                    <span class="koc-hero-stat-value koc-stat-value">@SubmissionCount</span>
                    <span class="koc-hero-stat-label">@L["submissions"]</span>
                </div>
                @if (ClosingNext is { } closing)
                {
                    <div class="koc-hero-stat koc-hero-stat--clock">
                        <CountdownTimer TargetUtc="closing.RevealUtc" Compact="true" Label="@L["until the next reveal"]" />
                    </div>
                }
            </div>
        }

        <div class="koc-arena-hero-actions">
            @* Inherit and Secondary, not Primary: primary is the banner's own blue, and a blue button on
               a blue banner is a button nobody sees. *@
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/leaderboards"
                       StartIcon="@Icons.Material.Filled.Leaderboard">@L["See the standings"]</MudButton>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="koc-arena-cta"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">@L["Host a competition"]</MudButton>
            }
        </div>
    </div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@L["Couldn't reach the API ({0}).", _error]</MudAlert>
}

@if (_competitions is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_competitions.Count == 0)
{
    <BlueprintCard Class="pa-8" Style="text-align:center;">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
        <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["No competitions yet"]</MudText>
        <MudText Typo="Typo.body2">@L["Ask an admin to seed the demo data, or host a competition above."]</MudText>
    </BlueprintCard>
}
else
{
    @* Search first. Three rows of chips is a fine way to narrow twelve competitions and a poor way to
       find one among fifty — by then you know its name and want to type it. *@
    <div class="koc-arena-search mb-3">
        <MudTextField T="string" Value="_search" ValueChanged="@(v => _search = v ?? "")" Immediate="true"
                      Placeholder="@L["Search competitions"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
    </div>

    <!-- Filters -->
    <div class="d-flex gap-1 flex-wrap align-center mb-4">
        @foreach (var status in new[] { "all", "active", "concluded", "draft" })
        {
            <MudChip T="string" Size="Size.Small"
                     Variant="@(_statusFilter == status ? Variant.Filled : Variant.Outlined)"
                     Color="@(_statusFilter == status ? Color.Primary : Color.Default)"
                     OnClick="() => _statusFilter = status">@(status == "all" ? L["All"] : L[CompetitionDisplay.StatusLabel(status)])</MudChip>
        }
        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
        @foreach (var (task, label) in TaskFilters)
        {
            <MudChip T="string" Size="Size.Small"
                     Variant="@(_taskFilter == task ? Variant.Filled : Variant.Outlined)"
                     Color="@(_taskFilter == task ? Color.Secondary : Color.Default)"
                     OnClick="() => _taskFilter = task">@label</MudChip>
        }
    </div>

    @if (_categories.Count > 0)
    {
        @* Which part of the business the challenge belongs to — usually what someone is actually
           looking for, more than which algorithm it happens to need. *@
        <div class="d-flex gap-1 flex-wrap align-center mb-4">
            <MudText Typo="Typo.caption" Class="me-1" Style="opacity:.7;">@L["Domain"]</MudText>
            <MudChip T="string" Size="Size.Small"
                     Variant="@(_categoryFilter == "all" ? Variant.Filled : Variant.Outlined)"
                     Color="@(_categoryFilter == "all" ? Color.Primary : Color.Default)"
                     OnClick='() => _categoryFilter = "all"'>@L["All domains"]</MudChip>
            @foreach (var category in _categories)
            {
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_categoryFilter == category.Code ? Variant.Filled : Variant.Outlined)"
                         Color="@(_categoryFilter == category.Code ? Color.Primary : Color.Default)"
                         OnClick="() => _categoryFilter = category.Code">@category.Name</MudChip>
            }
        </div>
    }

    var visible = Filtered();

    <div class="koc-arena-count mb-3">
        @if (visible.Count == _competitions.Count)
        {
            @L["{0} competitions", _competitions.Count]
        }
        else
        {
            @L["{0} of {1} competitions", visible.Count, _competitions.Count]
        }
    </div>

    @if (visible.Count == 0)
    {
        @* An empty result is a dead end unless it offers the way out of itself. *@
        <BlueprintCard Class="pa-8" Style="text-align:center;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6" Class="koc-heading mb-1">@L["Nothing here yet"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@L["No competition matches these filters. Widen them and something will turn up."]</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearFilters" StartIcon="@Icons.Material.Filled.FilterAltOff">@L["Clear filters"]</MudButton>
        </BlueprintCard>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var c in visible)
            {
                var isSpotlight = c.Id == _spotlightId;
                <MudItem xs="12" md="@(isSpotlight ? 12 : 6)" lg="@(isSpotlight ? 12 : 4)">
                    <CompetitionCard Competition="c"
                                     Top3="@(isSpotlight ? _spotlightBoard : null)"
                                     MyUserId="@Identity.UserId" />
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private IReadOnlyList<CompetitionDto>? _competitions;
    private string? _error;
    private string _statusFilter = "all";
    private string _taskFilter = "all";
    private string _search = "";

    // The state of the arena, summed from what is already loaded — no extra request for any of it.
    private int LiveCount => _competitions?.Count(c => c.Status == "active") ?? 0;

    /// <summary>
    /// Entries, deliberately not "people": this sums participants across boards, and somebody in three
    /// competitions is counted three times. Calling it competitors would be a number that reads as a
    /// headcount and is not one.
    /// </summary>
    private int EntryCount => _competitions?.Sum(c => c.ParticipantCount) ?? 0;

    private int SubmissionCount => _competitions?.Sum(c => c.SubmissionCount) ?? 0;

    /// <summary>The soonest reveal still ahead of us, for the countdown in the hero.</summary>
    private CompetitionDto? ClosingNext =>
        _competitions?
            .Where(c => c.Status == "active" && c.RevealUtc is { } r && r > DateTime.UtcNow)
            .MinBy(c => c.RevealUtc);

    private void ClearFilters()
    {
        _statusFilter = "all";
        _taskFilter = "all";
        _categoryFilter = "all";
        _search = "";
    }

    // Only enabled categories are served, so a switched-off one never appears as a filter.
    private string _categoryFilter = "all";
    private IReadOnlyList<CompetitionCategoryDto> _categories = [];

    private Guid? _spotlightId;
    private IReadOnlyList<LeaderboardEntryDto>? _spotlightBoard;

    private string? _maxScope;
    private bool CanCreate => _maxScope is not null;

    /// <summary>
    /// Built on demand so the labels can go through the localizer. The task names deliberately match
    /// what MlTaskLabels returns, so a chip on a card and the filter that selects it read identically.
    /// </summary>
    private (string Task, string Label)[] TaskFilters =>
    [
        ("all", L["Any task"]),
        ("BinaryClassification", L["Classification"]),
        ("MulticlassClassification", L["Multiclass"]),
        ("Regression", L["Regression"]),
        ("Forecasting", L["Forecasting"]),
        ("AnomalyDetection", L["Anomaly detection"]),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _maxScope = (await Api.GetMeAsync())?.MaxCompetitionScope;
        }
        catch
        {
            _maxScope = null;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _competitions = Sort(await Api.GetCompetitionsAsync());

            // Filter row: enabled categories only, so a switched-off domain isn't even offered.
            try { _categories = await Api.GetCompetitionCategoriesAsync(); }
            catch { _categories = []; }

            // Spotlight: the leading active competition gets a fetched top-3 podium (one request total).
            var spotlight = _competitions.FirstOrDefault(c => c.Status == "active");
            _spotlightId = spotlight?.Id;
            _spotlightBoard = spotlight is null ? null : (await Api.GetLeaderboardAsync(spotlight.Id)).Take(3).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _competitions = [];
        }
    }

    // Active first (nearest reveal leading, then the liveliest race), then everything else newest-first.
    private static IReadOnlyList<CompetitionDto> Sort(IReadOnlyList<CompetitionDto> items) =>
    [
        .. items.OrderBy(c => c.Status switch { "active" => 0, "draft" => 1, _ => 2 })
            .ThenBy(c => c.Status == "active" ? c.RevealUtc ?? DateTime.MaxValue : DateTime.MaxValue)
            .ThenByDescending(c => c.ParticipantCount)
            .ThenByDescending(c => c.CreatedUtc ?? DateTime.MinValue),
    ];

    private List<CompetitionDto> Filtered() =>
        (_competitions ?? [])
            .Where(c => _statusFilter == "all" || c.Status == _statusFilter)
            .Where(c => _taskFilter == "all" || c.TaskType == _taskFilter)
            .Where(c => _categoryFilter == "all" || c.CategoryCode == _categoryFilter)
            // Title, domain and description: what somebody actually remembers a competition by.
            .Where(c => string.IsNullOrWhiteSpace(_search)
                     || c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || (c.CategoryName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || c.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private async Task OpenCreate()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<CreateCompetitionDialog> { { x => x.MaxScope, _maxScope } };
        var dialog = await DialogService.ShowAsync<CreateCompetitionDialog>("New competition", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is Guid id)
        {
            // Land the host straight on their new competition's page (Host tab).
            Nav.NavigateTo($"/compete/{id}?tab=host");
        }
        else
        {
            await LoadAsync();
        }
    }
}
