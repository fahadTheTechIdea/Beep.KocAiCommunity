@page "/setup"
@using Beep.KocAiCommunity.ServiceDefaults.Security
@using Beep.KocAiCommunity.Ui.Shared.Components
@layout Beep.KocAiCommunity.Web.Components.Layout.BareLayout
@inject KocSetupStore SetupStore

@* First run only, and only when the answer isn't obvious: a deployment inside KOC arrives already
   authenticated by IIS, which settles the question without asking. Static server rendering, because the
   answer is written by a plain form post before any of the app's services exist. *@

<PageTitle>Set up @KocBrand.ProductName</PageTitle>

<div class="koc-auth-shell">
    <BlueprintCard Class="pa-6" Style="width:100%;max-width:600px;">
        @if (Saved)
        {
            <div class="text-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="koc-heading mt-2 mb-1">Setup saved</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    People will sign in with <b>@SourceName(SetupStore.SignInWith)</b>.
                </MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3" Style="text-align:left;">
                    <b>Restart the app to apply it.</b> Sign-in is wired up when the app starts, so the web
                    site and the API both need restarting.
                </MudAlert>
                <MudText Typo="Typo.caption" Class="d-block" Style="opacity:.7;">
                    Saved to <code>@SetupStore.FilePath</code>
                </MudText>
            </div>
        }
        else
        {
            <div class="mb-4">
                <img src="@KocBrand.LogoPath" alt="Kuwait Oil Company" height="42" />
                <MudText Typo="Typo.h5" Class="koc-heading mt-2">Welcome to @KocBrand.ProductName</MudText>
                <MudText Typo="Typo.body2" Style="opacity:.8;">
                    One question: where do people sign in? Everything else — accounts, roles, permissions —
                    is managed inside the site once it's running.
                </MudText>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-3">@Error</MudAlert>
            }

            <form method="post" action="/setup">
                @foreach (var option in KocSignInSourceInfo.All)
                {
                    <label class="koc-setup-option">
                        <input type="radio" name="signInWith" value="@option.Source"
                               checked="@(option.Source == KocSignInSource.SiteAccounts)" />
                        <span>
                            <b>@option.DisplayName</b>
                            <small>@option.Summary</small>
                        </span>
                    </label>
                }

                <button class="koc-submit" type="submit">Save and continue</button>
            </form>

            <MudText Typo="Typo.caption" Class="d-block mt-3" Style="opacity:.7;">
                Either way an administrator can also create accounts here for people the corporate
                directory doesn't cover — contractors and partners, for example.
            </MudText>
        }
    </BlueprintCard>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] private string? SavedFlag { get; set; }

    private bool Saved => SavedFlag == "1";

    private static string SourceName(KocSignInSource source) =>
        KocSignInSourceInfo.Find(source)?.DisplayName ?? source.ToString();
}
