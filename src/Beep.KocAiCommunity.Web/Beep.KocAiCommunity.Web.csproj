<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Development-only secrets live in the user secret store, never in source. -->
    <UserSecretsId>beep-kocaicommunity-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Z.Blazor.Diagrams" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- A production publish must NOT carry the dev settings, so the app resolves to Production
         when no environment variable is set (immutable-binary environment detection). -->
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beep.KocAiCommunity.ServiceDefaults\Beep.KocAiCommunity.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Client\Beep.KocAiCommunity.Client.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Ui.Shared\Beep.KocAiCommunity.Ui.Shared.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Ui.Community\Beep.KocAiCommunity.Ui.Community.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Ui.Admin\Beep.KocAiCommunity.Ui.Admin.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Application\Beep.KocAiCommunity.Application.csproj" />
  </ItemGroup>

</Project>
