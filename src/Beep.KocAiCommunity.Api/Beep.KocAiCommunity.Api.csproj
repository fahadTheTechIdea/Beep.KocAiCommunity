<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Development-only secrets (e.g. a real DB connection string) live in the user secret store,
         never in source. Active only when the environment is Development. -->
    <UserSecretsId>beep-kocaicommunity-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <!-- Immutable-binary environment detection: a production publish must NOT carry the dev settings,
         so the app resolves to Production when no environment variable is set. -->
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beep.KocAiCommunity.ServiceDefaults\Beep.KocAiCommunity.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Application\Beep.KocAiCommunity.Application.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Infrastructure\Beep.KocAiCommunity.Infrastructure.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.Contracts\Beep.KocAiCommunity.Contracts.csproj" />
    <ProjectReference Include="..\Beep.KocAiCommunity.ML\Beep.KocAiCommunity.ML.csproj" />
    <!-- Present so SQL Server migrations are available at runtime in production. -->
    <ProjectReference Include="..\Beep.KocAiCommunity.Infrastructure.SqlServerMigrations\Beep.KocAiCommunity.Infrastructure.SqlServerMigrations.csproj" />
  </ItemGroup>

</Project>
