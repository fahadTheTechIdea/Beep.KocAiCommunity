@page "/settings"
@using Beep.KocAiCommunity.Client
@inject DevIdentity Identity
@inject AppSettings Config
@inject SignedInUser Me
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>

<MudPaper Class="pa-4" MaxWidth="560px" Outlined="true">
    <MudText Typo="Typo.subtitle1" Class="mb-2">KOC network</MudText>
    <MudTextField @bind-Value="_apiBaseUrl" Label="API base URL" Variant="Variant.Outlined" Margin="Margin.Dense"
                  HelperText="Used for competitions (browse, submit, leaderboard). Applied on next launch." Class="mb-4" />

    <MudText Typo="Typo.subtitle1" Class="mb-1">Identity</MudText>
    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.7;">
        Signed in from your intranet session — no extra login.
    </MudText>
    <MudField Label="Signed in as" Variant="Variant.Outlined" Margin="Margin.Dense"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AccountCircle">
        @_display <span style="opacity:.6;">(@_userId)</span>
    </MudField>
    <div class="d-flex gap-2 my-2 flex-wrap">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Email">@Or(_email, "email —")</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Business">@Or(_company, "company —")</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Groups">@Or(_department, "department —")</MudChip>
    </div>
    @if (_email is null && _department is null)
    {
        <MudText Typo="Typo.caption" Class="d-block mb-2" Style="opacity:.6;">
            Department &amp; profile details load from the KOC directory once its API is configured.
        </MudText>
    }

    <MudSelect T="string" @bind-Value="_personaKey" Label="Act as (dev override)" Variant="Variant.Outlined" Margin="Margin.Dense"
               HelperText="Leave as the signed-in user in production. The dev personas are for testing roles against a dev API.">
        <MudSelectItem Value="@DevIdentity.RealUserKey">Signed-in user (@_display)</MudSelectItem>
        @foreach (var p in DevIdentity.Personas)
        {
            <MudSelectItem Value="@p.Key">@p.Label</MudSelectItem>
        }
    </MudSelect>

    <div class="d-flex justify-end mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save</MudButton>
    </div>
</MudPaper>

@code {
    private string _apiBaseUrl = "";
    private string _personaKey = "";
    private string _userId = "";
    private string _display = "";
    private string? _email;
    private string? _company;
    private string? _department;

    protected override void OnInitialized()
    {
        _apiBaseUrl = Config.ApiBaseUrl;
        _personaKey = Identity.Current.Key;

        var me = Me.Current;
        _userId = me?.UserId ?? "";
        _display = me?.DisplayName ?? _userId;
        _email = me?.Email;
        _company = me?.CompanyId;
        _department = me?.DepartmentId;
    }

    private static string Or(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value!;

    private Task SaveAsync()
    {
        // Apply the chosen identity live.
        if (_personaKey == DevIdentity.RealUserKey && Me.Current is { } me)
        {
            Identity.SetRealUser(me.UserId, me.DisplayName, me.Roles ?? []);
        }
        else if (_personaKey != DevIdentity.RealUserKey)
        {
            Identity.SetPersona(_personaKey);
        }

        Config.ApiBaseUrl = _apiBaseUrl.Trim();
        Config.PersonaKey = _personaKey;
        Config.Save();
        Snackbar.Add("Saved. Restart to apply a changed API URL.", Severity.Success);
        return Task.CompletedTask;
    }
}
