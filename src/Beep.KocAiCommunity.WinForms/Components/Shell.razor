@* Root component rendered into #app by the BlazorWebView. Provides the MudBlazor
   services UI and routes to the shared Ui.Studio pages (/workflow, /workflows). *@

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(Shell).Assembly"
        AdditionalAssemblies="new[] { typeof(Beep.KocAiCommunity.Ui.Studio.UiStudioAssembly).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(DesktopLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(DesktopLayout)">
            <MudText Typo="Typo.h6" Class="pa-4">Page not found.</MudText>
        </LayoutView>
    </NotFound>
</Router>
