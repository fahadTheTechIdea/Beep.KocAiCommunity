@page "/workflow"
@page "/workflow/{WorkflowId:guid}"
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Models
@using Beep.KocAiCommunity.Ui.Studio.Diagrams
@using Beep.KocAiCommunity.Contracts.Workflow
@using Beep.KocAiCommunity.Contracts.Studio
@using Beep.KocAiCommunity.Contracts.Datasets
@using Beep.KocAiCommunity.Contracts.ML
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Ui.Shared.Components
@using Beep.KocAiCommunity.Ui.Studio.Services
@implements IDisposable
@inject IKocApiClient Api
@inject RunSession Runs
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Studio · @KocBrand.ProductName</PageTitle>

@if (!_registryMode)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <!-- ===== Node editor ===== -->
    <div class="d-flex align-center gap-2 mb-3 flex-wrap">
        @if (_registryMode)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/workflows">Workflows</MudButton>
            <MudText Typo="Typo.h5" Class="koc-heading">@_registryName</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_registryStatus == "published" ? Color.Success : Color.Info)">v@_registryVersion · @_registryStatus</MudChip>

            @* What this pipeline is learning. It lives on the Train node — surfaced (and settable) here so it
               isn't discoverable only by selecting that node. A competition's task is fixed, and the ribbon
               below already states it, so the control is free-mode only. *@
            @if (_competition is null)
            {
                @if (TrainNode() is null)
                {
                    <MudTooltip Text="Add a Train node to choose what the pipeline learns.">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                 Icon="@Icons.Material.Filled.ModelTraining" Style="opacity:.6;">No model yet</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                        <ActivatorContent>
                            <MudTooltip Text="The task the Train node learns — sets the metric and which algorithms apply.">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         Icon="@Icons.Material.Filled.ModelTraining" OnClick="@context.ToggleAsync" Style="cursor:pointer;">
                                    @EffectiveTaskLabel()
                                </MudChip>
                            </MudTooltip>
                        </ActivatorContent>
                        <ChildContent>
                            <MudText Typo="Typo.caption" Class="px-4 py-2 d-block">What is this pipeline learning?</MudText>
                            <MudDivider />
                            @foreach (var option in TaskOptions())
                            {
                                <MudMenuItem OnClick="@(() => SetTask(option.Value))">
                                    @if (option.Value == EffectiveTask())
                                    {
                                        <b>@option.Label ✓</b>
                                    }
                                    else
                                    {
                                        @option.Label
                                    }
                                </MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                }
            }
            @if (_running || _submitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            <MudSpacer />
            @* A disabled Run button with no explanation is the thing people file a ticket about. *@
            @if (GraphIssues() is { Count: > 0 } outstanding)
            {
                <MudTooltip Text="@string.Join("  •  ", outstanding)">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                             Icon="@Icons.Material.Filled.ReportProblem">
                        @outstanding.Count @(outstanding.Count == 1 ? "problem" : "problems")
                    </MudChip>
                </MudTooltip>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(_running || GraphIssues().Count > 0)" OnClick="RunFromDataset">Run</MudButton>
            @if (_registryCompetitionId is { } topCompId)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.EmojiEvents"
                           Disabled="@(_submitting || GraphIssues().Count > 0)" OnClick="() => OnSubmitPipeline(topCompId)">Submit</MudButton>
            }
            <MudTooltip Text="Undo (Ctrl+Z)">
                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" OnClick="Undo"
                               Disabled="@(!_history.CanUndo)" aria-label="Undo" />
            </MudTooltip>
            <MudTooltip Text="Redo (Ctrl+Y)">
                <MudIconButton Icon="@Icons.Material.Filled.Redo" Size="Size.Small" OnClick="Redo"
                               Disabled="@(!_history.CanRedo)" aria-label="Redo" />
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveRegistryDraft" Disabled="_registryBusy">Save draft</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Publish" OnClick="PublishRegistry" Disabled="_registryBusy">Publish</MudButton>
        }
    </div>

    @* Competition context: what you're building for, and the facts the server will enforce on submission. *@
    @if (_competition is { } comp)
    {
        <BlueprintCard Class="pa-3 mb-3">
            <div class="d-flex align-center gap-3 flex-wrap">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Secondary" />
                <div>
                    <MudText Typo="Typo.subtitle2" Class="koc-heading">🏆 @comp.Title</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.75;">
                        Predict <code>@comp.LabelColumn</code> per <code>@comp.IdColumn</code> · scored on
                        <b>@(string.IsNullOrEmpty(comp.MetricName) ? "the host's metric" : comp.MetricName)</b>
                        @(comp.HigherIsBetter ? "(higher wins)" : "(lower wins)")
                    </MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@MlTaskLabels.Display(comp.TaskType)</MudChip>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@($"/compete/{comp.Id}")">Competition page</MudButton>
            </div>
        </BlueprintCard>
    }

    <div style="display:flex;gap:12px;align-items:stretch;flex-wrap:wrap;">
        <!-- Palette -->
        <BlueprintCard Class="pa-3" Style="width:220px;flex:0 0 220px;max-height:560px;overflow:auto;">
            <MudTextField @bind-Value="_search" Placeholder="Search nodes…" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2"
                          OnKeyDown="OnSearchKey" />
            @if (_catalog.Count == 0)
            {
                <MudText Typo="Typo.caption" Style="opacity:.7;">Loading nodes…</MudText>
            }
            @foreach (var category in _categories)
            {
                var nodes = NodesInCategory(category);
                if (nodes.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="koc-heading d-block mt-2 mb-1" Style="letter-spacing:.06em;text-transform:uppercase;opacity:.7;">@category</MudText>
                    @foreach (var n in nodes)
                    {
                        <MudTooltip Text="@n.Description" Placement="Placement.Right">
                            <div class="koc-palette-node" draggable="true" @ondragstart="() => OnDragStart(n.Kind)" @onclick="() => AddNode(n.Kind)">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Style="opacity:.35;margin-right:-2px;" />
                                <MudIcon Icon="@NodeVisuals.Icon(n.Kind, n.Category)" Size="Size.Small" Style="@($"color:{NodeVisuals.Color(n.Category)};")" />
                                <span>@n.DisplayName</span>
                            </div>
                        </MudTooltip>
                    }
                }
            }
        </BlueprintCard>

        <!-- Canvas -->
        <BlueprintCard Style="flex:1 1 420px;min-width:320px;position:relative;min-height:540px;">
            @* tabindex so the canvas can hold focus and receive the shortcuts at all. *@
            <div style="position:absolute;inset:8px;outline:none;" tabindex="0"
                 @onkeydown="OnCanvasKey"
                 @ondragover:preventDefault="true" @ondrop="OnDrop" @ondrop:preventDefault="true">
                <CascadingValue Value="_diagram" IsFixed="true">
                    <DiagramCanvas></DiagramCanvas>
                </CascadingValue>
            </div>
        </BlueprintCard>

        <!-- Properties -->
        <BlueprintCard Class="pa-3" Style="width:320px;flex:0 0 320px;max-height:560px;overflow:auto;">
            <MudText Typo="Typo.overline" Class="mb-2 d-block">Properties</MudText>
            @if (_selected is null)
            {
                <MudText Typo="Typo.body2">Select a node on the canvas to configure it. Your feature-engineering, algorithm and validation choices are what make a pipeline yours.</MudText>
            }
            else
            {
                var def = Get(_selected.Kind);
                <div class="d-flex align-center gap-2 mb-1">
                    <MudIcon Icon="@NodeVisuals.Icon(_selected.Kind, def?.Category ?? "")" Size="Size.Small" Style="@($"color:{NodeVisuals.Color(def?.Category ?? "")};")" />
                    <MudText Typo="Typo.subtitle2" Class="koc-heading"><b>@(def?.DisplayName ?? _selected.Kind)</b></MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="DeleteSelected" aria-label="Delete node" />
                </div>
                @if (def is not null)
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-3" Style="opacity:.75;">@def.Description</MudText>
                }

                @* In a competition the source is the host's data, not one of your datasets — so the Dataset
                   node shows the actual files it will run on instead of an empty picker. *@
                @if (_competition is { } dsComp && _selected.Kind == "dataset")
                {
                    <div class="mb-2" style="border:1px solid var(--koc-divider);border-radius:6px;padding:10px;">
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.caption" Class="koc-heading">Competition data</MudText>
                        </div>
                        @if (_competitionTrainingCsv is null)
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.7;">Loading the host's files…</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                <b>training.csv</b> · @CsvRowCount(_competitionTrainingCsv) rows × @_columns.Count columns
                            </MudText>
                            <MudText Typo="Typo.caption" Class="d-block" Style="opacity:.75;">
                                <b>evaluation.csv</b> · @(_competitionEvalCsv is null ? "—" : $"{CsvRowCount(_competitionEvalCsv)} rows") — scored on submit, never shown to your graph while training.
                            </MudText>
                            <MudText Typo="Typo.caption" Class="d-block mt-1" Style="opacity:.7;">
                                Target <code>@dsComp.LabelColumn</code> · id <code>@dsComp.IdColumn</code> — fixed by the host.
                            </MudText>
                        }
                    </div>
                }
                else
                {
                    @* Task = the graph's effective task (the Train node's, else the fallback) so a node without a
                       task field of its own — Cross-validate — still offers only the trainers that apply. *@
                    <NodePropertyPanel Descriptor="def" Config="_selected.Config" Datasets="_fileDatasets" AvailableColumns="_columns" Task="@EffectiveTask()" LockedKeys="@(_selected.Kind == "train" ? _lockedKeys : [])" OnChanged="OnNodeChanged" />
                }

                @* The node's own problem, next to the node. A list above the log leaves someone matching
                   a sentence against a canvas. *@
                @if (IssueFor(_selected.NodeId) is { } nodeIssue)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mt-3">@nodeIssue</MudAlert>
                }

                @* What this node did to the data on the last run. Kept per node so a wrong metric can
                   be traced to the step that caused it rather than deduced from the log. *@
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.caption" Class="koc-heading d-block mb-1" Style="letter-spacing:.06em;text-transform:uppercase;opacity:.7;">Data</MudText>
                <DataPreview Result="@ResultFor(_selected.NodeId)" />
            }
        </BlueprintCard>
    </div>

    @* One log pane below the designer — every run, submission, validation issue, and save is logged here.
       The run/submit actions live in the top toolbar; the data source is the Dataset node. *@
    <BlueprintCard Class="pa-3 mt-3">
        <div class="d-flex align-center mb-2">
            <MudText Typo="Typo.subtitle1" Class="koc-heading">Log</MudText>
            @if (_registryCompetitionId is not null)
            {
                <MudText Typo="Typo.caption" Class="ml-3" Style="opacity:.7;">Submit trains &amp; scores your graph on the competition's hidden test set.</MudText>
            }
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Runs.ClearLog())" Disabled="@(Runs.Log.Count == 0)">Clear</MudButton>
        </div>
        @{
            var issues = GraphIssues();
        }
        @if (issues.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-2">
                <ul class="pl-4 my-0" style="list-style:disc;">
                    @foreach (var issue in issues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            </MudAlert>
        }
        <div style="max-height:260px;overflow:auto;font-family:monospace;font-size:.82rem;line-height:1.55;">
            @if (Runs.Log.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="opacity:.6;">Run the pipeline or submit to see the log here.</MudText>
            }
            else
            {
                @foreach (var entry in Enumerable.Reverse(Runs.Log))
                {
                    <div style="@($"color:{LogColor(entry.Level)};")">
                        <span style="opacity:.5;">@entry.At.ToString("HH:mm:ss")</span> @entry.Message
                    </div>
                }
            }
        </div>
    </BlueprintCard>
}

@code {
    private static readonly JsonSerializerOptions _json = new(JsonSerializerDefaults.Web);

    private BlazorDiagram _diagram = null!;
    private MlNode? _selected;
    private string _search = "";
    private string? _dragKind;
    private double _nextX = 40;
    private int _seedRow;

    private Guid? _registryCompetitionId;
    private string? _registryCompetitionTitle;
    private CompetitionDto? _competition;
    private IReadOnlyList<string> _lockedKeys = [];

    // The host's files, fetched once when the workflow targets a competition: the training CSV is what Run
    // executes on (and where the column pickers get their names), the evaluation CSV is shown for context.
    private string? _competitionTrainingCsv;
    private string? _competitionEvalCsv;

    // Registry-edit mode: the designer is editing a versioned workflow from /workflows.
    [Parameter] public Guid? WorkflowId { get; set; }
    private bool _registryMode;
    private Guid? _loadedWorkflowId;
    private string _registryName = "";
    private int _registryVersion = 1;
    private string _registryStatus = "draft";
    private bool _registryBusy;
    private bool _loaded;                       // true once the graph has finished loading (gates auto-save)
    private CancellationTokenSource? _autoSaveCts;

    // Fallbacks only — the run reads the target/task from the Train node (see EffectiveLabel/EffectiveTask).
    private readonly string _labelColumn = "label";
    private readonly string _task = "BinaryClassification";
    private bool _running;

    private IReadOnlyList<DatasetDto> _fileDatasets = [];
    private IReadOnlyList<string> _columns = [];

    // The node palette + property schema are served by the backend registry (GET /api/v1/ml/nodes),
    // so a new server-side handler shows up here with no client change.
    private IReadOnlyList<NodeDescriptorDto> _catalog = [];
    private Dictionary<string, NodeDescriptorDto> _catalogByKind = new(StringComparer.Ordinal);
    private IReadOnlyList<string> _categories = [];

    private bool _submitting;

    protected override void OnInitialized()
    {
        _diagram = new BlazorDiagram();
        _diagram.SelectionChanged += OnSelectionChanged;
        // Persist when the user connects or removes links (drawn directly on the canvas, not via Connect()).
        _diagram.Links.Added += OnLinkChanged;
        _diagram.Links.Removed += OnLinkChanged;
    }

    private void OnLinkChanged(Blazor.Diagrams.Core.Models.Base.BaseLinkModel _) => ScheduleAutoSave();

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalog();
        await LoadDatasets();
    }

    private async Task LoadCatalog()
    {
        try
        {
            _catalog = await Api.GetMlNodesAsync();
        }
        catch
        {
            _catalog = [];
        }

        _catalogByKind = _catalog.ToDictionary(n => n.Kind, StringComparer.Ordinal);
        _categories = _catalog.Select(n => n.Category).Distinct()
            .OrderBy(NodeVisuals.Order).ThenBy(c => c, StringComparer.Ordinal).ToList();
    }

    private NodeDescriptorDto? Get(string kind) => _catalogByKind.GetValueOrDefault(kind);

    private List<NodeDescriptorDto> NodesInCategory(string category) =>
        _catalog.Where(n => n.Category == category && MatchesSearch(n)).ToList();

    private async Task LoadDatasets()
    {
        try
        {
            _fileDatasets = (await Api.GetDatasetsAsync()).Where(d => d.HasFile).ToList();
        }
        catch
        {
            _fileDatasets = [];
        }
    }

    // Lightweight client-side graph check (mirrors the server compiler's core rules) so users get inline
    // guidance before running/submitting instead of a round-trip failure. The server compile stays authoritative.
    private List<string> GraphIssues()
    {
        var issues = new List<string>();
        var nodes = _diagram.Nodes.OfType<MlNode>().ToList();
        if (nodes.Count == 0)
        {
            issues.Add("The canvas is empty — add a Dataset node and a model.");
            return issues;
        }

        if (!nodes.Any(n => n.Kind == "dataset"))
        {
            issues.Add("Add a Dataset node — every pipeline needs a data source.");
        }

        if (!nodes.Any(n => n.Kind is "train" or "cluster"))
        {
            issues.Add("Add a Train (or Cluster) node — the pipeline needs a model.");
        }

        // Single chain: each node has at most one incoming and one outgoing link (join/union bring the second
        // dataset via config, not an extra edge) — mirrors WorkflowCompiler's fan-in/fan-out rejection.
        var outCount = new Dictionary<string, int>(StringComparer.Ordinal);
        var inCount = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var link in _diagram.Links)
        {
            if ((link.Source as SinglePortAnchor)?.Port?.Parent is MlNode s && (link.Target as SinglePortAnchor)?.Port?.Parent is MlNode d)
            {
                outCount[s.NodeId] = outCount.GetValueOrDefault(s.NodeId) + 1;
                inCount[d.NodeId] = inCount.GetValueOrDefault(d.NodeId) + 1;
            }
        }

        if (outCount.Values.Any(v => v > 1) || inCount.Values.Any(v => v > 1))
        {
            issues.Add("Connect the nodes in a single chain — one input and one output per node.");
        }

        if (_competition is null && DatasetNodeId() is null)
        {
            issues.Add("Pick a training dataset on the Dataset node.");
        }

        issues.AddRange(NodeIssues().Select(i => i.Message));
        return issues;
    }

    /// <summary>
    /// Problems that belong to one node, so the property panel can say what is wrong with the node
    /// someone is looking at rather than leaving them to match a line in a list against a canvas.
    /// </summary>
    private List<(string NodeId, string Message)> NodeIssues()
    {
        var found = new List<(string, string)>();
        var nodes = _diagram.Nodes.OfType<MlNode>().ToList();

        // Which nodes are upstream of each node, following the single chain the compiler enforces.
        var upstream = new Dictionary<string, List<MlNode>>(StringComparer.Ordinal);
        var incoming = new Dictionary<string, MlNode>(StringComparer.Ordinal);
        foreach (var link in _diagram.Links)
        {
            if ((link.Source as SinglePortAnchor)?.Port?.Parent is MlNode s
                && (link.Target as SinglePortAnchor)?.Port?.Parent is MlNode d)
            {
                incoming[d.NodeId] = s;
            }
        }

        foreach (var node in nodes)
        {
            var chain = new List<MlNode>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var current = node.NodeId;
            while (incoming.TryGetValue(current, out var previous) && seen.Add(previous.NodeId))
            {
                chain.Add(previous);
                current = previous.NodeId;
            }

            upstream[node.NodeId] = chain;
        }

        // The leakage guard, and the rule people hit most. Fitting a supervised model on data that was
        // never split means the score is measured on rows the model already saw — a number that looks
        // good and means nothing. It used to surface at publish time, which is after you have already
        // reasoned about it.
        foreach (var train in nodes.Where(n => n.Kind == "train"))
        {
            var hasSplit = upstream[train.NodeId].Any(n => n.Kind is "split" or "time-split" or "cross-validate");
            if (!hasSplit)
            {
                found.Add((train.NodeId,
                    "Add a Split before this Train node — without one it is scored on the same rows it learned from, "
                    + "which flatters the result."));
            }
        }

        foreach (var node in nodes.Where(n => n.Kind != "dataset" && !incoming.ContainsKey(n.NodeId)))
        {
            found.Add((node.NodeId, $"This {node.Kind} node has nothing connected to it, so it will not run."));
        }

        return found;
    }

    private string? IssueFor(string nodeId) =>
        NodeIssues().FirstOrDefault(i => i.NodeId == nodeId).Message;

    // The Dataset node's selected dataset id (the pipeline's data source), or null if none/unset.
    private Guid? DatasetNodeId() =>
        _diagram.Nodes.OfType<MlNode>().FirstOrDefault(n => n.Kind == "dataset") is { } d
        && d.Config.TryGetValue("datasetId", out var v) && Guid.TryParse(v, out var id) ? id : null;

    // The host's training + evaluation CSVs for a competition-targeted workflow. Fetched once per load; the
    // training header is the graph's column vocabulary, so every Column/Columns picker works exactly as it
    // does for a personal dataset.
    private async Task LoadCompetitionDataAsync()
    {
        _competitionTrainingCsv = _competitionEvalCsv = null;
        if (_competition is not { HasDatasets: true } comp)
        {
            return;
        }

        try
        {
            _competitionTrainingCsv = await Api.GetCompetitionDataAsync(comp.Id, "training");
            _competitionEvalCsv = await Api.GetCompetitionDataAsync(comp.Id, "evaluation");
        }
        catch
        {
            // Leave them null — the Dataset node says the files couldn't be read and Run reports it.
        }
    }

    // Column names from a CSV's header row.
    private static IReadOnlyList<string> CsvHeader(string csv)
    {
        using var reader = new StringReader(csv);
        var line = reader.ReadLine();
        return line is null ? [] : [.. line.Split(',').Select(c => c.Trim().Trim('"')).Where(c => c.Length > 0)];
    }

    // Data rows in a CSV (header excluded) — shown on the Dataset node so the host's data isn't a black box.
    private static int CsvRowCount(string csv) =>
        Math.Max(0, csv.Split('\n').Count(l => !string.IsNullOrWhiteSpace(l)) - 1);

    // Load the Dataset node's column names so Column/Columns fields become pickers instead of text boxes.
    private async Task LoadColumns()
    {
        // In a competition the columns come from the host's training file, not a dataset the user picked.
        if (_competitionTrainingCsv is { } csv)
        {
            _columns = CsvHeader(csv);
            return;
        }

        if (DatasetNodeId() is not { } id)
        {
            _columns = [];
            return;
        }

        try
        {
            var versions = await Api.GetDatasetVersionsAsync(id);
            var latest = versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
            var detail = latest is null ? null : await Api.GetDatasetVersionAsync(id, latest.VersionNumber);
            _columns = detail?.Schema.OrderBy(s => s.Ordinal).Select(s => s.ColumnName).ToList() ?? [];
        }
        catch
        {
            _columns = [];
        }
    }

    // After any node-config edit, refresh the column list (the Dataset node may have changed), re-render, and
    // persist — so picking a dataset / target / task is remembered without a manual save.
    private async Task OnNodeChanged()
    {
        await LoadColumns();
        StateHasChanged();
        ScheduleAutoSave();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (WorkflowId is { } id)
        {
            if (_loadedWorkflowId != id)
            {
                await LoadRegistryWorkflow(id);
            }
        }
        else
        {
            // The designer is always a workflow — no id means go back to the library.
            Nav.NavigateTo("/workflows");
        }
    }

    public void Dispose()
    {
        _diagram.SelectionChanged -= OnSelectionChanged;
        _diagram.Links.Added -= OnLinkChanged;
        _diagram.Links.Removed -= OnLinkChanged;
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
    }

    // ---- Registry workflow (versioned) ----

    private async Task LoadRegistryWorkflow(Guid id)
    {
        var detail = await Api.GetWorkflowDetailAsync(id);
        if (detail is null)
        {
            Snackbar.Add("Workflow not found.", Severity.Error);
            return;
        }

        var latest = detail.Versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
        _registryMode = true;
        _selected = null;
        _loadedWorkflowId = id;
        _registryName = detail.Name;
        _registryVersion = latest?.VersionNumber ?? 1;
        _registryStatus = latest?.Status ?? "draft";
        _registryCompetitionId = detail.CompetitionId;
        _competition = detail.CompetitionId is { } cid
            ? (await Api.GetCompetitionsAsync()).FirstOrDefault(c => c.Id == cid)
            : null;
        _registryCompetitionTitle = _competition?.Title;
        await LoadCompetitionDataAsync();

        var json = "{}";
        if (latest is not null)
        {
            var version = await Api.GetWorkflowVersionAsync(id, latest.VersionNumber);
            json = version?.DefinitionJson ?? "{}";
        }

        LoadDefinition(json);
        ApplyCompetitionDefaults();
        SeedDatasetNodeDefault();
        await LoadColumns();
        _loaded = true;

        // A fresh workflow starts its own history and its own run results. Carrying either across would
        // let Ctrl+Z restore a graph from a different workflow, and show one workflow's rows under
        // another's nodes.
        _history.Reset(JsonSerializer.Serialize(BuildDefinition(), _json));
        Runs.Reset();

        StateHasChanged();
    }

    // Auto-save: persist the graph shortly after any edit so the workflow always remembers what the user built
    // (dataset, target, task, structure) without a manual "Save draft". Debounced so rapid edits collapse to
    // one save. Gated on _loaded so the initial load/seed doesn't write.
    private void ScheduleAutoSave()
    {
        if (!_loaded || _loadedWorkflowId is null)
        {
            return;
        }

        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveCts = new CancellationTokenSource();
        var token = _autoSaveCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(900, token);
                await InvokeAsync(async () =>
                {
                    if (!token.IsCancellationRequested)
                    {
                        // Same debounce as the save, deliberately: typing a value is one undo entry
                        // rather than one per keystroke, and it is already the point where the graph
                        // has settled.
                        RecordHistory();
                        await AutoSaveDraftAsync();
                    }
                });
            }
            catch (OperationCanceledException)
            {
                // superseded by a newer edit
            }
        });
    }

    private async Task AutoSaveDraftAsync()
    {
        if (_loadedWorkflowId is not { } id || _registryBusy)
        {
            return;
        }

        try
        {
            var json = JsonSerializer.Serialize(BuildDefinition(), _json);
            var (version, error) = await Api.SaveWorkflowDraftAsync(id, new SaveDraftRequest(json, null));
            if (error is null && version is not null)
            {
                _registryVersion = version.VersionNumber;
                _registryStatus = version.Status;
                Log("info", $"Saved draft v{version.VersionNumber}.");
                StateHasChanged();
            }
        }
        catch
        {
            // Silent — an explicit Save surfaces errors; a transient auto-save failure shouldn't nag.
        }
    }

    // Free mode convenience: if the Dataset node has no dataset yet, default it to the user's first dataset so
    // the graph is runnable and column pickers light up. In a competition the data is the host's — leave empty.
    private void SeedDatasetNodeDefault()
    {
        if (_competition is not null || _fileDatasets.Count == 0)
        {
            return;
        }

        foreach (var node in _diagram.Nodes.OfType<MlNode>().Where(n => n.Kind == "dataset"))
        {
            if (!node.Config.TryGetValue("datasetId", out var v) || string.IsNullOrWhiteSpace(v))
            {
                node.Config["datasetId"] = _fileDatasets[0].Id.ToString();
            }
        }
    }

    // In a competition the target/id/task are fixed by the host — pre-fill them on the Train node and lock
    // them so the user can't change what the server will enforce anyway. In free mode they stay editable.
    private void ApplyCompetitionDefaults()
    {
        if (_competition is not { } c)
        {
            _lockedKeys = [];
            return;
        }

        foreach (var node in _diagram.Nodes.OfType<MlNode>().Where(n => n.Kind == "train"))
        {
            node.Config["targetColumn"] = c.LabelColumn;
            node.Config["task"] = string.IsNullOrWhiteSpace(c.TaskType) ? "BinaryClassification" : c.TaskType;
            if (!string.IsNullOrWhiteSpace(c.IdColumn))
            {
                node.Config["idColumn"] = c.IdColumn;
            }
        }

        _lockedKeys = ["targetColumn", "idColumn", "task"];
    }

    private async Task SaveRegistryDraft()
    {
        if (_loadedWorkflowId is not { } id)
        {
            return;
        }

        _registryBusy = true;
        try
        {
            var json = JsonSerializer.Serialize(BuildDefinition(), _json);
            var (version, error) = await Api.SaveWorkflowDraftAsync(id, new SaveDraftRequest(json, null));
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Warning);
                return;
            }

            _registryVersion = version!.VersionNumber;
            _registryStatus = version.Status;
            Snackbar.Add($"Draft saved (v{version.VersionNumber}).", Severity.Success);
        }
        finally
        {
            _registryBusy = false;
        }
    }

    private async Task PublishRegistry()
    {
        if (_loadedWorkflowId is not { } id)
        {
            return;
        }

        _registryBusy = true;
        try
        {
            // Capture the current canvas as a draft, then freeze it (the API runs the compiler +
            // split-before-fit check and rejects a leaky graph).
            var json = JsonSerializer.Serialize(BuildDefinition(), _json);
            var (version, saveError) = await Api.SaveWorkflowDraftAsync(id, new SaveDraftRequest(json, null));
            if (saveError is not null)
            {
                Snackbar.Add(saveError, Severity.Warning);
                return;
            }

            var publishError = await Api.PublishWorkflowVersionAsync(id, version!.VersionNumber);
            Snackbar.Add(publishError ?? $"Published v{version.VersionNumber}.", publishError is null ? Severity.Success : Severity.Warning);
            if (publishError is null)
            {
                _registryVersion = version.VersionNumber;
                _registryStatus = "published";
            }
        }
        finally
        {
            _registryBusy = false;
        }
    }

    // ---- Undo / redo ----

    private readonly GraphHistory _history = new();

    // Set while an undo or redo is rebuilding the canvas: the rebuild fires the same change events a
    // user edit does, and recording those would push the state we just restored back onto the stack.
    private bool _restoring;

    private void RecordHistory()
    {
        if (_restoring || !_loaded)
        {
            return;
        }

        _history.Record(JsonSerializer.Serialize(BuildDefinition(), _json));
    }

    private void Undo() => Restore(_history.Undo());

    private void Redo() => Restore(_history.Redo());

    private void Restore(string? snapshot)
    {
        if (snapshot is null)
        {
            return;
        }

        _restoring = true;
        try
        {
            LoadDefinition(snapshot);
            _selected = null;
        }
        finally
        {
            _restoring = false;
        }

        StateHasChanged();
        ScheduleAutoSave();
    }

    /// <summary>Ctrl+Z and Ctrl+Y over the canvas area.</summary>
    private void OnCanvasKey(KeyboardEventArgs e)
    {
        if (!e.CtrlKey && !e.MetaKey)
        {
            return;
        }

        if (e.Key is "z" or "Z")
        {
            Undo();
        }
        else if (e.Key is "y" or "Y")
        {
            Redo();
        }
    }

    // ---- Canvas load/save ----

    private void LoadDefinition(string json)
    {
        _diagram.Nodes.Clear();
        _diagram.Links.Clear();
        _nextX = 40;
        _seedRow = 0;

        WorkflowDefinition? def = null;
        try { def = JsonSerializer.Deserialize<WorkflowDefinition>(json, _json); } catch { /* fall through to starter */ }

        if (def is null || def.Nodes.Count == 0)
        {
            SeedStarter();
            return;
        }

        var map = new Dictionary<string, MlNode>(StringComparer.Ordinal);
        foreach (var wn in def.Nodes)
        {
            var x = wn.Config is not null && wn.Config.TryGetValue("_x", out var xs) && double.TryParse(xs, NumberStyles.Any, CultureInfo.InvariantCulture, out var xv) ? xv : _nextX;
            var y = wn.Config is not null && wn.Config.TryGetValue("_y", out var ys) && double.TryParse(ys, NumberStyles.Any, CultureInfo.InvariantCulture, out var yv) ? yv : 60;
            var node = PlaceNode(wn.Id, wn.Kind, x, y);
            if (wn.Config is not null)
            {
                foreach (var kv in wn.Config.Where(kv => kv.Key is not ("_x" or "_y")))
                {
                    node.Config[kv.Key] = kv.Value;
                }
            }
            map[wn.Id] = node;
            _nextX = Math.Max(_nextX, x + 170);
        }

        foreach (var e in def.Edges)
        {
            if (map.TryGetValue(e.FromNodeId, out var a) && map.TryGetValue(e.ToNodeId, out var b))
            {
                Connect(a, b);
            }
        }
    }

    private WorkflowDefinition BuildDefinition()
    {
        var nodes = _diagram.Nodes.OfType<MlNode>().Select(n =>
        {
            var cfg = new Dictionary<string, string>(n.Config)
            {
                ["_x"] = n.Position.X.ToString(CultureInfo.InvariantCulture),
                ["_y"] = n.Position.Y.ToString(CultureInfo.InvariantCulture),
            };
            return new WorkflowNode { Id = n.NodeId, Kind = n.Kind, Config = cfg };
        }).ToList();

        var edges = new List<WorkflowEdge>();
        foreach (var link in _diagram.Links)
        {
            if ((link.Source as SinglePortAnchor)?.Port?.Parent is MlNode src && (link.Target as SinglePortAnchor)?.Port?.Parent is MlNode dst)
            {
                edges.Add(new WorkflowEdge(src.NodeId, dst.NodeId));
            }
        }

        var name = _registryMode ? _registryName : "Pipeline";
        return new WorkflowDefinition { Name = name, Nodes = nodes, Edges = edges };
    }

    private void SeedStarter()
    {
        var d = AddNode("dataset");
        var sp = AddNode("split");
        var tr = AddNode("train");
        var ev = AddNode("evaluate");
        Connect(d, sp);
        Connect(sp, tr);
        Connect(tr, ev);
    }

    private MlNode AddNode(string kind)
    {
        var node = PlaceNode("n" + Guid.NewGuid().ToString("N")[..8], kind, _nextX, 60 + (_seedRow++ % 2) * 120);
        _nextX += 170;
        return node;
    }

    private void OnDragStart(string kind) => _dragKind = kind;

    private void OnDrop(Microsoft.AspNetCore.Components.Web.DragEventArgs e)
    {
        if (_dragKind is null)
        {
            return;
        }

        // Convert the drop point to diagram coordinates (accounts for pan/zoom).
        var pt = _diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);
        PlaceNode("n" + Guid.NewGuid().ToString("N")[..8], _dragKind, pt.X, pt.Y);
        _dragKind = null;
    }

    private MlNode PlaceNode(string id, string kind, double x, double y)
    {
        var node = new MlNode(id, kind, new Blazor.Diagrams.Core.Geometry.Point(x, y));
        node.AddPort(PortAlignment.Left);
        node.AddPort(PortAlignment.Right);
        _diagram.Nodes.Add(node);
        ScheduleAutoSave(); // no-op during initial load (gated on _loaded); persists user-added nodes
        return node;
    }

    private void Connect(MlNode a, MlNode b) =>
        _diagram.Links.Add(new LinkModel(a.GetPort(PortAlignment.Right)!, b.GetPort(PortAlignment.Left)!));

    private void DeleteSelected()
    {
        if (_selected is not null)
        {
            _diagram.Nodes.Remove(_selected);
            _selected = null;
            ScheduleAutoSave();
        }
    }

    private void OnSelectionChanged(Blazor.Diagrams.Core.Models.Base.SelectableModel _)
    {
        _selected = _diagram.GetSelectedModels().OfType<MlNode>().FirstOrDefault();
        InvokeAsync(StateHasChanged);
    }

    // The run's label/task come from the Train node when the user set them there (free mode); otherwise the
    // "Run pipeline" box values. In a competition the server enforces its own regardless.
    private string? TrainCfg(string key) =>
        _diagram.Nodes.OfType<MlNode>().FirstOrDefault(n => n.Kind == "train") is { } t
        && t.Config.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : null;

    private string EffectiveLabel() => TrainCfg("targetColumn") ?? _labelColumn;

    private string EffectiveTask() => TrainCfg("task") ?? _task;

    private MlNode? TrainNode() => _diagram.Nodes.OfType<MlNode>().FirstOrDefault(n => n.Kind == "train");

    // The task choices come from the Train node's own `task` lookup in the server catalog, so a task added
    // to the runtime appears in this menu with no client change — the same list the property panel shows.
    private IReadOnlyList<LookupOptionDto> TaskOptions() =>
        Get("train")?.Parameters.FirstOrDefault(p => p.Name == "task")?.Options ?? [];

    private string EffectiveTaskLabel() =>
        TaskOptions().FirstOrDefault(o => o.Value == EffectiveTask())?.Label ?? EffectiveTask();

    // Writes to the Train node — the one place the task is stored — then saves and refreshes so the property
    // panel's task-scoped fields (algorithm list, per-algorithm knobs) follow immediately.
    private async Task SetTask(string value)
    {
        if (TrainNode() is not { } train || string.Equals(EffectiveTask(), value, StringComparison.Ordinal))
        {
            return;
        }

        train.Config["task"] = value;
        await OnNodeChanged();
    }

    private bool MatchesSearch(NodeDescriptorDto n) =>
        string.IsNullOrWhiteSpace(_search)
        || n.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || n.Kind.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || n.Category.Contains(_search, StringComparison.OrdinalIgnoreCase)
        // Descriptions carry the words people actually search for — "missing", "scale", "outlier" —
        // which are rarely in a node's display name.
        || (n.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The node a search is pointing at: the first match in palette order, so what Enter adds is the
    /// one at the top of the list rather than whichever the catalogue happened to yield first.
    /// </summary>
    private NodeDescriptorDto? TopMatch() =>
        string.IsNullOrWhiteSpace(_search)
            ? null
            : _categories.SelectMany(NodesInCategory).FirstOrDefault();

    /// <summary>Enter adds the top match, so a node can be added without leaving the keyboard.</summary>
    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or "NumpadEnter") || TopMatch() is not { } match)
        {
            return;
        }

        AddNode(match.Kind);
        _search = "";
    }

    // ---- Run / submit (actions live in the top toolbar; all output goes to the log pane) ----

    private async Task RunFromDataset()
    {
        // Two sources, one action: a competition runs on the host's training file, a personal workflow on the
        // dataset chosen on the Dataset node. Running before submitting is how you see your metric locally.
        var competitionRun = _competition is not null;
        if (competitionRun && _competitionTrainingCsv is null)
        {
            Log("warning", "The competition's training data couldn't be read — try reloading the page.");
            return;
        }

        if (!competitionRun && DatasetNodeId() is null)
        {
            Log("warning", "Pick a training dataset on the Dataset node first.");
            return;
        }

        _running = true;
        foreach (var n in _diagram.Nodes.OfType<MlNode>())
        {
            n.SetStatus("idle");
        }

        Log("info", competitionRun
            ? $"Running on the competition's training data · target '{EffectiveLabel()}' · {EffectiveTask()} …"
            : $"Running pipeline · target '{EffectiveLabel()}' · {EffectiveTask()} …");
        StateHasChanged();

        try
        {
            if (competitionRun)
            {
                using var csv = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(_competitionTrainingCsv!));
                var result = await Api.ExecuteWorkflowAsync(BuildDefinition(), csv, "training.csv", EffectiveLabel(), EffectiveTask());
                ApplyResult(result);
                Log("info", "This is your local score on the host's training data — Submit scores you on the hidden evaluation set.");
                return;
            }

            var (datasetResult, error) = await Api.ExecuteWorkflowFromDatasetAsync(BuildDefinition(), DatasetNodeId()!.Value, EffectiveLabel(), EffectiveTask());
            if (error is not null)
            {
                Log("error", $"Run failed: {error}");
                return;
            }

            ApplyResult(datasetResult);
        }
        catch (Exception ex)
        {
            Log("error", $"Run failed: {ex.Message}");
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>
    /// The last run's result for one node, or null if it has not run since the page was opened.
    /// <para>
    /// Held in the session rather than in this component, so navigating away and back does not lose
    /// the run someone is in the middle of reading.
    /// </para>
    /// </summary>
    private NodeExecutionResult? ResultFor(string nodeId) => Runs.ResultFor(nodeId);

    // Log each node's execution + the headline metric; set the node's status only for a subtle canvas cue.
    private void ApplyResult(PipelineExecutionResult? result)
    {
        if (result is null)
        {
            return;
        }

        Runs.Record(result);

        var byId = _diagram.Nodes.OfType<MlNode>().ToDictionary(n => n.NodeId);
        foreach (var nr in result.Nodes)
        {
            if (byId.TryGetValue(nr.NodeId, out var node))
            {
                node.SetStatus(nr.Status);
            }

            var level = nr.Status switch { "failed" => "error", "skipped" => "warning", _ => "info" };
            Log(level, $"{nr.Kind}: {nr.Status}{(string.IsNullOrEmpty(nr.Detail) ? "" : $" — {nr.Detail}")}");
        }

        Log(result.Success ? "success" : "error", result.Success
            ? $"Pipeline complete · {result.Algorithm} · {result.PrimaryMetric} {result.PrimaryValue:0.###} · {result.RowCount} rows"
            : "Pipeline failed — see the node messages above.");
    }

    private async Task OnSubmitPipeline(Guid competitionId)
    {
        _submitting = true;
        Log("info", $"Submitting to {_registryCompetitionTitle ?? "the competition"} …");
        StateHasChanged();
        try
        {
            var result = await Api.SubmitPipelineAsync(competitionId, BuildDefinition());
            Log(result is null ? "error" : "success", result is null
                ? "Submission failed — no result returned."
                : $"Submitted — scored {result.Score?.ToString("0.###") ?? "?"}. Your best result is on the leaderboard.");
        }
        catch (Exception ex)
        {
            Log("error", $"Submission failed: {ex.Message}");
        }
        finally
        {
            _submitting = false;
        }
    }

    // ---- Log pane ----

    // The log lives in the session, not here: navigating away used to lose the run you were reading.
    private void Log(string level, string message) => Runs.Add(level, message);

    private static string LogColor(string level) => level switch
    {
        "error" => "var(--mud-palette-error)",
        "warning" => "var(--mud-palette-warning)",
        "success" => "var(--mud-palette-success)",
        _ => "inherit",
    };
}
