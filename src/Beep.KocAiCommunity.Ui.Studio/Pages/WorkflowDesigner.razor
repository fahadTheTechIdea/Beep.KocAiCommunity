@page "/workflow"
@page "/workflow/{WorkflowId:guid}"
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Models
@using Beep.KocAiCommunity.Ui.Studio.Diagrams
@using Beep.KocAiCommunity.Contracts.Workflow
@using Beep.KocAiCommunity.Contracts.Studio
@using Beep.KocAiCommunity.Contracts.Datasets
@using Beep.KocAiCommunity.Contracts.ML
@using Beep.KocAiCommunity.Contracts.Competitions
@using Beep.KocAiCommunity.Client
@using Beep.KocAiCommunity.Ui.Shared.Components
@implements IDisposable
@inject IKocApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Studio · @KocBrand.ProductName</PageTitle>

@if (!_registryMode)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <!-- ===== Node editor ===== -->
    <div class="d-flex align-center gap-2 mb-3 flex-wrap">
        @if (_registryMode)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/workflows">Workflows</MudButton>
            <MudText Typo="Typo.h5" Class="koc-heading">@_registryName</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_registryStatus == "published" ? Color.Success : Color.Info)">v@_registryVersion · @_registryStatus</MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveRegistryDraft" Disabled="_registryBusy">Save draft</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Publish" OnClick="PublishRegistry" Disabled="_registryBusy">Publish</MudButton>
        }
    </div>

    <div style="display:flex;gap:12px;align-items:stretch;flex-wrap:wrap;">
        <!-- Palette -->
        <BlueprintCard Class="pa-3" Style="width:220px;flex:0 0 220px;max-height:560px;overflow:auto;">
            <MudTextField @bind-Value="_search" Placeholder="Search nodes…" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
            @if (_catalog.Count == 0)
            {
                <MudText Typo="Typo.caption" Style="opacity:.7;">Loading nodes…</MudText>
            }
            @foreach (var category in _categories)
            {
                var nodes = NodesInCategory(category);
                if (nodes.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="koc-heading d-block mt-2 mb-1" Style="letter-spacing:.06em;text-transform:uppercase;opacity:.7;">@category</MudText>
                    @foreach (var n in nodes)
                    {
                        <MudTooltip Text="@n.Description" Placement="Placement.Right">
                            <div class="koc-palette-node" draggable="true" @ondragstart="() => OnDragStart(n.Kind)" @onclick="() => AddNode(n.Kind)">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Style="opacity:.35;margin-right:-2px;" />
                                <MudIcon Icon="@NodeVisuals.Icon(n.Kind, n.Category)" Size="Size.Small" Style="@($"color:{NodeVisuals.Color(n.Category)};")" />
                                <span>@n.DisplayName</span>
                            </div>
                        </MudTooltip>
                    }
                }
            }
        </BlueprintCard>

        <!-- Canvas -->
        <BlueprintCard Style="flex:1 1 420px;min-width:320px;position:relative;min-height:540px;">
            <div style="position:absolute;inset:8px;" @ondragover:preventDefault="true" @ondrop="OnDrop" @ondrop:preventDefault="true">
                <CascadingValue Value="_diagram" IsFixed="true">
                    <DiagramCanvas></DiagramCanvas>
                </CascadingValue>
            </div>
        </BlueprintCard>

        <!-- Properties -->
        <BlueprintCard Class="pa-3" Style="width:320px;flex:0 0 320px;max-height:560px;overflow:auto;">
            <MudText Typo="Typo.overline" Class="mb-2 d-block">Properties</MudText>
            @if (_selected is null)
            {
                <MudText Typo="Typo.body2">Select a node on the canvas to configure it. Your feature-engineering, algorithm and validation choices are what make a pipeline yours.</MudText>
            }
            else
            {
                var def = Get(_selected.Kind);
                <div class="d-flex align-center gap-2 mb-1">
                    <MudIcon Icon="@NodeVisuals.Icon(_selected.Kind, def?.Category ?? "")" Size="Size.Small" Style="@($"color:{NodeVisuals.Color(def?.Category ?? "")};")" />
                    <MudText Typo="Typo.subtitle2" Class="koc-heading"><b>@(def?.DisplayName ?? _selected.Kind)</b></MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="DeleteSelected" aria-label="Delete node" />
                </div>
                @if (def is not null)
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-3" Style="opacity:.75;">@def.Description</MudText>
                }

                <NodePropertyPanel Descriptor="def" Config="_selected.Config" Datasets="_fileDatasets" AvailableColumns="_columns" Task="_task" LockedKeys="@(_selected.Kind == "train" ? _lockedKeys : [])" OnChanged="OnNodeChanged" />
            }
        </BlueprintCard>
    </div>

    <MudGrid Spacing="6" Class="mt-2">
        <MudItem xs="12" md="5">
            <BlueprintCard Class="pa-5">
                <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">Run pipeline</MudText>
                <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.8;max-width:60ch;">
                    Runs your graph on the <b>Dataset</b> node's data, using the target column and task set on the
                    <b>Train</b> node. Pick those on the nodes, not here.
                </MudText>
                @{
                    var issues = GraphIssues();
                }
                @if (issues.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-2">
                        <ul class="pl-4 my-0" style="list-style:disc;">
                            @foreach (var issue in issues)
                            {
                                <li>@issue</li>
                            }
                        </ul>
                    </MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@(_running || issues.Count > 0)" OnClick="RunFromDataset">Run pipeline</MudButton>
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.caption" Class="d-block mb-1" Style="opacity:.8;">Or run a one-off CSV:</MudText>
                <InputFile OnChange="OnRun" accept=".csv" />
                @if (_running)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-2" />
                }
            </BlueprintCard>
        </MudItem>

        <MudItem xs="12" md="7">
            <BlueprintCard Class="pa-0">
                <div class="pa-4"><MudText Typo="Typo.subtitle1" Class="koc-heading">Node-by-node execution</MudText></div>
                @if (_result is null)
                {
                    <MudText Typo="Typo.body2" Class="pa-4">Build a pipeline and run it to see each node execute.</MudText>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var n in _result.Nodes)
                        {
                            <MudListItem T="string" Icon="@StatusIcon(n.Status)" IconColor="@StatusColor(n.Status)">
                                <b>@n.Kind</b> — @n.Detail
                            </MudListItem>
                        }
                    </MudList>
                    @if (_result.Success)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="ma-3">
                            Pipeline complete · @_result.Algorithm · @_result.PrimaryMetric @_result.PrimaryValue.ToString("0.###")
                        </MudAlert>
                    }
                }
            </BlueprintCard>
        </MudItem>
    </MudGrid>

    @if (_registryCompetitionId is { } compId)
    {
        <BlueprintCard Class="pa-5 mt-4">
            <MudText Typo="Typo.subtitle1" Class="koc-heading mb-1">Submit to @(_registryCompetitionTitle ?? "the competition")</MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="max-width:70ch;">
                The server trains and scores your exact node graph on the competition's <b>hidden test set</b> — the same
                data for everyone — so only your modelling choices move your rank.
            </MudText>
            @{
                var submitIssues = GraphIssues();
            }
            @if (submitIssues.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-2">
                    <ul class="pl-4 my-0" style="list-style:disc;">
                        @foreach (var issue in submitIssues)
                        {
                            <li>@issue</li>
                        }
                    </ul>
                </MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EmojiEvents"
                       OnClick="() => OnSubmitPipeline(compId)" Disabled="@(_submitting || submitIssues.Count > 0)">Train &amp; submit</MudButton>
            @if (_submitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
            }
            @if (_submissionResult is not null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="mt-3">
                    Scored <b>@_submissionResult.Score?.ToString("0.###")</b> — your best result is on the leaderboard.
                </MudAlert>
            }
            @if (_submitError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mt-3">@_submitError</MudAlert>
            }
        </BlueprintCard>
    }
}

@code {
    private static readonly JsonSerializerOptions _json = new(JsonSerializerDefaults.Web);

    private BlazorDiagram _diagram = null!;
    private MlNode? _selected;
    private string _search = "";
    private string? _dragKind;
    private double _nextX = 40;
    private int _seedRow;

    private Guid? _registryCompetitionId;
    private string? _registryCompetitionTitle;
    private CompetitionDto? _competition;
    private IReadOnlyList<string> _lockedKeys = [];

    // Registry-edit mode: the designer is editing a versioned workflow from /workflows.
    [Parameter] public Guid? WorkflowId { get; set; }
    private bool _registryMode;
    private Guid? _loadedWorkflowId;
    private string _registryName = "";
    private int _registryVersion = 1;
    private string _registryStatus = "draft";
    private bool _registryBusy;

    // Fallbacks only — the run reads the target/task from the Train node (see EffectiveLabel/EffectiveTask).
    private readonly string _labelColumn = "label";
    private readonly string _task = "BinaryClassification";
    private bool _running;
    private PipelineExecutionResult? _result;

    private IReadOnlyList<DatasetDto> _fileDatasets = [];
    private IReadOnlyList<string> _columns = [];

    // The node palette + property schema are served by the backend registry (GET /api/v1/ml/nodes),
    // so a new server-side handler shows up here with no client change.
    private IReadOnlyList<NodeDescriptorDto> _catalog = [];
    private Dictionary<string, NodeDescriptorDto> _catalogByKind = new(StringComparer.Ordinal);
    private IReadOnlyList<string> _categories = [];

    private bool _submitting;
    private SubmissionResultDto? _submissionResult;
    private string? _submitError;

    protected override void OnInitialized()
    {
        _diagram = new BlazorDiagram();
        _diagram.SelectionChanged += OnSelectionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalog();
        await LoadDatasets();
    }

    private async Task LoadCatalog()
    {
        try
        {
            _catalog = await Api.GetMlNodesAsync();
        }
        catch
        {
            _catalog = [];
        }

        _catalogByKind = _catalog.ToDictionary(n => n.Kind, StringComparer.Ordinal);
        _categories = _catalog.Select(n => n.Category).Distinct()
            .OrderBy(NodeVisuals.Order).ThenBy(c => c, StringComparer.Ordinal).ToList();
    }

    private NodeDescriptorDto? Get(string kind) => _catalogByKind.GetValueOrDefault(kind);

    private List<NodeDescriptorDto> NodesInCategory(string category) =>
        _catalog.Where(n => n.Category == category && MatchesSearch(n)).ToList();

    private async Task LoadDatasets()
    {
        try
        {
            _fileDatasets = (await Api.GetDatasetsAsync()).Where(d => d.HasFile).ToList();
        }
        catch
        {
            _fileDatasets = [];
        }
    }

    // Lightweight client-side graph check (mirrors the server compiler's core rules) so users get inline
    // guidance before running/submitting instead of a round-trip failure. The server compile stays authoritative.
    private List<string> GraphIssues()
    {
        var issues = new List<string>();
        var nodes = _diagram.Nodes.OfType<MlNode>().ToList();
        if (nodes.Count == 0)
        {
            issues.Add("The canvas is empty — add a Dataset node and a model.");
            return issues;
        }

        if (!nodes.Any(n => n.Kind == "dataset"))
        {
            issues.Add("Add a Dataset node — every pipeline needs a data source.");
        }

        if (!nodes.Any(n => n.Kind is "train" or "cluster"))
        {
            issues.Add("Add a Train (or Cluster) node — the pipeline needs a model.");
        }

        // Single chain: each node has at most one incoming and one outgoing link (join/union bring the second
        // dataset via config, not an extra edge) — mirrors WorkflowCompiler's fan-in/fan-out rejection.
        var outCount = new Dictionary<string, int>(StringComparer.Ordinal);
        var inCount = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var link in _diagram.Links)
        {
            if ((link.Source as SinglePortAnchor)?.Port?.Parent is MlNode s && (link.Target as SinglePortAnchor)?.Port?.Parent is MlNode d)
            {
                outCount[s.NodeId] = outCount.GetValueOrDefault(s.NodeId) + 1;
                inCount[d.NodeId] = inCount.GetValueOrDefault(d.NodeId) + 1;
            }
        }

        if (outCount.Values.Any(v => v > 1) || inCount.Values.Any(v => v > 1))
        {
            issues.Add("Connect the nodes in a single chain — one input and one output per node.");
        }

        if (_competition is null && DatasetNodeId() is null)
        {
            issues.Add("Pick a training dataset on the Dataset node.");
        }

        return issues;
    }

    // The Dataset node's selected dataset id (the pipeline's data source), or null if none/unset.
    private Guid? DatasetNodeId() =>
        _diagram.Nodes.OfType<MlNode>().FirstOrDefault(n => n.Kind == "dataset") is { } d
        && d.Config.TryGetValue("datasetId", out var v) && Guid.TryParse(v, out var id) ? id : null;

    // Load the Dataset node's column names so Column/Columns fields become pickers instead of text boxes.
    private async Task LoadColumns()
    {
        if (DatasetNodeId() is not { } id)
        {
            _columns = [];
            return;
        }

        try
        {
            var versions = await Api.GetDatasetVersionsAsync(id);
            var latest = versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
            var detail = latest is null ? null : await Api.GetDatasetVersionAsync(id, latest.VersionNumber);
            _columns = detail?.Schema.OrderBy(s => s.Ordinal).Select(s => s.ColumnName).ToList() ?? [];
        }
        catch
        {
            _columns = [];
        }
    }

    // After any node-config edit, refresh the column list (the Dataset node may have changed) and re-render.
    private async Task OnNodeChanged()
    {
        await LoadColumns();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (WorkflowId is { } id)
        {
            if (_loadedWorkflowId != id)
            {
                await LoadRegistryWorkflow(id);
            }
        }
        else
        {
            // The designer is always a workflow — no id means go back to the library.
            Nav.NavigateTo("/workflows");
        }
    }

    public void Dispose() => _diagram.SelectionChanged -= OnSelectionChanged;

    // ---- Registry workflow (versioned) ----

    private async Task LoadRegistryWorkflow(Guid id)
    {
        var detail = await Api.GetWorkflowDetailAsync(id);
        if (detail is null)
        {
            Snackbar.Add("Workflow not found.", Severity.Error);
            return;
        }

        var latest = detail.Versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
        _registryMode = true;
        _selected = null;
        _result = null;
        _loadedWorkflowId = id;
        _registryName = detail.Name;
        _registryVersion = latest?.VersionNumber ?? 1;
        _registryStatus = latest?.Status ?? "draft";
        _registryCompetitionId = detail.CompetitionId;
        _competition = detail.CompetitionId is { } cid
            ? (await Api.GetCompetitionsAsync()).FirstOrDefault(c => c.Id == cid)
            : null;
        _registryCompetitionTitle = _competition?.Title;

        var json = "{}";
        if (latest is not null)
        {
            var version = await Api.GetWorkflowVersionAsync(id, latest.VersionNumber);
            json = version?.DefinitionJson ?? "{}";
        }

        LoadDefinition(json);
        ApplyCompetitionDefaults();
        SeedDatasetNodeDefault();
        await LoadColumns();
        StateHasChanged();
    }

    // Free mode convenience: if the Dataset node has no dataset yet, default it to the user's first dataset so
    // the graph is runnable and column pickers light up. In a competition the data is the host's — leave empty.
    private void SeedDatasetNodeDefault()
    {
        if (_competition is not null || _fileDatasets.Count == 0)
        {
            return;
        }

        foreach (var node in _diagram.Nodes.OfType<MlNode>().Where(n => n.Kind == "dataset"))
        {
            if (!node.Config.TryGetValue("datasetId", out var v) || string.IsNullOrWhiteSpace(v))
            {
                node.Config["datasetId"] = _fileDatasets[0].Id.ToString();
            }
        }
    }

    // In a competition the target/id/task are fixed by the host — pre-fill them on the Train node and lock
    // them so the user can't change what the server will enforce anyway. In free mode they stay editable.
    private void ApplyCompetitionDefaults()
    {
        if (_competition is not { } c)
        {
            _lockedKeys = [];
            return;
        }

        foreach (var node in _diagram.Nodes.OfType<MlNode>().Where(n => n.Kind == "train"))
        {
            node.Config["targetColumn"] = c.LabelColumn;
            node.Config["task"] = string.IsNullOrWhiteSpace(c.TaskType) ? "BinaryClassification" : c.TaskType;
            if (!string.IsNullOrWhiteSpace(c.IdColumn))
            {
                node.Config["idColumn"] = c.IdColumn;
            }
        }

        _lockedKeys = ["targetColumn", "idColumn", "task"];
    }

    private async Task SaveRegistryDraft()
    {
        if (_loadedWorkflowId is not { } id)
        {
            return;
        }

        _registryBusy = true;
        try
        {
            var json = JsonSerializer.Serialize(BuildDefinition(), _json);
            var (version, error) = await Api.SaveWorkflowDraftAsync(id, new SaveDraftRequest(json, null));
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Warning);
                return;
            }

            _registryVersion = version!.VersionNumber;
            _registryStatus = version.Status;
            Snackbar.Add($"Draft saved (v{version.VersionNumber}).", Severity.Success);
        }
        finally
        {
            _registryBusy = false;
        }
    }

    private async Task PublishRegistry()
    {
        if (_loadedWorkflowId is not { } id)
        {
            return;
        }

        _registryBusy = true;
        try
        {
            // Capture the current canvas as a draft, then freeze it (the API runs the compiler +
            // split-before-fit check and rejects a leaky graph).
            var json = JsonSerializer.Serialize(BuildDefinition(), _json);
            var (version, saveError) = await Api.SaveWorkflowDraftAsync(id, new SaveDraftRequest(json, null));
            if (saveError is not null)
            {
                Snackbar.Add(saveError, Severity.Warning);
                return;
            }

            var publishError = await Api.PublishWorkflowVersionAsync(id, version!.VersionNumber);
            Snackbar.Add(publishError ?? $"Published v{version.VersionNumber}.", publishError is null ? Severity.Success : Severity.Warning);
            if (publishError is null)
            {
                _registryVersion = version.VersionNumber;
                _registryStatus = "published";
            }
        }
        finally
        {
            _registryBusy = false;
        }
    }

    // ---- Canvas load/save ----

    private void LoadDefinition(string json)
    {
        _diagram.Nodes.Clear();
        _diagram.Links.Clear();
        _nextX = 40;
        _seedRow = 0;

        WorkflowDefinition? def = null;
        try { def = JsonSerializer.Deserialize<WorkflowDefinition>(json, _json); } catch { /* fall through to starter */ }

        if (def is null || def.Nodes.Count == 0)
        {
            SeedStarter();
            return;
        }

        var map = new Dictionary<string, MlNode>(StringComparer.Ordinal);
        foreach (var wn in def.Nodes)
        {
            var x = wn.Config is not null && wn.Config.TryGetValue("_x", out var xs) && double.TryParse(xs, NumberStyles.Any, CultureInfo.InvariantCulture, out var xv) ? xv : _nextX;
            var y = wn.Config is not null && wn.Config.TryGetValue("_y", out var ys) && double.TryParse(ys, NumberStyles.Any, CultureInfo.InvariantCulture, out var yv) ? yv : 60;
            var node = PlaceNode(wn.Id, wn.Kind, x, y);
            if (wn.Config is not null)
            {
                foreach (var kv in wn.Config.Where(kv => kv.Key is not ("_x" or "_y")))
                {
                    node.Config[kv.Key] = kv.Value;
                }
            }
            map[wn.Id] = node;
            _nextX = Math.Max(_nextX, x + 170);
        }

        foreach (var e in def.Edges)
        {
            if (map.TryGetValue(e.FromNodeId, out var a) && map.TryGetValue(e.ToNodeId, out var b))
            {
                Connect(a, b);
            }
        }
    }

    private WorkflowDefinition BuildDefinition()
    {
        var nodes = _diagram.Nodes.OfType<MlNode>().Select(n =>
        {
            var cfg = new Dictionary<string, string>(n.Config)
            {
                ["_x"] = n.Position.X.ToString(CultureInfo.InvariantCulture),
                ["_y"] = n.Position.Y.ToString(CultureInfo.InvariantCulture),
            };
            return new WorkflowNode { Id = n.NodeId, Kind = n.Kind, Config = cfg };
        }).ToList();

        var edges = new List<WorkflowEdge>();
        foreach (var link in _diagram.Links)
        {
            if ((link.Source as SinglePortAnchor)?.Port?.Parent is MlNode src && (link.Target as SinglePortAnchor)?.Port?.Parent is MlNode dst)
            {
                edges.Add(new WorkflowEdge(src.NodeId, dst.NodeId));
            }
        }

        var name = _registryMode ? _registryName : "Pipeline";
        return new WorkflowDefinition { Name = name, Nodes = nodes, Edges = edges };
    }

    private void SeedStarter()
    {
        var d = AddNode("dataset");
        var sp = AddNode("split");
        var tr = AddNode("train");
        var ev = AddNode("evaluate");
        Connect(d, sp);
        Connect(sp, tr);
        Connect(tr, ev);
    }

    private MlNode AddNode(string kind)
    {
        var node = PlaceNode("n" + Guid.NewGuid().ToString("N")[..8], kind, _nextX, 60 + (_seedRow++ % 2) * 120);
        _nextX += 170;
        return node;
    }

    private void OnDragStart(string kind) => _dragKind = kind;

    private void OnDrop(Microsoft.AspNetCore.Components.Web.DragEventArgs e)
    {
        if (_dragKind is null)
        {
            return;
        }

        // Convert the drop point to diagram coordinates (accounts for pan/zoom).
        var pt = _diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);
        PlaceNode("n" + Guid.NewGuid().ToString("N")[..8], _dragKind, pt.X, pt.Y);
        _dragKind = null;
    }

    private MlNode PlaceNode(string id, string kind, double x, double y)
    {
        var node = new MlNode(id, kind, new Blazor.Diagrams.Core.Geometry.Point(x, y));
        node.AddPort(PortAlignment.Left);
        node.AddPort(PortAlignment.Right);
        _diagram.Nodes.Add(node);
        return node;
    }

    private void Connect(MlNode a, MlNode b) =>
        _diagram.Links.Add(new LinkModel(a.GetPort(PortAlignment.Right)!, b.GetPort(PortAlignment.Left)!));

    private void DeleteSelected()
    {
        if (_selected is not null)
        {
            _diagram.Nodes.Remove(_selected);
            _selected = null;
        }
    }

    private void OnSelectionChanged(Blazor.Diagrams.Core.Models.Base.SelectableModel _)
    {
        _selected = _diagram.GetSelectedModels().OfType<MlNode>().FirstOrDefault();
        InvokeAsync(StateHasChanged);
    }

    // The run's label/task come from the Train node when the user set them there (free mode); otherwise the
    // "Run pipeline" box values. In a competition the server enforces its own regardless.
    private string? TrainCfg(string key) =>
        _diagram.Nodes.OfType<MlNode>().FirstOrDefault(n => n.Kind == "train") is { } t
        && t.Config.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : null;

    private string EffectiveLabel() => TrainCfg("targetColumn") ?? _labelColumn;

    private string EffectiveTask() => TrainCfg("task") ?? _task;

    private bool MatchesSearch(NodeDescriptorDto n) =>
        string.IsNullOrWhiteSpace(_search)
        || n.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || n.Kind.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || n.Category.Contains(_search, StringComparison.OrdinalIgnoreCase);

    // ---- Run / submit ----

    private async Task OnRun(InputFileChangeEventArgs e)
    {
        _running = true;
        _result = null;
        foreach (var n in _diagram.Nodes.OfType<MlNode>())
        {
            n.SetStatus("idle");
        }
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            {
                await stream.CopyToAsync(ms);
            }
            ms.Position = 0;

            ApplyResult(await Api.ExecuteWorkflowAsync(BuildDefinition(), ms, e.File.Name, EffectiveLabel(), EffectiveTask()));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Run failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RunFromDataset()
    {
        if (DatasetNodeId() is not { } id)
        {
            return;
        }

        _running = true;
        _result = null;
        foreach (var n in _diagram.Nodes.OfType<MlNode>())
        {
            n.SetStatus("idle");
        }
        StateHasChanged();

        try
        {
            var (result, error) = await Api.ExecuteWorkflowFromDatasetAsync(BuildDefinition(), id, EffectiveLabel(), EffectiveTask());
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Warning);
                return;
            }

            ApplyResult(result);
        }
        finally
        {
            _running = false;
        }
    }

    // Reflects each node's execution status back onto the canvas.
    private void ApplyResult(PipelineExecutionResult? result)
    {
        _result = result;
        if (_result is null)
        {
            return;
        }

        var byId = _diagram.Nodes.OfType<MlNode>().ToDictionary(n => n.NodeId);
        foreach (var nr in _result.Nodes)
        {
            if (byId.TryGetValue(nr.NodeId, out var node))
            {
                node.SetStatus(nr.Status, nr.Detail);
            }
        }
    }

    private async Task OnSubmitPipeline(Guid competitionId)
    {
        _submitting = true;
        _submissionResult = null;
        _submitError = null;
        try
        {
            _submissionResult = await Api.SubmitPipelineAsync(competitionId, BuildDefinition());
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string StatusIcon(string status) => status switch
    {
        "done" => Icons.Material.Filled.CheckCircle,
        "failed" => Icons.Material.Filled.Error,
        "skipped" => Icons.Material.Filled.RemoveCircleOutline,
        _ => Icons.Material.Filled.RadioButtonUnchecked,
    };

    private static Color StatusColor(string status) => status switch
    {
        "done" => Color.Success,
        "failed" => Color.Error,
        _ => Color.Default,
    };
}
